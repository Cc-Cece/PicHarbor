<Project>

  <!--
    Shared build policy for every project in the solution (PROJECT_BRIEF §9, Sprint 1 plan Task 1).
    C# 14 on .NET 10, nullable reference types on, and warnings are errors so the
    read-only contract and data-safety code cannot rot behind a yellow squiggle.
  -->
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      iMobileDevice-net 1.3.17 advertises a legacy distro-specific RID (ubuntu.16.04-x64)
      we never use; .NET 8+ no longer resolves those assets. The win-x64 natives we DO use
      resolve fine. Silence the cosmetic SDK warning (aging native deps tracked as R20).
    -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <!--
    Public-repo / v1 EXE file metadata (Sprint 3 Task 8). Stamped into the published binary's file
    properties. The canonical copyright holder is in LICENSE (MIT); the shipped binary carries a
    neutral product attribution. Release builds override Version from the git tag (release.yml).
  -->
  <PropertyGroup>
    <Product>get-and-see</Product>
    <Company>get-and-see</Company>
    <Authors>get-and-see contributors</Authors>
    <Copyright>Copyright (c) 2026 get-and-see contributors</Copyright>
    <Description>Read-only iPhone → PC media copier over USB (Apple File Conduit / AFC).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/denis-a-evdokimov/get-and-see</RepositoryUrl>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
