    <sys:String x:Key="AboutSubtitleText">PicHarbor</sys:String>
    <sys:String x:Key="AboutVersionText">Free &amp; open-source local mobile photo backup and cross-device manager</sys:String>
    <sys:String x:Key="AboutFeature1">• Lossless Direct Transfer: Secure iPhone &amp; Android transfer, preserving Live Photos &amp; EXIF.</sys:String>
    <sys:String x:Key="AboutFeature2">• Simple &amp; Efficient: Global cross-drive deduplication with instant transfers, offline indexing and fast search.</sys:String>
    <sys:String x:Key="AboutFeature3">• Multi-Device Restore: Sync and restore across devices to iPhone, Android and Google Photos.</sys:String>
