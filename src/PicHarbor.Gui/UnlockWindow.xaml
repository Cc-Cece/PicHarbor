<Window x:Class="PicHarbor.Gui.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PicHarbor.Gui.Controls"
        Title="{DynamicResource AppLockUnlockTitle}"
        Width="440" Height="Auto" SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource ColorBrushCanvasGradient}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="0"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource ColorBrushTitleGradient}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource PclIconLock}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource AppLockUnlockTitle}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 窗口控制按钮：最小化 / 关闭 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Width="36" Height="30" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="Minimize_Click" ToolTip="{DynamicResource AppLockBtnMinimize}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                    <Path Data="M0,0 H10" Stroke="White" StrokeThickness="1.4" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CloseButton" Width="36" Height="30" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="Close_Click" ToolTip="{DynamicResource AppLockBtnClose}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="1.4" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,20,24,22">

            <!-- ══════ 解锁视图（默认） ══════ -->
            <StackPanel x:Name="UnlockPanel">
                <TextBlock Text="{DynamicResource AppLockUnlockPrompt}" FontSize="12.5"
                           Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,16" TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource AppLockLabelPassword}" Foreground="{DynamicResource ColorBrush1}"
                           FontSize="12.5" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordBox" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                             FontSize="13" Margin="0,0,0,14"
                             KeyDown="UnlockInput_KeyDown"
                             PasswordChanged="PasswordBox_PasswordChanged" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <controls:PclButton Content="{DynamicResource AppLockBtnUnlock}" ButtonType="Hero"
                                        Command="{Binding UnlockCommand}" Height="34" Padding="24,0" Margin="0,0,10,0" />
                    <controls:PclButton Content="{DynamicResource AppLockBtnForgotPassword}"
                                        Click="ShowReset_Click" Height="34" Padding="16,0" />
                </StackPanel>
            </StackPanel>

            <!-- ══════ TOTP 重置视图 ══════ -->
            <StackPanel x:Name="ResetPanel" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource AppLockResetPrompt}" FontSize="12.5"
                           Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,16" TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource AppLockLabelTotpCode}" Foreground="{DynamicResource ColorBrush1}"
                           FontSize="12.5" Margin="0,0,0,6" />
                <TextBox x:Name="ResetTotpBox" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                         FontSize="15" MaxLength="6" Margin="0,0,0,12" TextChanged="ResetTotpBox_TextChanged"
                         KeyDown="ResetInput_KeyDown" />

                <TextBlock Text="{DynamicResource AppLockLabelNewPassword}" Foreground="{DynamicResource ColorBrush1}"
                           FontSize="12.5" Margin="0,0,0,6" />
                <PasswordBox x:Name="ResetNewPasswordBox" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                             FontSize="13" Margin="0,0,0,14" PasswordChanged="ResetNewPasswordBox_PasswordChanged"
                             KeyDown="ResetInput_KeyDown" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <controls:PclButton Content="{DynamicResource AppLockBtnResetPassword}" ButtonType="Hero"
                                        Click="ResetPassword_Click" Height="34" Padding="20,0" Margin="0,0,10,0" />
                    <controls:PclButton Content="{DynamicResource AppLockBtnBackToUnlock}"
                                        Click="BackToUnlock_Click" Height="34" Padding="16,0" />
                </StackPanel>
            </StackPanel>

            <!-- 状态消息 -->
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding StatusMessage, Converter={x:Static controls:StringNotEmptyToVisibilityConverter.Instance}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#10B981" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#DC2626" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
