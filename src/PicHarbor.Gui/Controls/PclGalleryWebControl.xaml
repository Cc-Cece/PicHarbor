<UserControl x:Class="PicHarbor.Gui.Controls.PclGalleryWebControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:controls="clr-namespace:PicHarbor.Gui.Controls"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid Background="#F8FAFC">
        <!-- WebView2 Web Gallery Container -->
        <wv2:WebView2 x:Name="AlbumWebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <!-- Loading Overlay with PCL2 Theme -->
        <Border x:Name="LoadingOverlay"
                Background="#F8FAFC"
                Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="180" Height="4"
                             Margin="0,0,0,12"
                             Foreground="{DynamicResource ColorBrush3}"
                             Background="#E2E8F0"
                             BorderThickness="0" />
                <TextBlock Text="正在载入现代图库视图..."
                           Foreground="{DynamicResource ColorBrushGray2}"
                           FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Error / Fallback State -->
        <Border x:Name="ErrorOverlay"
                Background="#F8FAFC"
                Visibility="Collapsed"
                Padding="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="无法加载 Web 图库引擎"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ColorBrush1}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="ErrorDetails"
                           Text="当前环境暂未就绪"
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray2}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />
                <controls:PclButton Content="切换到表格列表"
                                    Click="FallbackToList_Click"
                                    Height="32"
                                    Padding="16,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
