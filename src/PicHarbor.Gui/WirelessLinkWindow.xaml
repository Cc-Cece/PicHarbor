<Window x:Class="PicHarbor.Gui.WirelessLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WirelessWindowTitle}" Width="460" Height="640" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource WirelessWindowIntro}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Margin="0,16,0,8">
            <TextBlock x:Name="CodeText" FontSize="32" FontWeight="SemiBold" />
            <TextBlock x:Name="FingerprintText" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="AddressText" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Image x:Name="QrImage" Grid.Row="2" Stretch="Uniform" />
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="LogText" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <Button x:Name="CloseButton" Grid.Row="5" Content="{DynamicResource WirelessStopClose}" Margin="0,12,0,0" Height="36" Click="CloseButton_Click" />
    </Grid>
</Window>
