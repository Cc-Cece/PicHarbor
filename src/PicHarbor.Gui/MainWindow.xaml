<Window x:Class="PicHarbor.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PicHarbor.Gui.ViewModels"
        xmlns:controls="clr-namespace:PicHarbor.Gui.Controls"
        Title="PicHarbor" 
        Height="680" Width="1020"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource ColorBrushCanvasGradient}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" 
                      ResizeBorderThickness="6" 
                      CornerRadius="8" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Navigation Bar (PCL2 PanTitle, Height="48") -->
            <RowDefinition Height="48" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!--  TOP BAR (PCL2 PanTitle Gradient + Capsule Tabs)         -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource ColorBrushTitleGradient}" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <!-- Brand Title / Logo -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center Capsule Nav Tabs -->
                    <ColumnDefinition Width="*" />
                    <!-- Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PicHarbor" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center Capsule Nav Tabs (1:1 PclRadioButton with PCL2 Vector Icons) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:PclRadioButton Content="备份"
                                             Logo="{StaticResource PclIconLaunch}"
                                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=0}"
                                             Click="NavButton_Click" Tag="0" />

                    <controls:PclRadioButton Content="图库"
                                             Logo="{StaticResource PclIconGallery}"
                                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=1}"
                                             Click="NavButton_Click" Tag="1" />

                    <controls:PclRadioButton Content="云同步"
                                             Logo="{StaticResource PclIconCloud}"
                                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=2}"
                                             Click="NavButton_Click" Tag="2" />

                    <controls:PclRadioButton Content="设置"
                                             Logo="{StaticResource PclIconSettings}"
                                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=3}"
                                             Click="NavButton_Click" Tag="3" />
                </StackPanel>

                <!-- Window Minimize & Close Buttons (1:1 PclIconButton) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:PclIconButton Logo="{StaticResource PclIconMinimize}"
                                            IconTheme="White"
                                            Click="MinimizeButton_Click" ToolTip="最小化" />

                    <controls:PclIconButton Logo="{StaticResource PclIconClose}"
                                            IconTheme="Close"
                                            Click="CloseButton_Click" ToolTip="关闭" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!--  MAIN BODY AREA (Two-Pane Layout)                        -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">

            <!-- ==================================================== -->
            <!--  PAGE 0: 【▷ 备份 (Backup)】(复刻图 1 启动主页)        -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left Hero Pane (White Translucent Sidebar, 280px) -->
                    <ColumnDefinition Width="280" />
                    <!-- Right Canvas -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT HERO PANE -->
                <Border Grid.Column="0" Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}" 
                        BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Top: Segmented Tabs [📱 iPhone] [🤖 Android] -->
                            <RowDefinition Height="Auto" />
                            <!-- Center: Device Hero Avatar & Name -->
                            <RowDefinition Height="*" />
                            <!-- Bottom: Hero Button & Actions -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Segmented Tabs (对应图 1 [✔ 正版] [🔗 离线]) -->
                        <Border Grid.Row="0" Background="#EAF2FE" CornerRadius="16" Padding="3" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="📱 iPhone" IsChecked="True" Style="{StaticResource PclSegmentedTab}" Margin="0,0,4,0" />
                                <RadioButton Content="🤖 Android" Style="{StaticResource PclSegmentedTab}" />
                            </StackPanel>
                        </Border>

                        <!-- Center Hero Avatar & Status (对应图 1 像素头像与昵称) -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                            <!-- Device Icon Graphic -->
                            <Border Width="76" Height="106" CornerRadius="16" Background="White" BorderBrush="{DynamicResource ColorBrush3}" BorderThickness="2" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#0B5BCB" Opacity="0.12" />
                                </Border.Effect>
                                <Grid>
                                    <!-- Dynamic Island Pill -->
                                    <Border Width="24" Height="6" CornerRadius="3" Background="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />
                                    <!-- Screen Content / Icon -->
                                    <TextBlock Text="📱" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- Home Indicator Bar -->
                                    <Border Width="30" Height="3" CornerRadius="1.5" Background="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                </Grid>
                            </Border>

                            <!-- Device Model Text -->
                            <TextBlock Text="iPhone 15 Plus" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" HorizontalAlignment="Center" />

                            <!-- Status Pill (● 已就绪) -->
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="手机已就绪 · 保持解锁" FontSize="11" FontWeight="Medium" Foreground="#065F46" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Bottom: PCL2 Hero Action Button (对应图 1 启动游戏大按钮) -->
                        <StackPanel Grid.Row="2" Margin="16,0,16,20">
                            <controls:PclButton Content="开始增量备份"
                                                Subtitle="目标: E:\Pictures\PicHarbor\15Plus"
                                                ButtonType="Hero"
                                                Height="64"
                                                Margin="0,0,0,10" />

                            <!-- Two Secondary Buttons (对应图 1 [版本选择] [版本设置]) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:PclButton Grid.Column="0" Content="备份范围" Height="36" />
                                <controls:PclButton Grid.Column="2" Content="传输日志" Height="36" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RIGHT CANVAS (PCL2 Light Blue Canvas with Cascading Entrance & Smooth Scroll) -->
                <controls:PclScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <controls:PclPageHost>
                        <StackPanel>
                            <!-- Card 1: 存储主盘与图库健康度 -->
                            <controls:PclCard Title="📦 图库存储主盘概览" CanSwap="False">
                                <StackPanel>
                                    <TextBlock Text="极简统一存储架构，随盘即插即用 · E:\Pictures\PicHarbor" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,12" />

                                    <!-- Three Metrics Pills -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Col 1 -->
                                        <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="0,0,6,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="已归档媒体" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                <TextBlock Text="5,809 张" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Col 2 -->
                                        <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="3,0,3,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="图库总大小" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                <TextBlock Text="20.2 GB" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Col 3 -->
                                        <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="6,0,0,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="磁盘可用空间" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                <TextBlock Text="380 GB 充足" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Cross-volume deduplication banner -->
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                                        <TextBlock Text="✔ 跨驱动器指纹防重库已就绪，移动硬盘与本机换盘插拔均能极速秒传去重。" FontSize="12" Foreground="#15803D" />
                                    </Border>
                                </StackPanel>
                            </controls:PclCard>

                            <!-- Card 2: 备份范围与分类规则 (可折叠手风琴) -->
                            <controls:PclCard Title="⚡ 增量备份与传输策略" CanSwap="True" IsSwapped="False">
                                <StackPanel>
                                    <controls:PclCheckBox Content="自动跳过电脑主盘库中已归档的完全相同文件 (智能秒传)" IsChecked="True" />
                                    <controls:PclCheckBox Content="保留手机原始 Live Photo 配套 MOV 视频成对组织" IsChecked="True" />
                                    <controls:PclCheckBox Content="按拍摄年份与月份自动分类归档 (YYYY-MM)" IsChecked="True" />
                                    <controls:PclCheckBox Content="写入安全校验日志与 SQLite 索引库" IsChecked="True" />
                                </StackPanel>
                            </controls:PclCard>

                            <!-- Card 3: 实时传输状态与历史 (可折叠手风琴) -->
                            <controls:PclCard Title="📋 最近一次传输队列与记录" CanSwap="True" IsSwapped="True">
                                <StackPanel>
                                    <TextBlock Text="上次备份时间: 2026/10/09 14:32 · 新增传输 48 项，跳过已存在 5,761 项，耗时 12 秒。" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" />
                                </StackPanel>
                            </controls:PclCard>
                        </StackPanel>
                    </controls:PclPageHost>
                </controls:PclScrollViewer>
            </Grid>

            <!-- ==================================================== -->
            <!--  PAGE 1: 【⤓ 图库 (Gallery)】(复刻图 2 版本列表页)      -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left Sub-Nav Pane (220px, 对应图 2 左侧的原版游戏/Mod) -->
                    <ColumnDefinition Width="220" />
                    <!-- Right Content Canvas -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SUB-NAV PANE -->
                <Border Grid.Column="0" Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}" 
                        BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="图库视图" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ColorBrushGray3}" Margin="18,8,0,6" />
                        <controls:PclListItem Content="全部照片与视频" Icon="🖼️" IsChecked="True" />
                        <controls:PclListItem Content="视频与实况" Icon="🎬" />
                        <controls:PclListItem Content="相机与设备" Icon="📸" />
                        <controls:PclListItem Content="iPhone (15Plus)" Icon="📱" />
                        <controls:PclListItem Content="Android (K40)" Icon="🤖" />
                        <controls:PclListItem Content="自选导出清单" Icon="⭐" />
                    </StackPanel>
                </Border>

                <!-- RIGHT CONTENT CANVAS -->
                <controls:PclScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <controls:PclPageHost>
                        <StackPanel>
                            <!-- Top Card: 最新归档 (对应图 2 的“最新版本”卡片) -->
                            <controls:PclCard Title="最新归档媒体" CanSwap="False">
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📅" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="2026年10月 (最近一次备份)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" />
                                        <TextBlock Text="最新归档于 2026/10/09 · 48 张照片与视频 (包含 K40 胶片照片与 iPhone HEIC)" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <controls:PclButton Grid.Column="2" Content="浏览此月份" Height="34" />
                                </Grid>
                            </controls:PclCard>

                            <!-- Accordion Cards (对应图 2 的 正式版/预览版/远古版 手风琴卡片) -->
                            <controls:PclCard Title="2026 年度归档 (1,240 张照片 · 4.8 GB)" CanSwap="True" IsSwapped="False">
                                <StackPanel>
                                    <TextBlock Text="↳ 包含 2026-10、2026-09、2026-08 等月份子目录，可随时在画廊中检视与原画质预览。" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" />
                                </StackPanel>
                            </controls:PclCard>

                            <controls:PclCard Title="2025 年度归档 (3,120 张照片 · 10.6 GB)" CanSwap="True" IsSwapped="True">
                                <StackPanel>
                                    <TextBlock Text="↳ 包含 2025-12 至 2025-01 完整媒体记录。" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" />
                                </StackPanel>
                            </controls:PclCard>

                            <controls:PclCard Title="2024 年度归档 (1,449 张照片 · 4.8 GB)" CanSwap="True" IsSwapped="True">
                                <StackPanel>
                                    <TextBlock Text="↳ 包含 2024 年度历史备份归档。" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" />
                                </StackPanel>
                            </controls:PclCard>
                        </StackPanel>
                    </controls:PclPageHost>
                </controls:PclScrollViewer>
            </Grid>

            <!-- ==================================================== -->
            <!--  PAGE 2: 【☁ 云同步 (Cloud Sync)】                  -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sub-Nav -->
                <Border Grid.Column="0" Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}" 
                        BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="云端服务" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ColorBrushGray3}" Margin="18,8,0,6" />
                        <controls:PclListItem Content="Google 相册" Icon="☁️" IsChecked="True" />
                        <controls:PclListItem Content="同步规则" Icon="⚙️" />
                        <controls:PclListItem Content="上传记录" Icon="📋" />
                    </StackPanel>
                </Border>

                <!-- Right Canvas -->
                <controls:PclScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <controls:PclPageHost>
                        <StackPanel>
                            <!-- Card 1: 账号与代理 -->
                            <controls:PclCard Title="Google 相册授权与连接" CanSwap="False">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="已授权账号" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="suyu041219@gmail.com (已登录)" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="网络代理通道" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="127.0.0.1:7890 · 延迟 120ms (连通就绪)" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </controls:PclCard>

                            <!-- Card 2: 上传策略 -->
                            <controls:PclCard Title="上传归档范围与相册策略" CanSwap="False">
                                <StackPanel>
                                    <RadioButton Content="全量同步 (将本地 5,809 张照片增量上传至 Google 相册)" IsChecked="True" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                                    <RadioButton Content="自选清单同步 (仅上传在图库中挑选标记的照片)" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                                    <controls:PclCheckBox Content="自动根据年月建立 Google 相册 (如 2026-10)" IsChecked="True" Margin="0,4,0,0" />
                                </StackPanel>
                            </controls:PclCard>

                            <!-- Action Button -->
                            <controls:PclButton Content="🚀 开始同步到 Google 相册" ButtonType="Hero" Height="56" />
                        </StackPanel>
                    </controls:PclPageHost>
                </controls:PclScrollViewer>
            </Grid>

            <!-- ==================================================== -->
            <!--  PAGE 3: 【⚙ 设置 (Settings)】(复刻图 3 选项页)        -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left Sub-Nav Pane (220px, 对应图 3 左侧的启动/个性化/其他) -->
                    <ColumnDefinition Width="220" />
                    <!-- Right Content Canvas -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SUB-NAV PANE -->
                <Border Grid.Column="0" Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}" 
                        BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="设置分栏" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ColorBrushGray3}" Margin="18,8,0,6" />
                        <controls:PclListItem Content="存储与主盘符" Icon="📦" IsChecked="True" />
                        <controls:PclListItem Content="备份偏好与规则" Icon="📲" />
                        <controls:PclListItem Content="界面与语言" Icon="🌐" />
                    </StackPanel>
                </Border>

                <!-- RIGHT CONTENT CANVAS (纯白大圆角卡片，复刻图 3 启动选项与内存分配) -->
                <controls:PclScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <controls:PclPageHost>
                        <StackPanel>
                            <!-- Card 1: 存储与主盘符 (对应图 3 的“启动选项”大卡片) -->
                            <controls:PclCard Title="存储主盘与架构规范" CanSwap="False">
                                <StackPanel>
                                    <!-- Row 1: 主盘符 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="当前主备份盘" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource PclComboBox}" SelectedIndex="0">
                                            <ComboBoxItem Content="E: 盘 (Pictures\PicHarbor · 剩余 380 GB)" />
                                            <ComboBoxItem Content="C: 盘 (Users\Pictures\PicHarbor)" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Row 2: 手机分类目录规则 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="设备子目录规则" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource PclComboBox}" SelectedIndex="0">
                                            <ComboBoxItem Content="按手机型号自动分类 (如 15Plus, K40)" />
                                            <ComboBoxItem Content="平铺直接归档至主根目录" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Row 3: 时间组织方案 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="照片时间分类格式" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource PclComboBox}" SelectedIndex="0">
                                            <ComboBoxItem Content="按月份 (YYYY-MM，如 2026-10)" />
                                            <ComboBoxItem Content="按年月 (YYYY\YYYY-MM)" />
                                            <ComboBoxItem Content="按年份 (YYYY)" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Row 4: 跨盘防重提示 -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="跨驱动器查重" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="已检测到驱动器历史库，跨盘防重自动生效" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </controls:PclCard>

                            <!-- Card 2: 备份优化与高级参数 (对应图 3 的“内存分配”大卡片) -->
                            <controls:PclCard Title="高级传输与属性校准" CanSwap="False">
                                <StackPanel>
                                    <!-- RadioButtons: 过滤策略 -->
                                    <RadioButton Content="全量备份所有媒体文件" IsChecked="True" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,8" />
                                    <RadioButton Content="自动过滤小于 100KB 的小缩略图与表情包" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,12" />

                                    <!-- CheckBoxes -->
                                    <controls:PclCheckBox Content="EXIF 拍摄时间自动校准至文件创建时间" IsChecked="True" Margin="0,0,0,8" />
                                    <controls:PclCheckBox Content="实况照片 (HEIC + MOV) 自动绑定成对传输" IsChecked="True" Margin="0,0,0,12" />

                                    <!-- Slider: 超时阈值 (对应图 3 的滑块) -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="设备读取超时阈值" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Style="{StaticResource PclSlider}" Minimum="10" Maximum="120" Value="30" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="30 秒" Foreground="{DynamicResource ColorBrushGray2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </controls:PclCard>
                        </StackPanel>
                    </controls:PclPageHost>
                </controls:PclScrollViewer>
            </Grid>
        </Grid>

        <!-- Hidden legacy preview player elements to preserve code-behind during UI shell phase -->
        <Grid Visibility="Collapsed">
            <MediaElement x:Name="PreviewPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          MediaOpened="PreviewPlayer_MediaOpened"
                          MediaFailed="PreviewPlayer_MediaFailed"
                          MediaEnded="PreviewPlayer_MediaEnded"
                          MouseLeftButtonDown="PreviewPlayer_MouseLeftButtonDown" />
            <Slider x:Name="PreviewSeek"
                    PreviewMouseDown="PreviewSeek_PreviewMouseDown"
                    PreviewMouseUp="PreviewSeek_PreviewMouseUp"
                    ValueChanged="PreviewSeek_ValueChanged" />
            <TextBlock x:Name="PreviewClockText" />
        </Grid>
    </Grid>
</Window>
