<Window x:Class="PicHarbor.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PicHarbor.Gui.ViewModels"
        xmlns:controls="clr-namespace:PicHarbor.Gui.Controls"
        Title="PicHarbor" 
        Height="720" Width="1060"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource ColorBrushCanvasGradient}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" 
                      ResizeBorderThickness="6" 
                      CornerRadius="8" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="PclHeroMiniBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Navigation Bar (PCL2 PanTitle, Height="48") -->
            <RowDefinition Height="48" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!--  TOP BAR (PCL2 PanTitle Gradient + Logo + Capsule Tabs)  -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource ColorBrushTitleGradient}" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <!-- Brand Title / Logo -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center Capsule Nav Tabs -->
                    <ColumnDefinition Width="*" />
                    <!-- Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo (PicHarbor with PCL-style Vector Icon) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource PclIconGallery}"
                          Fill="White"
                          Width="20" Height="20" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="PicHarbor" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center Capsule Nav Tabs (1:1 PclRadioButton with PCL2 Vector Icons) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:PclRadioButton Content="备份"
                                             Logo="{StaticResource PclIconLaunch}"
                                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=0}"
                                             Click="NavButton_Click" Tag="0" />

                    <controls:PclRadioButton Content="图库"
                                             Logo="{StaticResource PclIconGallery}"
                                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=1}"
                                             Click="NavButton_Click" Tag="1" />

                    <controls:PclRadioButton Content="云同步与回传"
                                             Logo="{StaticResource PclIconCloud}"
                                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=2}"
                                             Click="NavButton_Click" Tag="2" />

                    <controls:PclRadioButton Content="设置"
                                             Logo="{StaticResource PclIconSettings}"
                                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=3}"
                                             Click="NavButton_Click" Tag="3" />
                </StackPanel>

                <!-- Window Minimize & Close Buttons (1:1 PclIconButton) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:PclIconButton Logo="{StaticResource PclIconMinimize}"
                                            IconTheme="White"
                                            Click="MinimizeButton_Click" ToolTip="最小化" />

                    <controls:PclIconButton Logo="{StaticResource PclIconClose}"
                                            IconTheme="Close"
                                            Click="CloseButton_Click" ToolTip="关闭" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!--  MAIN BODY AREA (Two-Pane Layout)                        -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">

            <!-- ==================================================== -->
            <!--  PAGE 0: 【▷ 备份 (Backup)】                          -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left Hero Pane (White Translucent Sidebar, 290px matching PCL2) -->
                    <ColumnDefinition Width="290" />
                    <!-- Right Canvas -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT HERO PANE -->
                <Grid Grid.Column="0">
                    <Border Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}" 
                            BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,1,0"
                            MouseEnter="DeviceHeroArea_MouseEnter" MouseLeave="DeviceHeroArea_MouseLeave">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Top: Segmented Tabs [iPhone] [Android] -->
                                <RowDefinition Height="Auto" />
                                <!-- Center: Device Hero Graphic & Model -->
                                <RowDefinition Height="*" />
                                <!-- Bottom: Hero Button & Actions -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Segmented Tabs (对应 PCL2 胶囊切换) -->
                            <Border Grid.Row="0" Background="#EAF2FE" CornerRadius="16" Padding="3" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource PclSegmentedTab}" Margin="0,0,4,0"
                                                 IsChecked="{Binding SelectedDeviceIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=0}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource PclIconPhone}" Width="12" Height="12" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="iPhone" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource PclSegmentedTab}"
                                                 IsChecked="{Binding SelectedDeviceIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=1}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource PclIconAndroid}" Width="12" Height="12" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Android" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- Center Device Area (Full left pane hover reveals mini buttons) -->
                            <Grid Grid.Row="1" Background="Transparent">
                                <!-- Center Hero Illustration & Status: iPhone View -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDeviceIndex}" Value="1">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Clean iPhone Illustration Frame -->
                                    <Border Width="78" Height="110" CornerRadius="16" Background="White" BorderBrush="{DynamicResource ColorBrush3}" BorderThickness="2" Margin="0,0,0,14">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0B5BCB" Opacity="0.12" />
                                        </Border.Effect>
                                        <Grid>
                                            <!-- Dynamic Island Pill -->
                                            <Border Width="24" Height="6" CornerRadius="3" Background="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />
                                            <!-- Screen Content -->
                                            <Grid Margin="6,16,6,14">
                                                <Border CornerRadius="8" Background="{DynamicResource ColorBrush8}">
                                                    <Path Data="{StaticResource PclIconGallery}" Width="28" Height="28" Stretch="Uniform"
                                                          Fill="{DynamicResource ColorBrush3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <!-- Home Indicator Bar -->
                                            <Border Width="30" Height="3" CornerRadius="1.5" Background="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                        </Grid>
                                    </Border>

                                    <!-- Device Model Text -->
                                    <TextBlock Text="{Binding BackupVM.DetectedDeviceModel}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" HorizontalAlignment="Center" />

                                    <!-- Status Pill -->
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="12,3" Margin="0,8,0,0" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#94A3B8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                                <Setter Property="Fill" Value="#10B981" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding DeviceStatusText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- PCL2 Signature Hero Hover Mini-Menu (Hover anywhere in device region to reveal) -->
                                    <Border x:Name="IPhoneHeroHoverMenu" Height="0" Opacity="0" ClipToBounds="True" Margin="0,8,0,0" HorizontalAlignment="Center">
                                        <Border Background="#F1F5F9" CornerRadius="14" Padding="4,2" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="✏️ 重命名" Command="{Binding OpenRenameModalCommand}"
                                                        Style="{StaticResource PclHeroMiniBtn}" Margin="0,0,3,0" ToolTip="自定义设备别名" />
                                                <Button Content="🔄 刷新" Command="{Binding RefreshDeviceCommand}"
                                                        Style="{StaticResource PclHeroMiniBtn}" ToolTip="重新检测连接状态" />
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </StackPanel>

                                <!-- Center Hero Illustration & Status: Android View -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDeviceIndex}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Clean Android Illustration Frame -->
                                    <Border Width="78" Height="110" CornerRadius="16" Background="White" BorderBrush="{DynamicResource ColorBrush3}" BorderThickness="2" Margin="0,0,0,14">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0B5BCB" Opacity="0.12" />
                                        </Border.Effect>
                                        <Grid>
                                            <!-- Front Camera Dot -->
                                            <Ellipse Width="6" Height="6" Fill="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />
                                            <!-- Screen Content -->
                                            <Grid Margin="6,16,6,14">
                                                <Border CornerRadius="8" Background="{DynamicResource ColorBrush8}">
                                                    <Path Data="{StaticResource PclIconAndroid}" Width="28" Height="28" Stretch="Uniform"
                                                          Fill="{DynamicResource ColorBrush3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <!-- Home Indicator -->
                                            <Border Width="30" Height="3" CornerRadius="1.5" Background="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                        </Grid>
                                    </Border>

                                    <!-- Device Model Text -->
                                    <TextBlock Text="{Binding AndroidBackupVM.DetectedDeviceModel}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" HorizontalAlignment="Center" />

                                    <!-- Status Pill -->
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="12,3" Margin="0,8,0,0" HorizontalAlignment="Center" ToolTip="{Binding AndroidBackupVM.ProgressText}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding AndroidBackupVM.HeroPillText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                        </StackPanel>
                                    </Border>

                                    <!-- PCL2 Signature Hero Hover Mini-Menu (Android) -->
                                    <Border x:Name="AndroidHeroHoverMenu" Height="0" Opacity="0" ClipToBounds="True" Margin="0,8,0,0" HorizontalAlignment="Center">
                                        <Border Background="#F1F5F9" CornerRadius="14" Padding="4,2" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="✏️ 重命名" Command="{Binding OpenRenameModalCommand}"
                                                        Style="{StaticResource PclHeroMiniBtn}" Margin="0,0,3,0" ToolTip="自定义设备别名" />
                                                <Button Content="📡 连接参数" Command="{Binding OpenAndroidFtpModalCommand}"
                                                        Style="{StaticResource PclHeroMiniBtn}" Margin="0,0,3,0" ToolTip="配置 Android 手机 FTP 连接参数" />
                                                <Button Content="🔄 重扫" Command="{Binding RefreshDeviceCommand}"
                                                        Style="{StaticResource PclHeroMiniBtn}" ToolTip="重新扫描局域网与设备" />
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Bottom: Hero Action Buttons & Operations: iPhone -->
                            <StackPanel Grid.Row="2" Margin="18,0,18,20">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDeviceIndex}" Value="1">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Hero Action Button (Idle) -->
                                <controls:PclButton Content="开始增量备份"
                                                    Subtitle="{Binding BackupVM.FullDestinationPreview, StringFormat='目标: {0}'}"
                                                    Command="{Binding BackupVM.StartBackupCommand}"
                                                    ButtonType="Hero"
                                                    Height="56"
                                                    Margin="0,0,0,10"
                                                    Visibility="{Binding BackupVM.IsTransferring, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                <!-- Hero Action Button (Transferring -> Stop) -->
                                <controls:PclButton Content="停止备份"
                                                    Subtitle="{Binding BackupVM.SpeedText, StringFormat='正在传输 · {0}'}"
                                                    Command="{Binding BackupVM.CancelBackupCommand}"
                                                    ButtonType="Hero"
                                                    Height="56"
                                                    Margin="0,0,0,10"
                                                    Visibility="{Binding BackupVM.IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!-- Two Secondary Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PclButton Grid.Column="0" Content="备份范围" Height="35" Command="{Binding OpenScopeModalCommand}" />
                                    <controls:PclButton Grid.Column="2" Content="传输日志" Height="35" Command="{Binding BackupVM.ShowCopiedDetailsCommand}" />
                                </Grid>
                            </StackPanel>

                            <!-- Bottom: Hero Action Buttons & Operations: Android -->
                            <StackPanel Grid.Row="2" Margin="18,0,18,20">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDeviceIndex}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Hero Action Button (Idle) -->
                                <controls:PclButton Content="开始增量备份"
                                                    Subtitle="{Binding AndroidBackupVM.FullDestinationPreview, StringFormat='目标: {0}'}"
                                                    Command="{Binding AndroidBackupVM.StartBackupCommand}"
                                                    ButtonType="Hero"
                                                    Height="56"
                                                    Margin="0,0,0,10"
                                                    Visibility="{Binding AndroidBackupVM.IsTransferring, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                <!-- Hero Action Button (Transferring -> Stop) -->
                                <controls:PclButton Content="停止备份"
                                                    Subtitle="{Binding AndroidBackupVM.SpeedText, StringFormat='正在传输 · {0}'}"
                                                    Command="{Binding AndroidBackupVM.CancelBackupCommand}"
                                                    ButtonType="Hero"
                                                    Height="56"
                                                    Margin="0,0,0,10"
                                                    Visibility="{Binding AndroidBackupVM.IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!-- Two Secondary Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PclButton Grid.Column="0" Content="备份范围" Height="35" Command="{Binding OpenScopeModalCommand}" />
                                    <controls:PclButton Grid.Column="2" Content="传输日志" Height="35" Command="{Binding AndroidBackupVM.ShowCopiedDetailsCommand}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- PCL2 Signature 4px Drop Shadow Edge Strip -->
                    <Rectangle Width="4" HorizontalAlignment="Right" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" Opacity="0.04">
                                <GradientStop Color="#000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- RIGHT CANVAS -->
                <Grid Grid.Column="1">
                    <controls:PclScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25,20,25,15">
                        <StackPanel>
                            <!-- Top Sub-Tab Capsule Switcher -->
                            <Border Background="#EAF2FE" CornerRadius="16" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource PclSegmentedTab}" Margin="0,0,4,0"
                                                 IsChecked="{Binding BackupSubTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=0}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource PclIconLaunch}" Width="12" Height="12" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="增量备份与执行" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource PclSegmentedTab}"
                                                 IsChecked="{Binding BackupSubTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=1}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource PclIconList}" Width="12" Height="12" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="运行状态与历史" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- SUB-VIEW 0: 增量备份与执行 -->
                            <controls:PclPageHost Direction="Vertical">
                                <controls:PclPageHost.Style>
                                    <Style TargetType="controls:PclPageHost">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BackupSubTabIndex}" Value="1">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:PclPageHost.Style>
                                <StackPanel>

                                    <!-- Card 1: 存储主盘与图库概览 (Common for both iPhone and Android) -->
                                    <controls:PclCard Title="图库存储主盘概览" CanSwap="False">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DestinationPath, StringFormat='极简统一存储架构，随盘即插即用 · {0}'}"
                                                       FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,12" />

                                            <!-- Three Metrics Pills -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Col 1 -->
                                                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="0,0,6,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="已归档媒体" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                        <TextBlock Text="{Binding StatusVM.ItemCount, StringFormat='{}{0:N0} 张'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Col 2 -->
                                                <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="3,0,3,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="图库总大小" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                        <TextBlock Text="{Binding StatusVM.TotalSizeText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Col 3 -->
                                                <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="6,0,0,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="磁盘可用空间" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                        <TextBlock Text="{Binding BackupVM.TargetDriveFreeSpaceText}" ToolTip="{Binding BackupVM.TargetDriveSubtext}" TextTrimming="CharacterEllipsis" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- PclHint Banner -->
                                            <controls:PclHint HintType="Success">
                                                <TextBlock Text="跨驱动器指纹防重库已就绪，移动硬盘与本机换盘插拔均能极速秒传去重。" FontSize="12" Foreground="#047857" />
                                            </controls:PclHint>
                                        </StackPanel>
                                    </controls:PclCard>

                                </StackPanel>
                            </controls:PclPageHost>

                            <!-- SUB-VIEW 1: 📊 运行状态与历史 (StatusVM) -->
                            <controls:PclPageHost Direction="Vertical" DataContext="{Binding StatusVM}">
                                <controls:PclPageHost.Style>
                                    <Style TargetType="controls:PclPageHost">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.BackupSubTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:PclPageHost.Style>
                                <StackPanel>

                                    <!-- Card 1: 4 指标卡片 -->
                                    <controls:PclCard Title="媒体库统计概览" CanSwap="False">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Total Files -->
                                                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="0,0,6,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="总文件数" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                        <TextBlock Text="{Binding TotalFiles, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- 2. Total Size -->
                                                <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="3,0,3,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="存储总占用" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                        <TextBlock Text="{Binding TotalSizeText}" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- 3. Photos -->
                                                <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="3,0,3,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="照片总数" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                        <TextBlock Text="{Binding PhotosCount, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- 4. Videos -->
                                                <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="6,0,0,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="视频总数" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                        <TextBlock Text="{Binding VideosCount, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal">
                                                <controls:PclButton Content="🔄 刷新媒体库统计" Command="{Binding RefreshStatsCommand}" Height="28" Padding="12,2" />
                                            </StackPanel>
                                        </StackPanel>
                                    </controls:PclCard>

                                    <!-- Card 2: 存储库与数据库就绪状态 -->
                                    <controls:PclCard Title="核心存储库与数据库状态" CanSwap="False">
                                        <Grid Grid.IsSharedSizeScope="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="StatusLabel" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="28" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="SQLite 索引库路径" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,20,0" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatabasePath}" FontFamily="Consolas" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Row="2" Text="上次备份时间" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,20,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastBackupTime}" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
                                        </Grid>
                                    </controls:PclCard>

                                    <!-- Card 3: 已连接设备历史清单 -->
                                    <controls:PclCard Title="已连接设备历史清单" CanSwap="False">
                                        <StackPanel>
                                            <TextBlock Text="💡 提示：双击下方任意设备行，可打开该设备的历史备份全景档案（按批次查看传输明细与来源）。"
                                                       FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,10" />
                                            <DataGrid x:Name="DevicesHistoryDataGrid"
                                                      ItemsSource="{Binding Devices}"
                                                      Style="{StaticResource PclDataGrid}"
                                                      MaxHeight="320"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                        <EventSetter Event="MouseDoubleClick" Handler="DeviceGridRow_MouseDoubleClick" />
                                                        <Setter Property="ToolTip" Value="双击查看该设备的历史备份全景档案" />
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="📱 查看设备历史备份全景档案..."
                                                                  Command="{Binding OpenDeviceHistoryCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="160" />
                                                    <DataGridTextColumn Header="型号规格" Binding="{Binding Model}" Width="130" />
                                                    <DataGridTextColumn Header="唯一标识 (UDID / SN)" Binding="{Binding Udid}" Width="2*" />
                                                    <DataGridTextColumn Header="最后连接时间" Binding="{Binding LastSeen}" Width="150" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </controls:PclCard>
                                </StackPanel>
                            </controls:PclPageHost>
                        </StackPanel>
                    </controls:PclScrollViewer>
                </Grid>

                <!-- Floating Task Management Action Button (Only visible on Tab 0: 备份页面) -->

            </Grid>

            <!-- ==================================================== -->
            <!--  PAGE 1: 【⤓ 图库 (Gallery)】                          -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left Sub-Nav Pane (220px) -->
                    <ColumnDefinition Width="220" />
                    <!-- Right Content Canvas -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SUB-NAV PANE -->
                <Grid Grid.Column="0">
                    <Border Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}" 
                            BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,1,0">
                        <controls:PclPageHost Direction="Horizontal">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="图库视图" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ColorBrushGray2}" Margin="18,10,0,8" />
                                <controls:PclListItem Content="全部" Logo="{StaticResource PclIconGallery}" GroupName="GallerySubNav" IsChecked="{Binding SearchVM.IsCategoryAll, Mode=TwoWay}" />
                                <controls:PclListItem Content="视频" Logo="{StaticResource PclIconVideo}" GroupName="GallerySubNav" IsChecked="{Binding SearchVM.IsCategoryVideoOnly, Mode=TwoWay}" />
                                <controls:PclListItem Content="照片与实况" Logo="{StaticResource PclIconGallery}" GroupName="GallerySubNav" IsChecked="{Binding SearchVM.IsCategoryPhotoAndLive, Mode=TwoWay}" />
                                <controls:PclListItem Content="截图" Logo="{StaticResource PclIconPhone}" GroupName="GallerySubNav" IsChecked="{Binding SearchVM.IsCategoryScreenshot, Mode=TwoWay}" />
                                <controls:PclListItem Content="{Binding SearchVM.CategoryPendingTransferLabel}" Logo="{StaticResource PclIconList}" GroupName="GallerySubNav" IsChecked="{Binding SearchVM.IsCategoryPending, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:PclPageHost>
                    </Border>

                    <!-- PCL2 Signature 4px Drop Shadow Edge Strip -->
                    <Rectangle Width="4" HorizontalAlignment="Right" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" Opacity="0.04">
                                <GradientStop Color="#000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- RIGHT CONTENT CANVAS -->
                <controls:PclScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25,20,25,15">
                    <controls:PclPageHost Direction="Vertical">
                        <StackPanel>
                            <!-- Search Box (1:1 PCL2 MySearchBox) -->
                            <controls:PclSearchBox Text="{Binding SearchVM.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                   HintText="搜索图库中的照片、拍摄设备或日期..." Margin="0,0,0,12" />

                            <!-- Toolbar & Filter Card -->
                            <controls:PclCard Title="图库检视与筛选" CanSwap="False">
                                <StackPanel>
                                    <!-- Row 1: Summary & View Options -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SearchVM.SearchSummaryText}" Foreground="{DynamicResource ColorBrush2}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <controls:PclButton Content="加载更多" Command="{Binding SearchVM.LoadMoreItemsCommand}"
                                                                Visibility="{Binding SearchVM.CanLoadMoreInTableView, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Height="26" Margin="12,0,0,0" Padding="8,2" />
                                            <controls:PclButton Content="📋 查看 / 导出待传清单" Command="{Binding OpenUnifiedManualModalCommand}"
                                                                Height="26" Margin="10,0,0,0" Padding="8,2" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="排序:" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <controls:PclComboBox Width="130" Height="28" ItemsSource="{Binding SearchVM.SortModeLabels}" SelectedIndex="{Binding SearchVM.SortModeIndex, Mode=TwoWay}" Margin="0,0,8,0" />
                                            <controls:PclButton Content="{Binding SearchVM.SortDirectionText}" Command="{Binding SearchVM.ToggleSortDirectionCommand}" Height="28" Margin="0,0,10,0" />
                                            <RadioButton Content="画廊" IsChecked="{Binding SearchVM.IsGalleryView}" Style="{StaticResource PclSegmentedTab}" Margin="0,0,4,0" />
                                            <RadioButton Content="列表" IsChecked="{Binding SearchVM.IsTableView}" Style="{StaticResource PclSegmentedTab}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                Visibility="{Binding SearchVM.ShowAppleCodecNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="HEIC / 实况需要系统扩展" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12" VerticalAlignment="Center" />
                                        <controls:PclButton Content="查看安装方法" Command="{Binding OpenCodecSettingsCommand}" Height="26" Margin="10,0,0,0" Padding="8,2" />
                                    </StackPanel>

                                    <!-- Row 2: Multi-dimensional Filters -->
                                    <Border BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <WrapPanel VerticalAlignment="Center">
                                            <!-- Media Type Filter -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                                                <TextBlock Text="类型:" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <controls:PclComboBox Width="110" Height="28" ItemsSource="{Binding SearchVM.FilterTypeLabels}" SelectedIndex="{Binding SearchVM.SelectedTypeIndex, Mode=TwoWay}" />
                                            </StackPanel>

                                            <!-- Time / Date Filter -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                                                <TextBlock Text="时间:" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <controls:PclComboBox Width="110" Height="28" ItemsSource="{Binding SearchVM.DatePresetLabels}" SelectedIndex="{Binding SearchVM.SelectedDatePresetIndex, Mode=TwoWay}" />
                                            </StackPanel>

                                            <!-- Custom Date Range -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6"
                                                        Visibility="{Binding SearchVM.IsCustomDateRangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <DatePicker SelectedDate="{Binding SearchVM.FilterFromDate, Mode=TwoWay}" Width="120" Height="28" VerticalAlignment="Center" />
                                                <TextBlock Text="至" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12" VerticalAlignment="Center" Margin="6,0,6,0" />
                                                <DatePicker SelectedDate="{Binding SearchVM.FilterToDate, Mode=TwoWay}" Width="120" Height="28" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Camera Model Filter -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                                                <TextBlock Text="设备:" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <controls:PclComboBox Width="140" Height="28" ItemsSource="{Binding SearchVM.CameraModels}" SelectedItem="{Binding SearchVM.SelectedCameraModel, Mode=TwoWay}" />
                                            </StackPanel>

                                            <!-- Apply Filters Button (PCL2 Hero style) -->
                                            <controls:PclButton Content="{Binding SearchVM.ApplyFilterButtonText}"
                                                                Command="{Binding SearchVM.ApplyFiltersCommand}"
                                                                IsEnabled="{Binding SearchVM.IsSearching, Converter={StaticResource InverseBooleanConverter}}"
                                                                Height="28" Margin="0,0,8,6" Padding="14,0" ButtonType="Hero" />

                                            <!-- Reset Filters Button -->
                                            <controls:PclButton Content="重置筛选" Command="{Binding SearchVM.ClearAllFiltersCommand}" Height="28" Margin="0,0,0,6" Padding="10,2" />
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>
                            </controls:PclCard>

                            <!-- Gallery & List View Container with Loading Animation -->
                            <Grid Margin="0,0,0,14">
                                <!-- Gallery Grid View (Sweet-Album Justified Timeline Gallery) -->
                                <Border Background="White" CornerRadius="8" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1"
                                        ClipToBounds="True" Height="580"
                                        Visibility="{Binding SearchVM.IsGalleryView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <controls:PclGalleryWebControl DataContext="{Binding}" />
                                </Border>

                            <!-- Modern Reconstructed PCL2 List View -->
                            <Border Background="White" CornerRadius="8" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1" Margin="0,0,0,14"
                                    Visibility="{Binding SearchVM.IsTableView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListView ItemsSource="{Binding SearchVM.SearchResults}"
                                          BorderThickness="0" Background="Transparent"
                                          Height="580"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.CanContentScroll="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.ScrollChanged="SearchResults_ScrollChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <EventSetter Event="MouseDoubleClick" Handler="ModernListItem_MouseDoubleClick" />
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ModernListItem_PreviewMouseRightButtonDown" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="8,4,8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F1F5F9" />
                                                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <!-- ContextMenu -->
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="打开" Click="ListItem_Open_Click" />
                                                        <MenuItem Header="在文件资源管理器中定位" Click="ListItem_Reveal_Click" />
                                                        <Separator />
                                                        <MenuItem Header="📌 加入/移出待传列表" Click="ListItem_ToggleUnified_Click" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Thumbnail: 64px -->
                                                        <ColumnDefinition Width="64" />
                                                        <!-- Spacing -->
                                                        <ColumnDefinition Width="12" />
                                                        <!-- Details -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Quick Actions -->
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Thumbnail Frame -->
                                                    <Grid Grid.Column="0" Width="64" Height="64">
                                                        <Border CornerRadius="6" Background="#0F172A" ClipToBounds="True">
                                                            <Grid>
                                                                <!-- Placeholder when loading / no thumbnail -->
                                                                <Path Data="{StaticResource PclIconGallery}" Fill="#475569" Width="24" Height="24"
                                                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <!-- Image if loaded -->
                                                                <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"
                                                                       Visibility="{Binding IsThumbnailLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </Grid>
                                                        </Border>
                                                        <!-- Format Badge Capsule -->
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Background="#0B5BCB" CornerRadius="3" Padding="4,1" Margin="0,0,3,3" Opacity="0.9">
                                                            <TextBlock Text="{Binding FormatUpper}" Foreground="White" FontSize="9" FontWeight="Bold" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Details -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                            <!-- Date Badge -->
                                                            <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding DisplayCapturedAt}" FontSize="11" Foreground="#475569" FontWeight="Medium" />
                                                            </Border>
                                                            <!-- Size Badge -->
                                                            <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#475569" FontWeight="Medium" />
                                                            </Border>
                                                            <!-- Camera Model Badge -->
                                                            <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2"
                                                                    Visibility="{Binding CameraModel, Converter={x:Static controls:StringNotEmptyToVisibilityConverter.Instance}}">
                                                                <TextBlock Text="{Binding CameraModel}" FontSize="11" Foreground="#475569" FontWeight="Medium" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Quick Action Buttons -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <!-- Unified Pending Transfer Toggle -->
                                                        <Button Click="ListItem_ToggleUnified_Click" Margin="0,0,6,0" Cursor="Hand"
                                                                ToolTip="加入或移出待传列表">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="btnBorder" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="10,5">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock x:Name="btnIcon" Text="📋" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                                        <TextBlock x:Name="btnText" Text="待传" FontSize="11" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsManualSelectedForIPhone}" Value="True">
                                                                                        <Setter TargetName="btnBorder" Property="Background" Value="#0B5BCB" />
                                                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0B5BCB" />
                                                                                        <Setter TargetName="btnText" Property="Foreground" Value="White" />
                                                                                        <Setter TargetName="btnText" Property="FontWeight" Value="Bold" />
                                                                                    </DataTrigger>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.85" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Reveal Folder -->
                                                        <controls:PclIconButton Logo="{StaticResource PclIconFolder}"
                                                                                Click="ListItem_Reveal_Click"
                                                                                ToolTip="在文件资源管理器中定位" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>

                            <!-- PCL2 Top Loading Bar (Smooth animated indeterminate line) -->
                            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Margin="1,1,1,0"
                                         Foreground="{DynamicResource ColorBrush3}" Background="Transparent" BorderThickness="0"
                                         Visibility="{Binding SearchVM.IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Floating Center Loading Card -->
                            <Border Background="#33FFFFFF" CornerRadius="8" IsHitTestVisible="False"
                                    Visibility="{Binding SearchVM.IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border Background="White" CornerRadius="18" Padding="18,8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#0B5BCB" Opacity="0.14" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Width="50" Height="4" Foreground="{DynamicResource ColorBrush3}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="正在检索与更新图库..." FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                        </StackPanel>
                    </controls:PclPageHost>
                </controls:PclScrollViewer>
            </Grid>

            <!-- ==================================================== -->
            <!--  PAGE 2: 【☁ 云同步与回传 (Sync)】                   -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left Sub-Nav (220px) -->
                    <ColumnDefinition Width="220" />
                    <!-- Right Canvas -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sub-Nav -->
                <Grid Grid.Column="0">
                    <Border Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}" 
                            BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,1,0">
                        <controls:PclPageHost Direction="Horizontal">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="同步引擎与回传" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ColorBrushGray2}" Margin="18,10,0,8" />
                                <controls:PclListItem Content="Google 相册" Logo="{StaticResource PclIconCloud}" GroupName="SyncSubNav"
                                                      IsChecked="{Binding SyncSubTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=0}" />
                                <controls:PclListItem Content="同步到 iPhone" Logo="{StaticResource PclIconPhone}" GroupName="SyncSubNav"
                                                      IsChecked="{Binding SyncSubTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=1}" />
                                <controls:PclListItem Content="同步到 Android" Logo="{StaticResource PclIconAndroid}" GroupName="SyncSubNav"
                                                      IsChecked="{Binding SyncSubTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=2}" />
                            </StackPanel>
                        </controls:PclPageHost>
                    </Border>

                    <!-- PCL2 Signature 4px Drop Shadow Edge Strip -->
                    <Rectangle Width="4" HorizontalAlignment="Right" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" Opacity="0.04">
                                <GradientStop Color="#000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- Right Canvas -->
                <controls:PclScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25,20,25,15">
                    <StackPanel>
                        <!-- SUB-VIEW 0: Google 相册 (GooglePhotosVM) -->
                        <controls:PclPageHost Direction="Vertical">
                            <controls:PclPageHost.Style>
                                <Style TargetType="controls:PclPageHost">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncSubTabIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SyncSubTabIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:PclPageHost.Style>
                            <StackPanel DataContext="{Binding GooglePhotosVM}">

                                <!-- Card 1: 账号与代理 -->
                                <controls:PclCard Title="Google 相册授权与连接" CanSwap="False">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CloudLabel" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="32" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="已授权账号" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,25,0" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccountEmail, TargetNullValue='未登录', FallbackValue='未登录'}" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                            <controls:PclButton Content="登录 / 切换账号" Command="{Binding LoginViaWebViewCommand}" Height="28" Margin="0,0,8,0" />
                                            <controls:PclButton Content="退出登录" Command="{Binding LogoutCommand}" Height="28" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="网络代理通道" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,25,0" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProxyDisplayText}" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding ProxyStatusText}" Foreground="{Binding ProxyStatusColor}" FontSize="11" VerticalAlignment="Center"
                                                       Visibility="{Binding HasProxyStatusText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <controls:PclButton Grid.Row="2" Grid.Column="2" Content="前往网络设置" Command="{Binding NavigateToSettingsCommand}" Height="28" />
                                    </Grid>
                                </controls:PclCard>

                                <!-- Card 2: 上传策略 -->
                                <controls:PclCard Title="上传归档范围与相册策略" CanSwap="False">
                                    <StackPanel>
                                        <TextBlock Text="上传任务范围" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,6" />
                                        <controls:PclRadioBox Content="全量同步 (将本地所有照片增量上传至 Google 相册)" IsChecked="{Binding IsScopeAll, Mode=TwoWay}" Margin="0,0,0,6" />
                                        <controls:PclRadioBox Content="自选清单同步 (仅上传在图库中挑选标记的照片)" IsChecked="{Binding IsScopeManualSelection, Mode=TwoWay}" Margin="0,0,0,6" />

                                        <Border Margin="24,0,0,12" Padding="10" Background="#F8FAFC" CornerRadius="6" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1"
                                                Visibility="{Binding IsScopeManualSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ManualSelectionCountText}" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <controls:PclButton Content="👁️ 查看 / 编辑待传清单" Command="{Binding OpenManualModalCommand}" Height="28" Margin="0,0,8,0" Padding="10,2" />
                                                <controls:PclButton Content="从文件资源管理器挑选..." Command="{Binding PickFilesFromExplorerCommand}" Height="28" Padding="10,2" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Google 相册归档模式" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" Margin="0,4,0,8" />
                                        <controls:PclRadioBox Content="按拍摄年月自动归档相册 (YYYY-MM)" IsChecked="{Binding IsAlbumAuto, Mode=TwoWay}" Margin="0,0,0,6" />
                                        <controls:PclRadioBox Content="全量备份入相册库 (不建相册)" IsChecked="{Binding IsAlbumNone, Mode=TwoWay}" Margin="0,0,0,6" />
                                        <controls:PclRadioBox Content="指定自定义相册名称" IsChecked="{Binding IsAlbumCustom, Mode=TwoWay}" Margin="0,0,0,6" />

                                        <Grid Margin="24,0,0,4" Visibility="{Binding IsAlbumCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="目标相册名称:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1" Text="{Binding CustomAlbumName, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />
                                        </Grid>
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Hero Action Button -->
                                <controls:PclButton Content="开始同步到 Google 相册"
                                                    Command="{Binding StartSyncCommand}"
                                                    ButtonType="Hero"
                                                    Height="48"
                                                    Margin="0,0,0,14"
                                                    Visibility="{Binding IsSyncing, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                <controls:PclButton Content="停止同步"
                                                    Command="{Binding CancelSyncCommand}"
                                                    ButtonType="Hero"
                                                    Height="48"
                                                    Margin="0,0,0,14"
                                                    Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            </StackPanel>
                        </controls:PclPageHost>

                        <!-- SUB-VIEW 1: 同步到 iPhone (IPhoneSyncVM) -->
                        <controls:PclPageHost Direction="Vertical">
                            <controls:PclPageHost.Style>
                                <Style TargetType="controls:PclPageHost">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncSubTabIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:PclPageHost.Style>
                            <StackPanel DataContext="{Binding IPhoneSyncVM}">

                                <!-- Hint Banner -->
                                <controls:PclHint HintType="Success" Margin="0,0,0,14">
                                    <TextBlock Text="通过 Apple Devices / iTunes 文件共享无损回传照片与实况照片至 iPhone。" FontSize="12" Foreground="#047857" />
                                </controls:PclHint>

                                <!-- Card 1: 回传媒体范围与挑选 -->
                                <controls:PclCard Title="回传媒体范围与挑选" CanSwap="False">
                                    <StackPanel>
                                        <controls:PclRadioBox Content="全量回传 (将本地媒体库全部照片回传)" IsChecked="{Binding IsScopeAll, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <controls:PclRadioBox Content="按拍摄日期范围挑选" IsChecked="{Binding IsScopeDateRange, Mode=TwoWay}" Margin="0,0,0,8" />

                                        <!-- Date Range Inputs with Presets -->
                                        <Border Margin="24,0,0,10" Padding="12" Background="#F8FAFC" CornerRadius="6" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1"
                                                Visibility="{Binding IsScopeDateRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="从:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                                                    <DatePicker SelectedDate="{Binding ScopeDateFrom, Mode=TwoWay}" Width="130" Height="28" Margin="0,0,12,0" />
                                                    <TextBlock Text="到:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                                                    <DatePicker SelectedDate="{Binding ScopeDateTo, Mode=TwoWay}" Width="130" Height="28" Margin="0,0,12,0" />
                                                    <controls:PclButton Content="清空" Command="{Binding ClearDateRangeCommand}" Height="28" Padding="10,2" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="快捷预设:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                                    <controls:PclButton Content="近30天" Command="{Binding SetDatePresetLast30DaysCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                                    <controls:PclButton Content="近90天" Command="{Binding SetDatePresetLast90DaysCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                                    <controls:PclButton Content="近1年" Command="{Binding SetDatePresetLast1YearCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                                    <controls:PclButton Content="今年" Command="{Binding SetDatePresetThisYearCommand}" Height="24" Padding="8,2" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <controls:PclRadioBox Content="按子目录分类挑选" IsChecked="{Binding IsScopeSubfolder, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <Border Margin="24,0,0,10" Padding="10" Background="#F8FAFC" CornerRadius="6" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1"
                                                Visibility="{Binding IsScopeSubfolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl ItemsSource="{Binding Subfolders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding FolderName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2,12,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Border>

                                        <controls:PclRadioBox Content="仅回传自选清单中的照片" IsChecked="{Binding IsScopeManualSelection, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <Border Margin="24,0,0,0" Padding="10" Background="#F8FAFC" CornerRadius="6" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1"
                                                Visibility="{Binding IsScopeManualSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ManualSelectionCountText}" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <controls:PclButton Content="👁️ 查看 / 编辑待传清单" Command="{Binding OpenManualModalCommand}" Height="28" Margin="0,0,8,0" Padding="10,2" />
                                                <controls:PclButton Content="从文件资源管理器挑选..." Command="{Binding PickFilesFromExplorerCommand}" Height="28" Padding="10,2" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Card 2: 目标相册与同步组织模式 -->
                                <controls:PclCard Title="目标相册与回传选项" CanSwap="False">
                                    <StackPanel>
                                        <controls:PclRadioBox Content="按拍摄年月组织文件夹 (如 2026-10)" IsChecked="{Binding IsYearMonthMode, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <controls:PclRadioBox Content="单一平面文件夹导入 (适合直接在手机端相册全选存图)" IsChecked="{Binding IsFlatMode, Mode=TwoWay}" Margin="0,0,0,12" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Apple Devices 传输目录:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1" Text="{Binding CustomSyncFolder, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />
                                            <controls:PclButton Grid.Column="2" Content="浏览..." Command="{Binding BrowseSyncFolderCommand}" Height="28" Margin="8,0,0,0" />
                                            <controls:PclButton Grid.Column="3" Content="🚀 启动 Apple Devices" Command="{Binding OpenAppleDevicesCommand}" Height="28" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Hero Action Button -->
                                <controls:PclButton Content="开始导出并同步到 iPhone"
                                                    Command="{Binding StartExportCommand}"
                                                    ButtonType="Hero"
                                                    Height="48"
                                                    Margin="0,0,0,14"
                                                    Visibility="{Binding IsExporting, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                <controls:PclButton Content="停止回传"
                                                    Command="{Binding CancelExportCommand}"
                                                    ButtonType="Hero"
                                                    Height="48"
                                                    Margin="0,0,0,14"
                                                    Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            </StackPanel>
                        </controls:PclPageHost>

                        <!-- SUB-VIEW 2: 同步到 Android (AndroidSyncVM) -->
                        <controls:PclPageHost Direction="Vertical">
                            <controls:PclPageHost.Style>
                                <Style TargetType="controls:PclPageHost">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncSubTabIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:PclPageHost.Style>
                            <StackPanel DataContext="{Binding AndroidSyncVM}">

                                <!-- Hint Banner -->
                                <controls:PclHint HintType="Success" Margin="0,0,0,14">
                                    <TextBlock Text="通过局域网 FTP 服务无损回传照片与视频至 Android 设备相机相册目录。" FontSize="12" Foreground="#047857" />
                                </controls:PclHint>

                                <!-- Card 1: FTP 连接配置 -->
                                <controls:PclCard Title="Android 设备 FTP 连接参数" CanSwap="False">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="手机 IP 地址:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1" Text="{Binding AndroidFtpHost, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />

                                            <TextBlock Grid.Column="3" Text="FTP 端口:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="4" Text="{Binding AndroidFtpPort, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="用户名 (可选):" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1" Text="{Binding AndroidFtpUser, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />

                                            <TextBlock Grid.Column="3" Text="密码 (可选):" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="4" Text="{Binding AndroidFtpPassword, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="目标相机目录:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1" Text="{Binding AndroidTargetDir, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />
                                            <controls:PclButton Grid.Column="2" Content="测试连通性" Command="{Binding TestConnectionCommand}" Height="28" Margin="10,0,0,0" />
                                        </Grid>

                                        <TextBlock Text="{Binding TestStatus}" FontSize="12" Foreground="{DynamicResource ColorBrush2}" FontWeight="SemiBold"
                                                   Visibility="{Binding TestStatus, Converter={x:Static controls:StringNotEmptyToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Card 2: 恢复归档范围 -->
                                <controls:PclCard Title="回传恢复范围与筛选" CanSwap="False">
                                    <StackPanel>
                                        <controls:PclRadioBox Content="全量恢复 (将电脑归档库全部照片回传至手机)" IsChecked="{Binding IsScopeAll, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <controls:PclRadioBox Content="按拍摄日期范围回传" IsChecked="{Binding IsScopeDateRange, Mode=TwoWay}" Margin="0,0,0,8" />

                                        <Border Margin="24,0,0,10" Padding="12" Background="#F8FAFC" CornerRadius="6" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1"
                                                Visibility="{Binding IsScopeDateRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="从:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                                                    <DatePicker SelectedDate="{Binding ScopeDateFrom, Mode=TwoWay}" Width="130" Height="28" Margin="0,0,12,0" />
                                                    <TextBlock Text="到:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                                                    <DatePicker SelectedDate="{Binding ScopeDateTo, Mode=TwoWay}" Width="130" Height="28" Margin="0,0,12,0" />
                                                    <controls:PclButton Content="清空" Command="{Binding ClearDateRangeCommand}" Height="28" Padding="10,2" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="快捷预设:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                                    <controls:PclButton Content="近30天" Command="{Binding SetDatePresetLast30DaysCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                                    <controls:PclButton Content="近90天" Command="{Binding SetDatePresetLast90DaysCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                                    <controls:PclButton Content="近1年" Command="{Binding SetDatePresetLast1YearCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                                    <controls:PclButton Content="今年" Command="{Binding SetDatePresetThisYearCommand}" Height="24" Padding="8,2" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <controls:PclRadioBox Content="仅回传在图库中挑选标记的照片" IsChecked="{Binding IsScopeManualSelection, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <Border Margin="24,0,0,0" Padding="10" Background="#F8FAFC" CornerRadius="6" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1"
                                                Visibility="{Binding IsScopeManualSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ManualSelectionCountText}" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <controls:PclButton Content="👁️ 查看 / 编辑待传清单" Command="{Binding OpenManualModalCommand}" Height="28" Margin="0,0,8,0" Padding="10,2" />
                                                <controls:PclButton Content="从文件资源管理器挑选..." Command="{Binding PickFilesFromExplorerCommand}" Height="28" Padding="10,2" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Hero Action Button -->
                                <controls:PclButton Content="开始同步回传至 Android 设备"
                                                    Command="{Binding StartSyncCommand}"
                                                    ButtonType="Hero"
                                                    Height="48"
                                                    Margin="0,0,0,14"
                                                    Visibility="{Binding IsSyncing, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                <controls:PclButton Content="停止回传"
                                                    Command="{Binding CancelSyncCommand}"
                                                    ButtonType="Hero"
                                                    Height="48"
                                                    Margin="0,0,0,14"
                                                    Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            </StackPanel>
                        </controls:PclPageHost>
                    </StackPanel>
                </controls:PclScrollViewer>
            </Grid>

            <!-- ==================================================== -->
            <!--  PAGE 3: 【⚙ 设置 (Settings)】                       -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SUB-NAV PANE -->
                <Grid Grid.Column="0">
                    <Border Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}" 
                            BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,1,0">
                        <controls:PclPageHost Direction="Horizontal">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="系统设置" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ColorBrushGray2}" Margin="18,10,0,8" />
                                <controls:PclListItem Content="存储架构与基准规范" Logo="{StaticResource PclIconStorage}" GroupName="SettingsSubNav"
                                                      IsChecked="{Binding SettingsSubTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=0}" />
                                <controls:PclListItem Content="媒体组织与导入规则" Logo="{StaticResource PclIconFolder}" GroupName="SettingsSubNav"
                                                      IsChecked="{Binding SettingsSubTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=1}" />
                                <controls:PclListItem Content="性能保护与网络通道" Logo="{StaticResource PclIconCloud}" GroupName="SettingsSubNav"
                                                      IsChecked="{Binding SettingsSubTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=2}" />
                                <controls:PclListItem Content="维护工具与通用关于" Logo="{StaticResource PclIconSetup}" GroupName="SettingsSubNav"
                                                      IsChecked="{Binding SettingsSubTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=3}" />
                            </StackPanel>
                        </controls:PclPageHost>
                    </Border>

                    <!-- PCL2 Signature 4px Drop Shadow Edge Strip -->
                    <Rectangle Width="4" HorizontalAlignment="Right" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" Opacity="0.04">
                                <GradientStop Color="#000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- RIGHT CONTENT CANVAS -->
                <controls:PclScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25,20,25,15">
                    <StackPanel>
                        <!-- SUB-VIEW 0: 存储架构与基准规范 (SettingsVM) -->
                        <controls:PclPageHost Direction="Vertical">
                            <controls:PclPageHost.Style>
                                <Style TargetType="controls:PclPageHost">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsSubTabIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SettingsSubTabIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SettingsSubTabIndex}" Value="3">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:PclPageHost.Style>
                            <StackPanel DataContext="{Binding SettingsVM}">

                                <!-- Card 1: 主归档磁盘库 -->
                                <controls:PclCard Title="主归档磁盘库" CanSwap="False">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 1: 主盘符 -->
                                        <TextBlock Grid.Row="0" Text="当前主备份盘" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,25,0" />
                                        <controls:PclComboBox Grid.Row="0" Grid.Column="1"
                                                              ItemsSource="{Binding AvailableVolumes}"
                                                              SelectedItem="{Binding SelectedVolume}">
                                            <controls:PclComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" />
                                                </DataTemplate>
                                            </controls:PclComboBox.ItemTemplate>
                                        </controls:PclComboBox>
                                        <controls:PclButton Grid.Row="0" Grid.Column="2" Content="打开目录" Command="{Binding OpenInExplorerCommand}" Height="28" Margin="8,0,0,0" />

                                        <!-- Row 2: 归档主目录只读展示 -->
                                        <TextBlock Grid.Row="2" Text="归档根目录路径" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,25,0" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ArchivePath}" IsReadOnly="True"
                                                 Height="28" VerticalContentAlignment="Center" Padding="6,0" Background="#F1F5F9" BorderBrush="{DynamicResource ColorBrush6}" />

                                        <!-- Row 3: 跨盘防重提示 -->
                                        <controls:PclHint Grid.Row="4" Grid.ColumnSpan="3" HintType="Success" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding DiscoveredArchivesSummary}" Foreground="#047857" FontSize="12" TextWrapping="Wrap" />
                                        </controls:PclHint>
                                    </Grid>
                                </controls:PclCard>

                                <!-- Card 2: 目录分类与时间层级规范 -->
                                <controls:PclCard Title="目录分类与时间层级规范" CanSwap="False">
                                    <StackPanel>
                                        <controls:PclCheckBox Content="按设备型号与别名划分专属子目录 (如 D:\PicHarbor\iPhone 15\)" IsChecked="{Binding GroupMediaByDevice, Mode=TwoWay}" Margin="0,0,0,12" />

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="默认照片时间组织格式:" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <controls:PclComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding OrganizeSchemes}"
                                                                  SelectedItem="{Binding SelectedScheme}" Height="28" />
                                        </Grid>
                                    </StackPanel>
                                </controls:PclCard>
                            </StackPanel>
                        </controls:PclPageHost>

                        <!-- SUB-VIEW 1: 媒体组织与导入规则 (SettingsVM) -->
                        <controls:PclPageHost Direction="Vertical">
                            <controls:PclPageHost.Style>
                                <Style TargetType="controls:PclPageHost">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsSubTabIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:PclPageHost.Style>
                            <StackPanel DataContext="{Binding SettingsVM}">

                                <!-- Card 1: 媒体智能绑定与组织 -->
                                <controls:PclCard Title="媒体智能绑定与组织" CanSwap="False">
                                    <StackPanel>
                                        <controls:PclCheckBox Content="保留手机原始 Live Photo 配套 MOV 视频成对组织 (防止实况失效)" IsChecked="{Binding AutoCompleteLivePhotoPair, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <controls:PclCheckBox Content="自动关联 AAE 调色编辑副文件 (保证滤镜编辑无损还原)" IsChecked="{Binding AutoCompleteAaeSidecar, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <controls:PclCheckBox Content="关联 RAW + JPG 成对组织 (专业单反与预览图成对收纳)" IsChecked="{Binding AutoCompleteRawJpg, Mode=TwoWay}" />
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Card 2: EXIF 拍摄时间系统校准策略 -->
                                <controls:PclCard Title="EXIF 拍摄时间系统校准策略" CanSwap="False">
                                    <StackPanel>
                                        <TextBlock Text="在导入照片时，自动读取照片内部真实拍摄时间并同步校准 Windows 文件系统时间属性：" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,10" />
                                        <controls:PclCheckBox Content="校准至文件修改时间 (LastWriteTime)" IsChecked="{Binding SyncExifToLastWriteTime, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <controls:PclCheckBox Content="校准至文件创建时间 (CreationTime - 解决第三方网盘及照片应用排序错乱)" IsChecked="{Binding SyncExifToCreationTime, Mode=TwoWay}" />
                                    </StackPanel>
                                </controls:PclCard>
                            </StackPanel>
                        </controls:PclPageHost>

                        <!-- SUB-VIEW 2: 性能保护与网络通道 (SettingsVM) -->
                        <controls:PclPageHost Direction="Vertical">
                            <controls:PclPageHost.Style>
                                <Style TargetType="controls:PclPageHost">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsSubTabIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:PclPageHost.Style>
                            <StackPanel DataContext="{Binding SettingsVM}">

                                <!-- Card 1: 全局网络代理通道 (Proxy) -->
                                <controls:PclCard Title="全局网络代理通道 (Proxy)" CanSwap="False">
                                    <StackPanel>
                                        <TextBlock Text="配置全局科学上网 HTTP/SOCKS5 代理地址，供 Google 相册等远程云服务直接复用。" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,10" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="网络代理地址:" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <TextBox Grid.Column="1" Text="{Binding GooglePhotosProxy, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />
                                            <controls:PclButton Grid.Column="2" Content="测试连接" Command="{Binding TestProxyCommand}" Height="28" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding ProxyStatusText}" Foreground="{Binding ProxyStatusColor}" FontSize="12" FontWeight="SemiBold"
                                                   Visibility="{Binding ProxyStatusText, Converter={x:Static controls:StringNotEmptyToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Card 2: 云上传引擎底层参数 (Google Photos Engine) -->
                                <controls:PclCard Title="云上传引擎底层参数 (Google Photos Engine)" CanSwap="False">
                                    <StackPanel>
                                        <!-- Threads -->
                                        <Grid Margin="0,4,0,10" Grid.IsSharedSizeScope="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="EngineParamLabel" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="65" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="并发上传线程数" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" Margin="0,0,25,0" />
                                            <controls:PclSlider Grid.Column="1" Minimum="1" Maximum="6" Value="{Binding GooglePhotosThreads, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding GooglePhotosThreads, StringFormat='{}{0} 线程'}" Foreground="{DynamicResource ColorBrushGray2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Timeout -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="EngineParamLabel" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="65" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="请求超时阈值" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" Margin="0,0,25,0" />
                                            <controls:PclSlider Grid.Column="1" Minimum="30" Maximum="120" Value="{Binding GooglePhotosTimeoutSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding GooglePhotosTimeoutSeconds, StringFormat='{}{0} 秒'}" Foreground="{DynamicResource ColorBrushGray2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Auto Retry -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="EngineParamLabel" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="65" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="失败自动重试" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" Margin="0,0,25,0" />
                                            <controls:PclSlider Grid.Column="1" Minimum="1" Maximum="5" Value="{Binding GooglePhotosAutoRetryAttempts, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding GooglePhotosAutoRetryAttempts, StringFormat='{}{0} 次'}" Foreground="{DynamicResource ColorBrushGray2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Card 3: 设备通信与系统保护 -->
                                <controls:PclCard Title="设备通信与系统保护" CanSwap="False">
                                    <StackPanel>
                                        <Grid Margin="0,4,0,8" Grid.IsSharedSizeScope="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="设备读取超时阈值" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" Margin="0,0,25,0" />
                                            <controls:PclSlider Grid.Column="1" Minimum="10" Maximum="120" Value="{Binding ReadTimeoutSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding ReadTimeoutSeconds, StringFormat='{}{0} 秒'}" Foreground="{DynamicResource ColorBrushGray2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <controls:PclCheckBox Content="传输进行中阻止电脑自动进入休眠" IsChecked="{Binding DisablePcSleepNotice, Mode=TwoWay}" />
                                    </StackPanel>
                                </controls:PclCard>
                            </StackPanel>
                        </controls:PclPageHost>

                        <!-- SUB-VIEW 3: 维护工具与通用关于 -->
                        <controls:PclPageHost Direction="Vertical">
                            <controls:PclPageHost.Style>
                                <Style TargetType="controls:PclPageHost">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsSubTabIndex}" Value="3">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:PclPageHost.Style>
                            <StackPanel>

                                <!-- Card 0: 数据库与存储库健康管理 (SettingsVM) -->
                                <controls:PclCard Title="数据库健康管理与冗余清理" CanSwap="False" DataContext="{Binding SettingsVM}">
                                    <StackPanel>
                                        <TextBlock Text="监控 SQLite 核心索引库体积，按期清理追溯审计流水以释放磁盘空间，并支持智能自愈扫描（修复电脑端手动删除导致的脱节幽灵索引）。"
                                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                        <!-- Metrics Overview Boxes -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Box 1: Storage Size -->
                                            <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="0,0,6,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="数据库物理体积 (含 WAL 缓存)" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding DbSizeText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" />
                                                        <TextBlock Text="{Binding DbWalSizeText, StringFormat=' (WAL: {0})'}" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Box 2: Records Breakdown -->
                                            <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="6,0,0,0" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="记录指标构成 (核心索引 vs 审计流水)" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding CoreFilesCount, StringFormat='核心: {0:N0} 项'}" FontSize="14" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding HistoryRecordsCount, StringFormat='流水: {0:N0} 项'}" FontSize="14" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <controls:PclButton Content="🔄 刷新数据库指标" Command="{Binding RefreshDbMetricsCommand}" Height="28" Padding="12,0" />
                                            <TextBlock Text="{Binding DbMetricsSummaryText}" FontSize="11.5" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Height="1" Background="{DynamicResource ColorBrush6}" Margin="0,0,0,14" />

                                        <!-- Section A: 冗余历史清理 -->
                                        <TextBlock Text="1. 冗余审计历史清理（安全回收空间）" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,6" />
                                        <TextBlock Text="历史传输明细仅用于在设备卡片中回溯以前哪台手机传了什么照片。清理冗余历史绝对不会影响电脑上的真实照片，手机下次插入也依然能秒级跳过已备份文件。"
                                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="保留时长策略:" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <controls:PclComboBox Grid.Column="1" ItemsSource="{Binding RetentionPolicies}" SelectedIndex="{Binding SelectedRetentionIndex, Mode=TwoWay}" Height="28" />
                                            <controls:PclButton Grid.Column="2" Content="立即执行清理与整理" Command="{Binding PruneRedundantDataCommand}" IsEnabled="{Binding IsPruning, Converter={StaticResource InverseBooleanConverter}}" Height="28" Margin="8,0,0,0" Padding="14,0" />
                                        </Grid>

                                        <TextBlock Text="{Binding PruneStatusMessage}" Foreground="#10B981" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"
                                                   Visibility="{Binding PruneStatusMessage, Converter={x:Static controls:StringNotEmptyToVisibilityConverter.Instance}}" />

                                        <Border Height="1" Background="{DynamicResource ColorBrush6}" Margin="0,0,0,14" />

                                        <!-- Section B: 数据库自愈与一致性修复 -->
                                        <TextBlock Text="2. 智能自愈与一致性修复（修复电脑手动删文件）" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,6" />
                                        <TextBlock Text="若您曾手动在电脑归档目录中删除了某些照片导致数据库残留失效索引，可在此进行一键自愈。系统将安全剔除幽灵记录，绝不主动删除任何电脑或手机上的真实有效文件。"
                                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                        <controls:PclHint HintType="Info" Margin="0,0,0,12">
                                            <TextBlock Text="安全红线：自愈修复只清理数据库中指向已不存在文件的失效索引，使图库与磁盘保持真实一致，绝不修改或删除任何尚存的媒体文件。" FontSize="12" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" />
                                        </controls:PclHint>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <controls:PclButton Content="⚡ 一键扫描并自愈修复" Command="{Binding RepairDatabaseCommand}" ButtonType="Hero" IsEnabled="{Binding IsRepairing, Converter={StaticResource InverseBooleanConverter}}" Height="34" Padding="18,0" />
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding IsRepairing, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding RepairProgressDetailText}" Foreground="{DynamicResource ColorBrush1}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding RepairStatusMessage}" Foreground="#10B981" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                                                   Visibility="{Binding RepairStatusMessage, Converter={x:Static controls:StringNotEmptyToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Card 1: EXIF 拍摄时间批量系统校准 (SettingsVM) -->
                                <controls:PclCard Title="EXIF 拍摄时间批量系统校准" CanSwap="False" DataContext="{Binding SettingsVM}">
                                    <StackPanel>
                                        <TextBlock Text="智能遍历主归档盘中媒体文件，将 EXIF 拍摄时间写入操作系统底层文件创建时间与修改时间，彻底解决 Windows 照片与第三方网盘时间混乱问题。"
                                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                        <controls:PclCheckBox Content="将 EXIF 拍摄时间同步写入文件修改时间 (LastWriteTime)" IsChecked="{Binding SyncExifToLastWriteTime, Mode=TwoWay}" Margin="0,0,0,8" />
                                        <controls:PclCheckBox Content="将 EXIF 拍摄时间同步写入文件创建时间 (CreationTime)" IsChecked="{Binding SyncExifToCreationTime, Mode=TwoWay}" Margin="0,0,0,12" />

                                        <controls:PclHint HintType="Warning" Margin="0,0,0,14">
                                            <TextBlock Text="本操作将直接更新本地文件系统的时间戳属性，不修改媒体原始二进制内容。校准速度极快且完全无损。" FontSize="12" Foreground="#B45309" TextWrapping="Wrap" />
                                        </controls:PclHint>

                                        <controls:PclButton Content="立即开始校准" Command="{Binding SyncNowCommand}" ButtonType="Hero" Height="36" Padding="18,0" HorizontalAlignment="Left" Margin="0,0,0,12" />

                                        <!-- Progress Bar & Details -->
                                        <StackPanel Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,8">
                                            <Grid Margin="0,0,0,6">
                                                <ProgressBar Value="{Binding SyncProgressPercentage}" Height="18" Minimum="0" Maximum="100" Foreground="{DynamicResource ColorBrush3}" Background="#E2E8F0" BorderThickness="0" />
                                                <TextBlock Text="{Binding SyncProgressOverlayText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="11" />
                                            </Grid>

                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="{Binding SyncProgressDetailText}" Foreground="{DynamicResource ColorBrush1}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SyncUpdatedText}" Foreground="#10B981" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Text="{Binding SyncStatusMessage}" Foreground="#10B981" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding SyncStatusMessage, Converter={x:Static controls:StringNotEmptyToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Card 2: 存储目录结构智能重组 (ReorganizeVM) -->
                                <controls:PclCard Title="存储目录结构智能重组" CanSwap="False" DataContext="{Binding ReorganizeVM}">
                                    <StackPanel>
                                        <TextBlock Text="无损重构本地媒体库的目录层级结构，支持按拍摄时间分类格式重新归档。"
                                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,14" />

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="当前组织结构" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1" Text="{Binding CurrentScheme}" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Padding="6,0" Background="#F1F5F9" BorderBrush="{DynamicResource ColorBrush6}" />

                                            <TextBlock Grid.Column="3" Text="目标组织方案" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <controls:PclComboBox Grid.Column="4" ItemsSource="{Binding Schemes}" SelectedItem="{Binding TargetScheme}" Height="28" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <controls:PclButton Content="🔍 模拟预览 (Dry Run)" Command="{Binding DryRunCommand}" Height="34" Margin="0,0,10,0" Padding="14,0" />
                                            <controls:PclButton Content="⚡ 开始执行重构" Command="{Binding ExecuteReorganizeCommand}" ButtonType="Hero" Height="34" Padding="18,0" />
                                        </StackPanel>

                                        <!-- Summary & DataGrid Preview -->
                                        <TextBlock Text="{Binding ReorgSummaryText, FallbackValue='点击“模拟预览”分析目录结构重排变动。'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" Margin="0,10,0,10" />

                                        <DataGrid ItemsSource="{Binding PreviewItems}"
                                                  Style="{StaticResource PclDataGrid}"
                                                  MaxHeight="320"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="原文件路径" Binding="{Binding OriginalPath}" Width="*" />
                                                <DataGridTextColumn Header="重组后新路径" Binding="{Binding TargetPath}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </controls:PclCard>

                                <!-- Card 3: 界面语言与关于 -->
                                <controls:PclCard Title="语言与界面外观" CanSwap="False">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="软件显示语言" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" Margin="0,0,25,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <controls:PclButton Content="🇨🇳 简体中文" Command="{Binding SwitchLanguageCommand}" CommandParameter="zh-CN" Height="28" Margin="0,0,10,0" />
                                            <controls:PclButton Content="🇺🇸 English" Command="{Binding SwitchLanguageCommand}" CommandParameter="en-US" Height="28" />
                                        </StackPanel>
                                    </Grid>
                                </controls:PclCard>

                                <controls:PclCard Title="HEIC 与实况扩展" CanSwap="False" DataContext="{Binding SettingsVM}">
                                    <StackPanel>
                                        <TextBlock Text="iPhone 的 HEIC 和实况需要 Windows 的 HEIF、HEVC 扩展，图库才能显示和播放。下面三种方式任选。装好后点「重新检测」。"
                                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                        <controls:PclHint HintType="Info" Margin="0,0,0,8"
                                                          Visibility="{Binding CodecProbeCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding CodecStatusText}" FontSize="12" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" />
                                        </controls:PclHint>
                                        <controls:PclHint HintType="Success" Margin="0,0,0,8"
                                                          Visibility="{Binding CodecReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding CodecStatusText}" FontSize="12" Foreground="#047857" TextWrapping="Wrap" />
                                        </controls:PclHint>
                                        <controls:PclHint HintType="Warning" Margin="0,0,0,8"
                                                          Visibility="{Binding CodecMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding CodecStatusText}" FontSize="12" Foreground="#B45309" TextWrapping="Wrap" />
                                        </controls:PclHint>
                                        <controls:PclButton Content="重新检测" Command="{Binding RecheckCodecsCommand}" Height="28" Padding="12,0" HorizontalAlignment="Left" Margin="0,0,0,16" />

                                        <TextBlock Text="微软商店" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,6" />
                                        <TextBlock Text="HEIF 图像扩展免费。HEVC 有付费版，也有设备制造商提供的免费版；免费版不是每台电脑都能下载。"
                                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <controls:PclButton Content="打开 HEIF 商店页" Command="{Binding OpenHeifStoreCommand}" Height="28" Margin="0,0,8,0" Padding="10,0" />
                                            <controls:PclButton Content="打开 HEVC 商店页（付费）" Command="{Binding OpenHevcPaidStoreCommand}" Height="28" Margin="0,0,8,0" Padding="10,0" />
                                            <controls:PclButton Content="打开 HEVC 商店页（免费）" Command="{Binding OpenHevcFreeStoreCommand}" Height="28" Padding="10,0" />
                                        </StackPanel>

                                        <TextBlock Text="安装包" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,6" />
                                        <TextBlock Text="下载页里是 HEIF 图像扩展，以及设备制造商提供的 HEVC 视频扩展，文件为 .appxbundle。"
                                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <controls:PclButton Content="打开下载页" Command="{Binding OpenPackageDownloadCommand}" Height="28" Margin="0,0,12,0" Padding="10,0" />
                                            <TextBlock Text="密码 0000" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" FontSize="12" Margin="0,0,8,0" />
                                            <controls:PclButton Content="复制密码" Command="{Binding CopyPackagePasswordCommand}" Height="28" Padding="10,0" />
                                        </StackPanel>

                                        <TextBlock Text="商店无法安装时" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,6" />
                                        <TextBlock Text="打开链接生成页，把产品链接粘贴进输入框并确认，下载 .appxbundle 后安装，然后重启本软件。HEIF 和 HEVC 各复制一次。"
                                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <controls:PclButton Content="打开链接生成页" Command="{Binding OpenLinkGeneratorCommand}" Height="28" Margin="0,0,8,0" Padding="10,0" />
                                            <controls:PclButton Content="复制 HEIF 产品链接" Command="{Binding CopyHeifProductLinkCommand}" Height="28" Margin="0,0,8,0" Padding="10,0" />
                                            <controls:PclButton Content="复制 HEVC 产品链接" Command="{Binding CopyHevcProductLinkCommand}" Height="28" Padding="10,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding CopyFeedbackText}" Foreground="#10B981" FontSize="12" Margin="0,0,0,8"
                                                   Visibility="{Binding CopyFeedbackText, Converter={x:Static controls:StringNotEmptyToVisibilityConverter.Instance}}" />
                                        <controls:PclHint HintType="Warning">
                                            <TextBlock Text="此方式会打开第三方网站。链接和文件是否有效、是否安全，本软件不能保证。请自行确认来源并遵守许可，风险由你承担。"
                                                       FontSize="12" Foreground="#B45309" TextWrapping="Wrap" />
                                        </controls:PclHint>
                                    </StackPanel>
                                </controls:PclCard>

                                <controls:PclCard Title="关于 PicHarbor" CanSwap="False">
                                    <StackPanel>
                                        <TextBlock Text="PicHarbor 极简手机相册本地备份与跨端管理系统" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,6" />
                                        <TextBlock Text="版本: 1.0.0 (Release) · 遵循 PCL2 设计美学规范" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,12" />
                                        <TextBlock Text="• 无损直连：支持 iPhone 与 Android 原生传输，保留 Live Photo 实况照片与 EXIF 元数据。" FontSize="12" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,4" />
                                        <TextBlock Text="• 随盘即插即用：统一主盘存储架构，跨驱动器全局防重秒传。" FontSize="12" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,4" />
                                        <TextBlock Text="• 现代画廊：融合 SweetAlbum 瀑布流画廊与毫秒级虚拟化时间线检视。" FontSize="12" Foreground="{DynamicResource ColorBrush1}" />
                                    </StackPanel>
                                </controls:PclCard>
                            </StackPanel>
                        </controls:PclPageHost>
                    </StackPanel>
                </controls:PclScrollViewer>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!--  MODAL 1: 传输文件明细弹窗 (PCL2 风格弹窗)                -->
        <!-- ======================================================== -->
        <controls:PclModalHost Grid.RowSpan="2" Panel.ZIndex="1500"
                               IsOpen="{Binding IsDetailModalOpen, Mode=OneWay}"
                               CloseCommand="{Binding CloseActiveDetailModalCommand}">
            <Border Style="{StaticResource PclDialogContainer}" Width="840" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ActiveDetailModalTitle, FallbackValue='传输文件明细清单'}"
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
                        <controls:PclIconButton Logo="{StaticResource PclIconClose}" IconTheme="Close" Command="{Binding CloseActiveDetailModalCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource ColorBrush2}" />

                    <DataGrid Grid.Row="3" ItemsSource="{Binding ActiveDetailItems}"
                              SelectedItem="{Binding SelectedDetailItem, Mode=TwoWay}"
                              Style="{StaticResource PclDataGrid}"
                              HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <ContextMenu x:Key="DetailRowContextMenu">
                                <MenuItem Header="📂 在资源管理器中显示" Click="DetailContextMenu_ShowInExplorer_Click" />
                                <MenuItem Header="↗ 在默认应用中打开" Click="DetailContextMenu_OpenExternal_Click" />
                                <MenuItem Header="📋 复制文件" Click="DetailContextMenu_CopyFile_Click" />
                                <MenuItem Header="ℹ 属性" Click="DetailContextMenu_Properties_Click" />
                            </ContextMenu>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
                                <Setter Property="Height" Value="34" />
                                <Setter Property="Cursor" Value="Hand" />
                                <EventSetter Event="MouseDoubleClick" Handler="DetailDataGridRow_MouseDoubleClick" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DetailDataGridRow_PreviewMouseRightButtonDown" />
                                <Setter Property="ContextMenu" Value="{StaticResource DetailRowContextMenu}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0EDFE" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                            <DataGridTextColumn Header="文件名" Binding="{Binding TargetPath}" Width="2*" />
                            <DataGridTextColumn Header="大小" Binding="{Binding FileSizeText}" Width="80" />
                            <DataGridTextColumn Header="详情说明" Binding="{Binding Details}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <controls:PclButton Content="关闭" Command="{Binding CloseActiveDetailModalCommand}" Width="90" Height="32" />
                    </StackPanel>
                </Grid>
            </Border>
        </controls:PclModalHost>

        <!-- ======================================================== -->
        <!--  MODAL 2: 备份范围选择弹窗 (PCL2 选项弹窗)                 -->
        <!-- ======================================================== -->
        <controls:PclModalHost Grid.RowSpan="2" Panel.ZIndex="1000"
                               IsOpen="{Binding IsScopeModalOpen}"
                               CloseCommand="{Binding CloseScopeModalCommand}">
            <Border Style="{StaticResource PclDialogContainer}" Width="600" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="配置备份范围与过滤" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
                        <controls:PclIconButton Logo="{StaticResource PclIconClose}" IconTheme="Close" Command="{Binding CloseScopeModalCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource ColorBrush2}" />

                    <ScrollViewer Grid.Row="3" MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- ==================== IPHONE SCOPE ==================== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDeviceIndex}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <controls:PclRadioBox Content="全量备份 (传输设备中全部照片与视频)" IsChecked="{Binding BackupVM.IsScopeAll, Mode=TwoWay}" Margin="0,0,0,10" />
                                <controls:PclRadioBox Content="按日期范围备份" IsChecked="{Binding BackupVM.IsScopeDateRange, Mode=TwoWay}" Margin="0,0,0,10" />
                                <Border Margin="24,0,0,12" Padding="12" Background="#F8FAFC" CornerRadius="6" BorderBrush="#D5E6FD" BorderThickness="1"
                                        Visibility="{Binding BackupVM.IsScopeDateRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="从:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                                            <DatePicker SelectedDate="{Binding BackupVM.ScopeDateFrom, Mode=TwoWay}" Width="130" Height="28" Margin="0,0,12,0" />
                                            <TextBlock Text="到:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                                            <DatePicker SelectedDate="{Binding BackupVM.ScopeDateTo, Mode=TwoWay}" Width="130" Height="28" Margin="0,0,12,0" />
                                            <controls:PclButton Content="清空" Command="{Binding BackupVM.ClearDateRangeCommand}" Height="28" Padding="10,2" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="快捷预设:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                            <controls:PclButton Content="近30天" Command="{Binding BackupVM.SetDatePresetLast30DaysCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                            <controls:PclButton Content="近90天" Command="{Binding BackupVM.SetDatePresetLast90DaysCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                            <controls:PclButton Content="近1年" Command="{Binding BackupVM.SetDatePresetLast1YearCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                            <controls:PclButton Content="今年" Command="{Binding BackupVM.SetDatePresetThisYearCommand}" Height="24" Padding="8,2" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ==================== ANDROID SCOPE & FILTERS ==================== -->
                            <StackPanel DataContext="{Binding AndroidBackupVM}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedDeviceIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- 1. 备份范围模式 -->
                                <TextBlock Text="备份范围模式" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,6" />
                                <controls:PclRadioBox Content="默认模式 (智能备份 相机胶卷 与 屏幕截图)" IsChecked="{Binding IsScopeDefault, Mode=TwoWay}" Margin="0,0,0,6" />
                                <controls:PclRadioBox Content="全量模式 (备份扫描出的全部手机相册)" IsChecked="{Binding IsScopeAll, Mode=TwoWay}" Margin="0,0,0,6" />
                                <controls:PclRadioBox Content="按日期范围备份" IsChecked="{Binding IsScopeDateRange, Mode=TwoWay}" Margin="0,0,0,6" />
                                <Border Margin="24,0,0,8" Padding="12" Background="#F8FAFC" CornerRadius="6" BorderBrush="#D5E6FD" BorderThickness="1"
                                        Visibility="{Binding IsScopeDateRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="从:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                                            <DatePicker SelectedDate="{Binding ScopeDateFrom, Mode=TwoWay}" Width="130" Height="28" Margin="0,0,12,0" />
                                            <TextBlock Text="到:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                                            <DatePicker SelectedDate="{Binding ScopeDateTo, Mode=TwoWay}" Width="130" Height="28" Margin="0,0,12,0" />
                                            <controls:PclButton Content="清空" Command="{Binding ClearDateRangeCommand}" Height="28" Padding="10,2" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="快捷预设:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                            <controls:PclButton Content="近30天" Command="{Binding SetDatePresetLast30DaysCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                            <controls:PclButton Content="近90天" Command="{Binding SetDatePresetLast90DaysCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                            <controls:PclButton Content="近1年" Command="{Binding SetDatePresetLast1YearCommand}" Height="24" Margin="0,0,6,0" Padding="8,2" />
                                            <controls:PclButton Content="今年" Command="{Binding SetDatePresetThisYearCommand}" Height="24" Padding="8,2" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <controls:PclRadioBox Content="高级模式 (自由勾选相册与自定义路径)" IsChecked="{Binding IsScopeAdvanced, Mode=TwoWay}" Margin="0,0,0,6" />

                                <Rectangle Height="1" Fill="{DynamicResource ColorBrush6}" Margin="0,2,0,8" />

                                <!-- 2. 相册选取与智能过滤 -->
                                <TextBlock Text="相册选取与智能过滤" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:PclButton Content="🔍 重新扫描相册" Command="{Binding ScanAlbumsCommand}" Height="24" Margin="0,0,8,0" Padding="8,0" />
                                        <controls:PclButton Content="全选" Command="{Binding SelectAllAlbumsCommand}" Height="24" Margin="0,0,6,0" Padding="8,0" />
                                        <controls:PclButton Content="全不选" Command="{Binding DeselectAllAlbumsCommand}" Height="24" Padding="8,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ScanStatusText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                                </Grid>

                                <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1" Padding="10,6" Margin="0,0,0,6" MaxHeight="115">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Albums}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DetailText}" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <Button Grid.Column="2" Content="✕" ToolTip="删除自定义路径"
                                                                Command="{Binding DataContext.RemoveAlbumCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Cursor="Hand" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Custom Remote Path Input -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding CustomAlbumPath, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="输入手机内部路径，如 /DCIM/100MEDIA 或 /Pictures/Snapseed" />
                                    <controls:PclButton Grid.Column="1" Content="+ 添加自定义路径" Command="{Binding AddCustomAlbumCommand}" Height="26" Padding="10,0" />
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource ColorBrush6}" Margin="0,0,0,8" />

                                <!-- 3. 导入清洗与格式过滤 -->
                                <TextBlock Text="导入清洗与格式过滤" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PclCheckBox Content="自动过滤小图与临时缓存" IsChecked="{Binding IgnoreSmallImages, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,18,0" />
                                    <controls:PclSlider Grid.Column="1" Minimum="10" Maximum="1024" Value="{Binding MinFileSizeKb, Mode=TwoWay}" VerticalAlignment="Center"
                                                        IsEnabled="{Binding IgnoreSmallImages}" />
                                    <TextBlock Grid.Column="2" Text="{Binding MinFileSizeKb, StringFormat='&lt; {0} KB'}" Foreground="{DynamicResource ColorBrushGray2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <controls:PclCheckBox Content="备份照片 (JPG, PNG, HEIC, RAW...)" IsChecked="{Binding IncludePhotos, Mode=TwoWay}" Margin="0,0,24,0" />
                                    <controls:PclCheckBox Content="备份视频 (MP4, MOV, MKV...)" IsChecked="{Binding IncludeVideos, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- 4. Dynamic Summary Sentence -->
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding ScopeSummarySentence}" FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <controls:PclButton Content="确定" Command="{Binding CloseScopeModalCommand}" Width="90" Height="32" ButtonType="Hero" />
                    </StackPanel>
                </Grid>
            </Border>
        </controls:PclModalHost>

        <!-- ======================================================== -->
        <!--  MODAL 3: iPhone 前置安全拦截弹窗                          -->
        <!-- ======================================================== -->
        <controls:PclModalHost Grid.RowSpan="2" Panel.ZIndex="1010" DataContext="{Binding IPhoneSyncVM}"
                               IsOpen="{Binding IsPreflightModalOpen}"
                               CloseCommand="{Binding CancelPreflightModalCommand}">
            <Border Style="{StaticResource PclDialogContainer}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{Binding PreflightTitle}" FontSize="17" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" />
                        <controls:PclIconButton Logo="{StaticResource PclIconClose}" IconTheme="Close" Command="{Binding CancelPreflightModalCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18" Background="#F8FAFC" Padding="12">
                        <TextBlock Text="{Binding PreflightMessage}" Foreground="{DynamicResource ColorBrush1}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <controls:PclButton Content="取消" Command="{Binding CancelPreflightModalCommand}" Height="32" Margin="0,0,8,0" Padding="14,0" />
                        <controls:PclButton Content="前往设置" Command="{Binding OpenSettingsTabCommand}" Height="32" Margin="0,0,8,0" Padding="14,0" />
                        <controls:PclButton Content="忽略风险继续" Command="{Binding IgnorePreflightAndProceedCommand}" Height="32" Margin="0,0,8,0" Padding="14,0" />
                        <controls:PclButton Content="自动修复并开始" Command="{Binding FixPreflightAndProceedCommand}" ButtonType="Hero" Height="32" Padding="16,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </controls:PclModalHost>

        <!-- ======================================================== -->
        <!--  MODAL 4: Android 前置安全拦截弹窗                         -->
        <!-- ======================================================== -->
        <controls:PclModalHost Grid.RowSpan="2" Panel.ZIndex="1010" DataContext="{Binding AndroidSyncVM}"
                               IsOpen="{Binding IsPreflightModalOpen}"
                               CloseCommand="{Binding CancelPreflightModalCommand}">
            <Border Style="{StaticResource PclDialogContainer}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{Binding PreflightTitle}" FontSize="17" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" />
                        <controls:PclIconButton Logo="{StaticResource PclIconClose}" IconTheme="Close" Command="{Binding CancelPreflightModalCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18" Background="#F8FAFC" Padding="12">
                        <TextBlock Text="{Binding PreflightMessage}" Foreground="{DynamicResource ColorBrush1}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <controls:PclButton Content="取消" Command="{Binding CancelPreflightModalCommand}" Height="32" Margin="0,0,8,0" Padding="14,0" />
                        <controls:PclButton Content="前往设置" Command="{Binding OpenSettingsTabCommand}" Height="32" Margin="0,0,8,0" Padding="14,0" />
                        <controls:PclButton Content="忽略风险继续" Command="{Binding IgnorePreflightAndProceedCommand}" Height="32" Margin="0,0,8,0" Padding="14,0" />
                        <controls:PclButton Content="自动修复并开始" Command="{Binding FixPreflightAndProceedCommand}" ButtonType="Hero" Height="32" Padding="16,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </controls:PclModalHost>

        <!-- ======================================================== -->
        <!--  MODAL 5: 统一自选待传清单编辑弹窗 (多端通用)                -->
        <!-- ======================================================== -->
        <controls:PclModalHost Grid.RowSpan="2" Panel.ZIndex="1005"
                               IsOpen="{Binding IsUnifiedManualModalOpen}"
                               CloseCommand="{Binding CloseUnifiedManualModalCommand}">
            <Border Style="{StaticResource PclDialogContainer}" Width="860" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋 自选待传文件清单" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UnifiedManualSelectionCountText}" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <Border Background="#E0EDFE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="多端同步通用清单" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <controls:PclIconButton Logo="{StaticResource PclIconClose}" IconTheme="Close" Command="{Binding CloseUnifiedManualModalCommand}" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Drop Target & List -->
                    <Grid Grid.Row="1" AllowDrop="True" Drop="UnifiedManualDropZone_Drop" DragOver="ManualDropZone_DragOver">
                        <ListView ItemsSource="{Binding UnifiedManualSelectedItems}"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <EventSetter Event="MouseDoubleClick" Handler="ManualListItem_MouseDoubleClick" />
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ModernListItem_PreviewMouseRightButtonDown" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开" Click="ManualListItem_Open_Click" />
                                                <MenuItem Header="在文件资源管理器中定位" Click="ManualListItem_Reveal_Click" />
                                                <Separator />
                                                <MenuItem Header="📌 加入/移出待传列表" Click="ManualListItem_Toggle_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="64" Height="64">
                                                <Border CornerRadius="6" Background="#E2E8F0" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="{Binding FormatUpper}" FontSize="11" FontWeight="Bold" Foreground="#64748B"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"
                                                               Visibility="{Binding IsThumbnailLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Background="#0B5BCB" CornerRadius="3" Padding="4,1" Margin="0,0,3,3">
                                                    <TextBlock Text="{Binding FormatUpper}" Foreground="White" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding DisplayCapturedAt}" FontSize="11" Foreground="#475569" />
                                                    </Border>
                                                    <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#475569" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <controls:PclButton Content="从文件管理器挑选..." Command="{Binding PickFilesForUnifiedManualCommand}" Height="30" Margin="0,0,8,0" Padding="12,0" />
                            <controls:PclButton Content="清空清单" Command="{Binding ClearUnifiedManualItemsCommand}" Height="30" Padding="12,0" />
                        </StackPanel>
                        <controls:PclButton Content="完成" Command="{Binding CloseUnifiedManualModalCommand}" Width="90" Height="30" HorizontalAlignment="Right" ButtonType="Hero" />
                    </Grid>
                </Grid>
            </Border>
        </controls:PclModalHost>

        <!-- ======================================================== -->
        <!--  MODAL 8: 设备名称自定义修改弹窗 (PCL2 风格轻量弹窗)       -->
        <!-- ======================================================== -->
        <controls:PclModalHost Grid.RowSpan="2" Panel.ZIndex="1020"
                               IsOpen="{Binding IsRenameModalOpen}"
                               CloseCommand="{Binding CloseRenameModalCommand}">
            <Border Style="{StaticResource PclDialogContainer}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="修改设备别名" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
                        <controls:PclIconButton Logo="{StaticResource PclIconClose}" IconTheme="Close" Command="{Binding CloseRenameModalCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="设置后，备份文件将在目标主盘对应子目录中归档保存：" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,10" />
                    <TextBox Text="{Binding DeviceCustomName, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="{DynamicResource ColorBrush6}" FontSize="13" Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <controls:PclButton Content="取消" Command="{Binding CloseRenameModalCommand}" Width="80" Height="30" Margin="0,0,8,0" />
                        <controls:PclButton Content="保存并应用" Command="{Binding SaveRenameModalCommand}" Width="100" Height="30" ButtonType="Hero" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </controls:PclModalHost>

        <!-- ======================================================== -->
        <!--  MODAL 9: Android 手机 FTP 连接参数配置弹窗 (PCL2 风格轻量弹窗) -->
        <!-- ======================================================== -->
        <controls:PclModalHost Grid.RowSpan="2" Panel.ZIndex="1025"
                               IsOpen="{Binding IsAndroidFtpModalOpen}"
                               CloseCommand="{Binding CloseAndroidFtpModalCommand}">
            <Border Style="{StaticResource PclDialogContainer}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <StackPanel DataContext="{Binding AndroidBackupVM}">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="📡 FTP 连接参数配置" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
                        <controls:PclIconButton Logo="{StaticResource PclIconClose}" IconTheme="Close"
                                                Command="{Binding DataContext.CloseAndroidFtpModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="在 Android 手机文件管理或 FTP 客户端开启服务，输入下方局域网连接参数。"
                               FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="手机 IP 地址:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Text="{Binding AndroidFtpHost, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />

                        <TextBlock Grid.Column="3" Text="FTP 端口:" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="4" Text="{Binding AndroidFtpPort, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="用户名 (可选):" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Text="{Binding AndroidFtpUser, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />

                        <TextBlock Grid.Column="3" Text="密码 (可选):" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="4" Text="{Binding AndroidFtpPassword, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="{DynamicResource ColorBrush6}" />
                    </Grid>

                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,14"
                               Visibility="{Binding ConnectionStatusText, Converter={x:Static controls:StringNotEmptyToVisibilityConverter.Instance}}" />

                    <Grid Margin="0,6,0,0">
                        <controls:PclButton Content="测试连接" Command="{Binding TestConnectionCommand}" Height="30" Padding="14,0" HorizontalAlignment="Left" />
                        <controls:PclButton Content="完成" Command="{Binding DataContext.CloseAndroidFtpModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Width="90" Height="30" HorizontalAlignment="Right" ButtonType="Hero" />
                    </Grid>
                </StackPanel>
            </Border>
        </controls:PclModalHost>

        <controls:PclExtraButton Grid.RowSpan="2"
                                 Logo="{StaticResource PclIconDownload}"
                                 Command="{Binding OpenTaskManagerCommand}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,24,20" Panel.ZIndex="1200"
                                 ToolTip="任务中心"
                                 Visibility="{Binding ShowTaskBall, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Task center panel anchored to the floating ball. -->
        <Grid x:Name="TaskManagerOverlay" Grid.RowSpan="2" Panel.ZIndex="1100"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Width="680" MaxHeight="460" Margin="0,0,24,84"
              Visibility="Collapsed" Opacity="0.0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TaskManagerTranslate" Y="32" />
            </Grid.RenderTransform>
            <Border Background="#F7FBFF" BorderBrush="#D5E6FD" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Color="#0B5BCB" Opacity="0.16" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0B5BCB" CornerRadius="12,12,0,0">
                        <Grid Margin="14,0,8,0">
                            <TextBlock Text="任务中心" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <controls:PclIconButton Logo="{StaticResource PclIconClose}" IconTheme="Close"
                                                    Command="{Binding CloseTaskManagerCommand}" Click="CloseTaskManager_Click"
                                                    HorizontalAlignment="Right" ToolTip="关闭任务中心" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="148" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,8">
                            <TextBlock Text="总速度" FontSize="12" FontWeight="SemiBold" Foreground="#0B5BCB" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TotalSpeedText}" FontSize="18" Foreground="#343D4A" HorizontalAlignment="Center" Margin="0,6,0,16" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="剩余文件" FontSize="12" FontWeight="SemiBold" Foreground="#0B5BCB" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TotalRemainingFilesText}" FontSize="18" Foreground="#343D4A" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8,12,4">
                            <StackPanel>
                                <TextBlock Text="当前没有进行中或未关闭的任务" Foreground="#64748B" FontSize="12" Margin="4,12,4,8"
                                           Visibility="{Binding HasVisibleTaskCard, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <ItemsControl ItemsSource="{Binding TaskCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TransferTaskCardViewModel}">
                                            <Border Background="White" BorderBrush="#D5E6FD" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                                    Visibility="{Binding IsShown, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#343D4A" FontSize="13" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StateText}" Foreground="#64748B" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="停止" Command="{Binding StopCommand}"
                                                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Background="Transparent" BorderThickness="0" Foreground="#EF4444" Cursor="Hand" FontSize="12" Padding="6,2" />
                                                            <Button Content="关闭" Command="{Binding DismissCommand}"
                                                                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                                    Background="Transparent" BorderThickness="0" Foreground="#64748B" Cursor="Hand" FontSize="12" Padding="6,2" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,8,0,6" Foreground="#0B5BCB" Background="#E2E8F0" BorderThickness="0" />
                                                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#343D4A" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SpeedText}" FontSize="11" Foreground="#0B5BCB" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding ResultText}" FontSize="11" Foreground="#475569" Margin="0,4,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                                Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button Content="已复制明细" Command="{Binding ShowCopiedCommand}" Margin="0,0,8,0"
                                                                Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Foreground="#166534" Cursor="Hand" FontSize="11" Padding="8,3" />
                                                        <Button Content="已跳过明细" Command="{Binding ShowSkippedCommand}" Margin="0,0,8,0"
                                                                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#475569" Cursor="Hand" FontSize="11" Padding="8,3" />
                                                        <Button Content="失败明细" Command="{Binding ShowFailedCommand}"
                                                                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Foreground="#991B1B" Cursor="Hand" FontSize="11" Padding="8,3" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
