<Window x:Class="PicHarbor.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PicHarbor.Gui.ViewModels"
        Title="PicHarbor" 
        Height="680" Width="1020"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource PclCanvasGradientBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" 
                      ResizeBorderThickness="6" 
                      CornerRadius="8" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Navigation Bar (PCL2 Blue Title Bar) -->
            <RowDefinition Height="44" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!--  TOP BAR (PCL2 Authentic Blue Header)                    -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="{StaticResource PclTopBarGradientBrush}" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <!-- Brand Title -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center Capsule Nav Tabs -->
                    <ColumnDefinition Width="*" />
                    <!-- Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PicHarbor" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center Capsule Nav Tabs (PCL2 White Pill Style) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton Content="▷ 备份" 
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=0}"
                                 Style="{StaticResource PclTopCapsuleTab}" Click="NavButton_Click" Tag="0" />
                    <RadioButton Content="⤓ 图库" 
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=1}"
                                 Style="{StaticResource PclTopCapsuleTab}" Click="NavButton_Click" Tag="1" />
                    <RadioButton Content="☁ 云同步" 
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=2}"
                                 Style="{StaticResource PclTopCapsuleTab}" Click="NavButton_Click" Tag="2" />
                    <RadioButton Content="⚙ 设置" 
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=3}"
                                 Style="{StaticResource PclTopCapsuleTab}" Click="NavButton_Click" Tag="3" />
                </StackPanel>

                <!-- Window Minimize & Close Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource PclWindowControlBtn}" Click="MinimizeButton_Click" ToolTip="最小化" />
                    <Button Content="✕" Style="{StaticResource PclCloseControlBtn}" Click="CloseButton_Click" ToolTip="关闭" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!--  MAIN BODY AREA (Two-Pane Layout)                        -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">

            <!-- ==================================================== -->
            <!--  PAGE 0: 【▷ 备份 (Backup)】(复刻图 1 启动页)          -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left Hero Pane (White, 280px) -->
                    <ColumnDefinition Width="280" />
                    <!-- Right Canvas (Light Blue Gradient) -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT HERO PANE -->
                <Border Grid.Column="0" Background="{StaticResource PclSidebarBgBrush}" BorderBrush="{StaticResource PclCardBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Top: Segmented Tabs [📱 iPhone] [🤖 Android] -->
                            <RowDefinition Height="Auto" />
                            <!-- Center: Device Hero Avatar & Name -->
                            <RowDefinition Height="*" />
                            <!-- Bottom: Hero Button & Actions -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Segmented Tabs (对应图 1 [✔ 正版] [🔗 离线]) -->
                        <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="16" Padding="3" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="📱 iPhone" IsChecked="True" Style="{StaticResource PclSegmentedTab}" Margin="0,0,4,0" />
                                <RadioButton Content="🤖 Android" Style="{StaticResource PclSegmentedTab}" />
                            </StackPanel>
                        </Border>

                        <!-- Center Hero Avatar & Status (对应图 1 像素头像与昵称) -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                            <!-- Device Icon Graphic -->
                            <Border Width="72" Height="100" CornerRadius="16" Background="#F8FAFC" BorderBrush="{StaticResource PclPrimaryBrush}" BorderThickness="2" Margin="0,0,0,14">
                                <Grid>
                                    <!-- Dynamic Island Pill -->
                                    <Border Width="24" Height="6" CornerRadius="3" Background="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />
                                    <!-- Screen Content / Icon -->
                                    <TextBlock Text="📱" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- Home Indicator Bar -->
                                    <Border Width="30" Height="3" CornerRadius="1.5" Background="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                </Grid>
                            </Border>

                            <!-- Device Model Text -->
                            <TextBlock Text="iPhone 15 Plus" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" HorizontalAlignment="Center" />

                            <!-- Status Pill (● 已就绪) -->
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource PclAccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="手机已就绪 · 保持解锁" FontSize="11" FontWeight="Medium" Foreground="#065F46" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Bottom: PCL2 Hero Action Button (对应图 1 启动游戏大按钮) -->
                        <StackPanel Grid.Row="2" Margin="16,0,16,20">
                            <Button Style="{StaticResource PclHeroButton}" Margin="0,0,0,10" Height="64">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="开始增量备份" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PclPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="目标: E:\Pictures\PicHarbor\15Plus" FontSize="11" Foreground="{StaticResource PclTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Button>

                            <!-- Two Secondary Buttons (对应图 1 [版本选择] [版本设置]) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="备份范围" Style="{StaticResource PclSecondaryButton}" />
                                <Button Grid.Column="2" Content="传输日志" Style="{StaticResource PclSecondaryButton}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RIGHT CANVAS (PCL2 Light Blue Canvas) -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <StackPanel>
                        <!-- Overview Card 1: 存储主盘与图库健康度 -->
                        <Border Style="{StaticResource PclCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📦 图库存储主盘概览" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" />
                                        <TextBlock Text="极简统一存储架构，随盘即插即用 · E:\Pictures\PicHarbor" FontSize="12" Foreground="{StaticResource PclTextSecondaryBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开主文件夹" Style="{StaticResource PclSecondaryButton}" />
                                </Grid>

                                <!-- Three Metrics Pills -->
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 1 -->
                                    <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="已归档媒体" FontSize="11" Foreground="{StaticResource PclTextSecondaryBrush}" />
                                            <TextBlock Text="5,809 张" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PclPrimaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Col 2 -->
                                    <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="图库总大小" FontSize="11" Foreground="{StaticResource PclTextSecondaryBrush}" />
                                            <TextBlock Text="20.2 GB" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PclPrimaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Col 3 -->
                                    <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="磁盘可用空间" FontSize="11" Foreground="{StaticResource PclTextSecondaryBrush}" />
                                            <TextBlock Text="380 GB 充足" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PclAccentGreenBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Cross-volume deduplication banner -->
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                                    <TextBlock Text="🛡️ 已自动索引就绪驱动器上的其他图库历史，跨盘增量防重已自动就绪，绝不重复下载。" FontSize="11" Foreground="{StaticResource PclPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Accordion Card 1: 备份范围与相册选择 (对应图 2 手风琴折叠卡片) -->
                        <Expander Style="{StaticResource PclAccordionCard}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 备份范围与相册" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" />
                                    <TextBlock Text="(当前: 自动全量媒体库)" FontSize="12" Foreground="{StaticResource PclTextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <RadioButton Content="全量相册备份 (推荐，完整归档所有拍摄照片与视频)" IsChecked="True" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,8" />
                                <RadioButton Content="按拍摄月份筛选 (按日期范围补齐备份)" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,8" />
                                <RadioButton Content="手动勾选相册 (自选 DCIM, Pictures, Screenshots 等相册)" Foreground="{StaticResource PclTextPrimaryBrush}" />
                            </StackPanel>
                        </Expander>

                        <!-- Accordion Card 2: 整理规则与高级过滤 (对应图 2 手风琴折叠卡片) -->
                        <Expander Style="{StaticResource PclAccordionCard}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️ 整理规范与文件过滤" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" />
                                    <TextBlock Text="(当前: 存入 15Plus · 过滤 &lt;100KB 缩略图)" FontSize="12" Foreground="{StaticResource PclTextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <CheckBox Content="忽略小于 100KB 的小缩略图与临时表情" IsChecked="True" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="实况照片 (HEIC + MOV) 自动绑定传输" IsChecked="True" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="自动将 EXIF 拍摄时间写入本地文件创建时间" IsChecked="True" Foreground="{StaticResource PclTextPrimaryBrush}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================================================== -->
            <!--  PAGE 1: 【⤓ 图库 (Library)】(复刻图 2 下载列表页)    -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left Sub-Nav Pane (220px, 对应图 2 左侧的原版游戏/Mod) -->
                    <ColumnDefinition Width="220" />
                    <!-- Right Content Canvas -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SUB-NAV PANE -->
                <Border Grid.Column="0" Background="{StaticResource PclSidebarBgBrush}" BorderBrush="{StaticResource PclCardBorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="图库视图" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PclTextMutedBrush}" Margin="18,8,0,6" />
                        <RadioButton Content="🖼️ 全部照片与视频" IsChecked="True" Style="{StaticResource PclSubNavItem}" />
                        <RadioButton Content="🎬 视频与实况" Style="{StaticResource PclSubNavItem}" />
                        <RadioButton Content="📸 相机与设备" Style="{StaticResource PclSubNavItem}" />
                        <RadioButton Content="📱 iPhone (15Plus)" Style="{StaticResource PclSubNavItem}" />
                        <RadioButton Content="🤖 Android (K40)" Style="{StaticResource PclSubNavItem}" />
                        <RadioButton Content="⭐ 自选导出清单" Style="{StaticResource PclSubNavItem}" />
                    </StackPanel>
                </Border>

                <!-- RIGHT CONTENT CANVAS -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <StackPanel>
                        <!-- Top Card: 最新归档 (对应图 2 的“最新版本”卡片) -->
                        <Border Style="{StaticResource PclCard}">
                            <StackPanel>
                                <TextBlock Text="最新归档媒体" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📅" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="2026年10月 (最近一次备份)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" />
                                        <TextBlock Text="最新归档于 2026/10/09 · 48 张照片与视频 (包含 K40 胶片照片与 iPhone HEIC)" FontSize="11" Foreground="{StaticResource PclTextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="浏览此月份" Style="{StaticResource PclSecondaryButton}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Accordion Cards (对应图 2 的 正式版/预览版/远古版 手风琴卡片) -->
                        <Expander Style="{StaticResource PclAccordionCard}" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="2026 年度归档 (1,240 张照片 · 4.8 GB)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" />
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="↳ 包含 2026-10、2026-09、2026-08 等月份子目录，可随时在画廊中检视与原画质预览。" FontSize="12" Foreground="{StaticResource PclTextSecondaryBrush}" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource PclAccordionCard}">
                            <Expander.Header>
                                <TextBlock Text="2025 年度归档 (3,120 张照片 · 10.6 GB)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" />
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="↳ 包含 2025-12 至 2025-01 完整媒体记录。" FontSize="12" Foreground="{StaticResource PclTextSecondaryBrush}" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource PclAccordionCard}">
                            <Expander.Header>
                                <TextBlock Text="2024 年度归档 (1,449 张照片 · 4.8 GB)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" />
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="↳ 包含 2024 年度历史备份归档。" FontSize="12" Foreground="{StaticResource PclTextSecondaryBrush}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================================================== -->
            <!--  PAGE 2: 【☁ 云同步 (Cloud Sync)】                  -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sub-Nav -->
                <Border Grid.Column="0" Background="{StaticResource PclSidebarBgBrush}" BorderBrush="{StaticResource PclCardBorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="云端服务" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PclTextMutedBrush}" Margin="18,8,0,6" />
                        <RadioButton Content="☁️ Google 相册" IsChecked="True" Style="{StaticResource PclSubNavItem}" />
                        <RadioButton Content="⚙️ 同步规则" Style="{StaticResource PclSubNavItem}" />
                        <RadioButton Content="📋 上传记录" Style="{StaticResource PclSubNavItem}" />
                    </StackPanel>
                </Border>

                <!-- Right Canvas -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <StackPanel>
                        <!-- Card 1: 账号与代理 -->
                        <Border Style="{StaticResource PclCard}">
                            <StackPanel>
                                <TextBlock Text="Google 相册授权与连接" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="已授权账号" Foreground="{StaticResource PclTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="suyu041219@gmail.com (已登录)" FontWeight="SemiBold" Foreground="{StaticResource PclPrimaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="网络代理通道" Foreground="{StaticResource PclTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="127.0.0.1:7890 · 延迟 120ms (连通就绪)" FontWeight="SemiBold" Foreground="{StaticResource PclAccentGreenBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: 上传策略 -->
                        <Border Style="{StaticResource PclCard}">
                            <StackPanel>
                                <TextBlock Text="上传归档范围与相册策略" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,12" />
                                <RadioButton Content="全量同步 (将本地 5,809 张照片增量上传至 Google 相册)" IsChecked="True" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,8" />
                                <RadioButton Content="自选清单同步 (仅上传在图库中挑选标记的照片)" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="自动根据年月建立 Google 相册 (如 2026-10)" IsChecked="True" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Action Button -->
                        <Button Style="{StaticResource PclHeroButton}" Height="54">
                            <TextBlock Text="🚀 开始同步到 Google 相册" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PclPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================================================== -->
            <!--  PAGE 3: 【⚙ 设置 (Settings)】(复刻图 3 选项页)        -->
            <!-- ==================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left Sub-Nav Pane (220px, 对应图 3 左侧的启动/个性化/其他) -->
                    <ColumnDefinition Width="220" />
                    <!-- Right Content Canvas -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SUB-NAV PANE -->
                <Border Grid.Column="0" Background="{StaticResource PclSidebarBgBrush}" BorderBrush="{StaticResource PclCardBorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="设置分栏" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PclTextMutedBrush}" Margin="18,8,0,6" />
                        <RadioButton Content="📦 存储与主盘符" IsChecked="True" Style="{StaticResource PclSubNavItem}" />
                        <RadioButton Content="📲 备份偏好与规则" Style="{StaticResource PclSubNavItem}" />
                        <RadioButton Content="🌐 界面与语言" Style="{StaticResource PclSubNavItem}" />
                    </StackPanel>
                </Border>

                <!-- RIGHT CONTENT CANVAS (纯白大圆角卡片，复刻图 3 启动选项与内存分配) -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <StackPanel>
                        <!-- Card 1: 存储与主盘符 (对应图 3 的“启动选项”大卡片) -->
                        <Border Style="{StaticResource PclCard}">
                            <StackPanel>
                                <TextBlock Text="存储主盘与架构规范" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,14" />

                                <!-- Row 1: 主盘符 -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前主备份盘" Foreground="{StaticResource PclTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource PclComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="E: 盘 (Pictures\PicHarbor · 剩余 380 GB)" />
                                        <ComboBoxItem Content="C: 盘 (Users\Pictures\PicHarbor)" />
                                    </ComboBox>
                                </Grid>

                                <!-- Row 2: 手机分类目录规则 -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="设备子目录规则" Foreground="{StaticResource PclTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource PclComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="按手机型号自动分类 (如 15Plus, K40)" />
                                        <ComboBoxItem Content="平铺直接归档至主根目录" />
                                    </ComboBox>
                                </Grid>

                                <!-- Row 3: 时间组织方案 -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="照片时间分类格式" Foreground="{StaticResource PclTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource PclComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="按月份 (YYYY-MM，如 2026-10)" />
                                        <ComboBoxItem Content="按年月 (YYYY\YYYY-MM)" />
                                        <ComboBoxItem Content="按年份 (YYYY)" />
                                    </ComboBox>
                                </Grid>

                                <!-- Row 4: 跨盘防重提示 -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="跨驱动器查重" Foreground="{StaticResource PclTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="已检测到驱动器历史库，跨盘防重自动生效" Foreground="{StaticResource PclAccentGreenBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: 备份优化与高级参数 (对应图 3 的“内存分配”大卡片) -->
                        <Border Style="{StaticResource PclCard}">
                            <StackPanel>
                                <TextBlock Text="高级传输与属性校准" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,14" />

                                <!-- RadioButtons: 过滤策略 -->
                                <RadioButton Content="全量备份所有媒体文件" IsChecked="True" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,8" />
                                <RadioButton Content="自动过滤小于 100KB 的小缩略图与表情包" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,12" />

                                <!-- CheckBoxes -->
                                <CheckBox Content="EXIF 拍摄时间自动校准至文件创建时间" IsChecked="True" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="实况照片 (HEIC + MOV) 自动绑定成对传输" IsChecked="True" Foreground="{StaticResource PclTextPrimaryBrush}" Margin="0,0,0,12" />

                                <!-- Slider: 超时阈值 (对应图 3 的滑块) -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="设备读取超时阈值" Foreground="{StaticResource PclTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="10" Maximum="120" Value="30" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="30 秒" Foreground="{StaticResource PclTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Hidden legacy preview player elements to preserve code-behind during UI shell phase -->
        <Grid Visibility="Collapsed">
            <MediaElement x:Name="PreviewPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          MediaOpened="PreviewPlayer_MediaOpened"
                          MediaFailed="PreviewPlayer_MediaFailed"
                          MediaEnded="PreviewPlayer_MediaEnded"
                          MouseLeftButtonDown="PreviewPlayer_MouseLeftButtonDown" />
            <Slider x:Name="PreviewSeek"
                    PreviewMouseDown="PreviewSeek_PreviewMouseDown"
                    PreviewMouseUp="PreviewSeek_PreviewMouseUp"
                    ValueChanged="PreviewSeek_ValueChanged" />
            <TextBlock x:Name="PreviewClockText" />
        </Grid>
    </Grid>
</Window>
