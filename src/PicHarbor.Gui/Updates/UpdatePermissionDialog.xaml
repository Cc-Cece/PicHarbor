<Window x:Class="PicHarbor.Gui.Updates.UpdatePermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PicHarbor.Gui.Controls"
        Title="{DynamicResource UpdatePermissionTitle}" Width="490" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White">
    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource UpdatePermissionTitle}" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,14"/>
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <controls:PclCheckBox x:Name="Skip" Content="{DynamicResource UpdateSkipVersion}" Margin="0,0,0,10"/>
        <controls:PclCheckBox x:Name="DisableAuto" Content="{DynamicResource UpdateDisableAuto}" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <controls:PclButton Content="{DynamicResource UpdateConfirm}" Click="Confirm_Click" Margin="0,0,10,0" Padding="20,0" Height="30"/>
            <controls:PclButton Content="{DynamicResource UpdateCancel}" Click="Cancel_Click" Padding="20,0" Height="30"/>
        </StackPanel>
    </StackPanel>
</Window>
