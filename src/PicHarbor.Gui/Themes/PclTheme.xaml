    <!-- ======================================================== -->
    <!--  1. PclButton Style (PCL2 MyButton)                      -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclButton}">
                    <Border x:Name="PART_Border"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{DynamicResource ColorBrushHalfWhite}"
                            BorderBrush="{DynamicResource ColorBrush6}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{Binding BorderBrush, ElementName=PART_Border}" />
                            <TextBlock Grid.Row="1" x:Name="PART_Subtitle"
                                       Text="{TemplateBinding Subtitle}"
                                       FontSize="11" FontWeight="Normal"
                                       Foreground="{DynamicResource ColorBrushGray2}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- PCL2 Launch Hero Action Button -->
                        <Trigger Property="ButtonType" Value="Hero">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="ButtonType" Value="Highlight">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
                            <Setter TargetName="PART_Subtitle" Property="Foreground" Value="{DynamicResource ColorBrushGray4}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  2. PclIconButton Style (PCL2 MyIconButton)              -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclIconButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclIconButton}">
                    <Border x:Name="PART_Border" CornerRadius="14" Background="Transparent">
                        <Path Stretch="Uniform" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{TemplateBinding Logo}"
                              Fill="{TemplateBinding Foreground}">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="{Binding LogoScale, RelativeSource={RelativeSource TemplatedParent}}"
                                                ScaleY="{Binding LogoScale, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  3. PclRadioButton Style (PCL2 Top Pill Capsule Tab)     -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclRadioButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="MaxHeight" Value="27" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclRadioButton}">
                    <Border x:Name="PART_Border" CornerRadius="13.5" Padding="14,0" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="ShapeLogo" Stretch="Uniform" Margin="0,0,6,0" MaxHeight="14" MaxWidth="14"
                                  VerticalAlignment="Center" Data="{TemplateBinding Logo}"
                                  Fill="{TemplateBinding Foreground}"
                                  Visibility="{Binding Logo, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}" />
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  4. PclCard Style (PCL2 MyCard)                          -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclCard}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclCard}">
                    <Border x:Name="PART_CardBorder"
                            Background="#F8FFFFFF"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{DynamicResource ColorBrush6}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border x:Name="PART_HeaderBorder" Grid.Row="0" Background="Transparent"
                                    Cursor="{Binding CanSwap, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToHandCursorConverter}}"
                                    Padding="16,13,16,10">
                                <Grid>
                                    <TextBlock Text="{TemplateBinding Title}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               VerticalAlignment="Center" />
                                    <!-- Chevron Arrow -->
                                    <Path x:Name="PART_Chevron" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Stretch="Uniform" Width="10" Height="6"
                                          Data="M2,4 l-2,2 10,10 10,-10 -2,-2 -8,8 -8,-8 z"
                                          Fill="{DynamicResource ColorBrush1}"
                                          Visibility="{Binding CanSwap, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <!-- Content -->
                            <Border x:Name="PART_ContentContainer" Grid.Row="1" Padding="16,0,16,16">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  5. PclListItem Style (PCL2 Left Sub-Navigation / List)  -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclListItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclListItem}">
                    <Grid Background="Transparent">
                        <!-- Hover Pill -->
                        <Border x:Name="PART_HoverPill"
                                CornerRadius="5"
                                Background="{DynamicResource ColorBrush7}"
                                BorderBrush="{DynamicResource ColorBrush6}"
                                BorderThickness="1" />

                        <!-- Indicator Bar -->
                        <Border x:Name="PART_Indicator"
                                Width="3.5"
                                CornerRadius="1.75"
                                Background="{DynamicResource ColorBrush2}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="2,0,0,0" />

                        <Grid VerticalAlignment="Center" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Vector Logo (PCL2 Authentic Monochrome) -->
                            <Path Grid.Column="0"
                                  Stretch="Uniform"
                                  Width="15" Height="15"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Data="{TemplateBinding Logo}"
                                  Fill="{TemplateBinding Foreground}"
                                  Visibility="{Binding Logo, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding LogoScale, RelativeSource={RelativeSource TemplatedParent}}"
                                                    ScaleY="{Binding LogoScale, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Path.RenderTransform>
                            </Path>

                            <!-- String Icon fallback if Logo is null -->
                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Icon}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  6. PclCheckBox Style (PCL2 MyCheckBox)                  -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclCheckBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclCheckBox}">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="PART_BoxBorder"
                                Width="18" Height="18"
                                CornerRadius="3"
                                BorderThickness="1.2"
                                BorderBrush="{DynamicResource ColorBrush1}"
                                Background="{DynamicResource ColorBrushHalfWhite}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />

                        <Path x:Name="PART_CheckMark"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="3,0,0,0"
                              Width="12" Height="12"
                              Fill="{DynamicResource ColorBrush2}"
                              Data="M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z" />

                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  7. PclRadioBox Style (PCL2 MyRadioBox)                  -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclRadioBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclRadioBox}">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="PART_Border"
                                 Width="18" Height="18"
                                 StrokeThickness="1.2"
                                 Stroke="{DynamicResource ColorBrush1}"
                                 Fill="{DynamicResource ColorBrushHalfWhite}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" />

                        <Ellipse x:Name="PART_Dot"
                                 Width="0" Height="0"
                                 Fill="{DynamicResource ColorBrush2}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Grid.Column="0" />

                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  8. PclComboBox & Items Style (PCL2 MyComboBox)          -->
    <!-- ======================================================== -->
    <Style x:Key="PclToggleArrow" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="path" Width="9" Height="6" Stretch="Uniform"
                              HorizontalAlignment="Right" Margin="0,0,10,0"
                              Data="M1,1L4.5,4.5L8,1"
                              StrokeThickness="1.5"
                              Stroke="{TemplateBinding Foreground}"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="path" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColorBrush7}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColorBrush7}" />
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:PclComboBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Border"
                                SnapsToDevicePixels="True"
                                Background="{DynamicResource ColorBrushHalfWhite}"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ColorBrushBg0}" />

                        <ToggleButton Style="{StaticResource PclToggleArrow}"
                                      Foreground="{DynamicResource ColorBrush1}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" />

                        <ContentPresenter Margin="10,0,26,0"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom" PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    Background="White"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ColorBrush6}"
                                    Padding="2"
                                    Margin="0,2,4,4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.12" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="260" SnapsToDevicePixels="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  9. PclTextBox Style (PCL2 MyTextBox)                    -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclTextBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclTextBox}">
                    <Grid>
                        <Border x:Name="PART_Border"
                                Background="{DynamicResource ColorBrushHalfWhite}"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ColorBrushBg0}" />

                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center" />

                        <TextBlock Text="{TemplateBinding HintText}"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  10. PclSearchBox Style (PCL2 MySearchBox)               -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclSearchBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="40" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclSearchBox}">
                    <Border x:Name="PART_Border"
                            Background="#F8FFFFFF"
                            CornerRadius="5"
                            BorderBrush="{DynamicResource ColorBrush6}"
                            BorderThickness="1"
                            Height="{TemplateBinding Height}">
                        <Grid>
                            <!-- Search Icon -->
                            <Path Width="14" Height="14" Margin="14,0,0,0"
                                  IsHitTestVisible="False"
                                  Fill="{DynamicResource ColorBrushGray3}"
                                  Stretch="Uniform"
                                  Data="{StaticResource PclIconSearch}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />

                            <!-- Borderless Text Input -->
                            <TextBox x:Name="PART_Input"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource ColorBrush1}"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Padding="38,0,38,0" />

                            <!-- Hint Text -->
                            <TextBlock Text="{TemplateBinding HintText}"
                                       Foreground="{DynamicResource ColorBrushGray4}"
                                       Margin="38,0,0,0"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Clear Button -->
                            <controls:PclIconButton x:Name="PART_ClearButton"
                                                    Width="24" Height="24"
                                                    LogoScale="0.65"
                                                    Logo="{StaticResource PclIconClose}"
                                                    Foreground="{DynamicResource ColorBrushGray3}"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,10,0"
                                                    Opacity="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  11. PclSlider Style (PCL2 MySlider)                     -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclSlider}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclSlider}">
                    <Grid VerticalAlignment="Center" Height="24">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="{DynamicResource ColorBrush3}" Height="2.5" CornerRadius="1.25" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="{DynamicResource ColorBrush6}" Height="1.5" CornerRadius="1" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Grid Width="16" Height="16">
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{DynamicResource ColorBrushBg0}"
                                                         Stroke="{DynamicResource ColorBrush3}"
                                                         StrokeThickness="1.5"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  12. PclHint Style (PCL2 MyHint)                         -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclHint}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclHint}">
                    <Border x:Name="PART_Border"
                            BorderThickness="3,0,0,0"
                            CornerRadius="2"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center" />

                            <controls:PclIconButton x:Name="PART_CloseButton"
                                                    Grid.Column="1"
                                                    Width="20" Height="20"
                                                    LogoScale="0.6"
                                                    Logo="{StaticResource PclIconClose}"
                                                    Foreground="{DynamicResource ColorBrushGray3}"
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding CanClose, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  13. PclExtraButton Style (PCL2 MyExtraButton)           -->
    <!-- ======================================================== -->
    <Style TargetType="{x:Type controls:PclExtraButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PclExtraButton}">
                    <Grid x:Name="PART_Root" Width="40" Height="40">
                        <!-- Glowing Blue Circle -->
                        <Border CornerRadius="20" Background="{DynamicResource ColorBrush3}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#0B5BCB" Opacity="0.3" />
                            </Border.Effect>
                        </Border>

                        <!-- Center White Icon -->
                        <Path Stretch="Uniform" Margin="11"
                              Fill="White"
                              Data="{TemplateBinding Logo}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  14. PclSegmentedTab Style (PCL2 [✔ 正版] [🔗 离线] 切换)   -->
    <!-- ======================================================== -->
    <Style x:Key="PclSegmentedTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="SegBorder" Background="Transparent" CornerRadius="13" Padding="14,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegBorder" Property="Background" Value="White" />
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
                            <Setter TargetName="SegBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.08" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  15. PclDataGrid Style (PCL2 Clean Table)                 -->
    <!-- ======================================================== -->
    <Style x:Key="PclDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray2}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush6}" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ColorBrush8}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E0EDFE" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== -->
    <!--  16. PclDialogContainer Style (PCL2 MyMsg Box Window)      -->
    <!-- ======================================================== -->
    <Style x:Key="PclDialogContainer" TargetType="Border">
        <Setter Property="Background" Value="#FAFCFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush6}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.25" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
