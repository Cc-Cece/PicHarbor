    <controls:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <controls:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    <controls:BoolToHandCursorConverter x:Key="BoolToHandCursorConverter" />

