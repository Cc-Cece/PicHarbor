<Window x:Class="PicHarbor.Gui.GoogleLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:PicHarbor.Gui.Controls"
        Title="Google 账号授权与登录"
        Width="680" Height="800"
        MinWidth="540" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource ColorBrushCanvasGradient}"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Title Bar (PCL2 Title Gradient, Height 46) -->
            <RowDefinition Height="46" />
            <!-- Hint / Subheader Banner -->
            <RowDefinition Height="Auto" />
            <!-- WebView2 Main Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Action & Status Bar -->
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource ColorBrushTitleGradient}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource PclIconCloud}" Fill="White" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Text="Google 账号授权登录" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Actions: Refresh & Clear Cookies -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:PclButton x:Name="RefreshBtn" Content="🔄 刷新页面" Click="RefreshBtn_Click" Height="28" Padding="10,0" Margin="0,0,8,0" />
                    <controls:PclButton x:Name="ClearCookiesBtn" Content="🧹 清理 Cookie" Click="ClearCookiesBtn_Click" Height="28" Padding="10,0" />
                </StackPanel>

                <!-- Window Minimize and Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:PclIconButton Logo="{StaticResource PclIconMinimize}" IconTheme="White" Click="MinimizeBtn_Click" ToolTip="最小化" Margin="0,0,4,0" />
                    <controls:PclIconButton Logo="{StaticResource PclIconClose}" IconTheme="Close" Click="CloseBtn_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hint / Notice Banner -->
        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="True">
                <controls:PclHint HintType="Info">
                    <TextBlock Text="请在下方官方页面登录。PicHarbor 仅在本地获取授权 Token，绝不上传您的密码与个人凭证。" FontSize="11.5" Foreground="#1E40AF" />
                </controls:PclHint>
            </DockPanel>
        </Border>

        <!-- WebView2 Area -->
        <Grid Grid.Row="2" Margin="12,10,12,6">
            <Border Background="White" CornerRadius="8" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="LoginWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <!-- Loading / Capturing Overlay -->
                    <Border x:Name="LoadingOverlay" Background="#FAFCFF" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,14" Foreground="{DynamicResource ColorBrush3}" Background="#E2E8F0" BorderThickness="0" />
                            <TextBlock x:Name="LoadingText" Text="正在载入 Google 登录界面..." Foreground="{DynamicResource ColorBrushGray2}" HorizontalAlignment="Center" FontSize="12.5" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="3" Background="{DynamicResource ColorBrushBackgroundTransparentSidebar}" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusTextBlock" Text="等待用户登录完成..." Foreground="{DynamicResource ColorBrushGray2}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <controls:PclButton Content="取消并返回" Width="100" Height="30" Click="CancelBtn_Click" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
