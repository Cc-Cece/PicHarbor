<Window x:Class="PicHarbor.Gui.AndroidPairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PicHarbor.Gui.Controls"
        Title="{DynamicResource PairTitle}"
        Width="600" Height="470"
        MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      CornerRadius="10"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Margin="14">
        <Border x:Name="RootBorder"
                Background="#FFFFFF"
                CornerRadius="10"
                BorderBrush="{DynamicResource ColorBrush6}"
                BorderThickness="1"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="RootScaleTransform" ScaleX="0.92" ScaleY="0.92" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.22" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

                <!-- 1. 自绘标题栏 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ColorBrushTitleGradient}"
                        CornerRadius="9,9,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔗" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource PairTitle}" FontSize="14" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:PclIconButton Grid.Column="1" Click="CloseButton_Click"
                                                Logo="{StaticResource PclIconClose}"
                                                IconTheme="Close"
                                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </Grid>
                </Border>

                <!-- 2. 概要：目标设备 + 使用标识 -->
                <Border Grid.Row="1" Background="#F8FAFC"
                        BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="0,0,0,1"
                        Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource PairTargetDevice}" FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,12,4" />
                        <TextBlock Grid.Column="1" x:Name="TargetDeviceText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="1" Text="{DynamicResource PairUseIdentity}" FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TargetIdentityText" FontSize="13"
                                   FontFamily="Consolas" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush2}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- 3. 步骤列表 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,14,20,4">
                    <StackPanel>
                        <ItemsControl x:Name="StepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding LabelBrush}" VerticalAlignment="Top" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12"
                                                   Foreground="{Binding DetailBrush}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="ResultText" FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. 底部按钮 -->
                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="{DynamicResource ColorBrush6}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,9,9">
                    <Grid Margin="20,0">
                        <TextBlock x:Name="HintText" Text="{DynamicResource PairHint}" FontSize="11"
                                   Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <controls:PclButton x:Name="CloseButton" Content="{DynamicResource CloseBtn}"
                                                Width="88" Height="30" Click="CloseButton_Click" />
                            <controls:PclButton x:Name="StartButton" Content="{DynamicResource PairStart}"
                                                Width="110" Height="30" Margin="8,0,0,0"
                                                ButtonType="Hero" Click="StartButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
