<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PicHarbor.Core</RootNamespace>
    <!-- Task 14b: public API carries XML doc comments for future maintainers. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Required by the [LibraryImport] source generator for the GetSystemPowerStatus P/Invoke (R14). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="iMobileDevice-net" Version="1.3.17" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <!-- Override Microsoft.Data.Sqlite's transitive SQLitePCLRaw bundle (which pins the native
         e_sqlite3 2.1.11) up to 3.0.3 → bundles SQLite 3.50.3, which fixes CVE-2025-6965
         (GHSA-2m69-gcr7-jv3q, aggregate-terms memory corruption in SQLite < 3.50.2). The native
         lib package is outside the advisory's affected range (<= 2.1.11), clearing NU1903. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit-test project exercises internal helpers (e.g. the read-stall watchdog). -->
    <InternalsVisibleTo Include="PicHarbor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="GooglePhotos\gpmc_bundle.zip" LogicalName="gpmc_bundle.zip" />
  </ItemGroup>

</Project>
