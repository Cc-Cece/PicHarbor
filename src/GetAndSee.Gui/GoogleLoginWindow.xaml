<Window x:Class="GetAndSee.Gui.GoogleLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource GoogleLoginWindowTitle}"
        Width="640" Height="780"
        MinWidth="520" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}" Padding="16,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshBtn" Content="{DynamicResource GoogleLoginWindowRefresh}" Margin="0,0,8,0" Click="RefreshBtn_Click" Style="{DynamicResource SecondaryButton}"/>
                    <Button x:Name="ClearCookiesBtn" Content="{DynamicResource GoogleLoginWindowClearCookies}" ToolTip="{DynamicResource GoogleLoginWindowClearCookiesTip}" Click="ClearCookiesBtn_Click" Style="{DynamicResource SecondaryButton}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource GoogleLoginWindowHeader}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource GoogleLoginWindowSubHeader}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- WebView2 Area -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="LoginWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Loading / Capturing Overlay -->
            <Border x:Name="LoadingOverlay" Background="{DynamicResource WindowBgBrush}" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock x:Name="LoadingText" Text="{DynamicResource GoogleLoginWindowLoading}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBgBrush}" Padding="16,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{DynamicResource GoogleLoginWindowCancel}" Width="80" Height="32" Click="CancelBtn_Click" Style="{DynamicResource SecondaryButton}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock" Text="{DynamicResource GoogleLoginWindowWaiting}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
