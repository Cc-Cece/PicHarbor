<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Application Title & General -->
    <sys:String x:Key="AppTitle">GetAndSee - GUI</sys:String>
    <sys:String x:Key="AppSubtitle">iPhone 媒体备份与归档</sys:String>
    <sys:String x:Key="DeviceConnected">已连接: iPhone 15 Pro (128GB)</sys:String>
    <sys:String x:Key="DeviceDisconnected">未检测到 iPhone (USB / AFC)</sys:String>
    <sys:String x:Key="DeviceBattery">电量: 85% (充电中)</sys:String>

    <!-- Sidebar Navigation -->
    <sys:String x:Key="NavBackup">📥 备份到电脑</sys:String>
    <sys:String x:Key="NavAndroidSync">🤖 恢复到 Android</sys:String>
    <sys:String x:Key="NavStatus">📊 归档状态</sys:String>
    <sys:String x:Key="NavSearch">🔍 媒体检索</sys:String>
    <sys:String x:Key="NavReorganize">📁 目录整理</sys:String>
    <sys:String x:Key="NavSettings">⚙️ 设置</sys:String>

    <!-- General UI Labels & Buttons -->
    <sys:String x:Key="LabelTransferred">已传输</sys:String>
    <sys:String x:Key="LabelSkipped">已跳过</sys:String>
    <sys:String x:Key="LabelFailed">失败数</sys:String>
    <sys:String x:Key="LabelTransferSize">传输容量 / 总容量</sys:String>
    <sys:String x:Key="LabelEta">剩余预计时间</sys:String>
    <sys:String x:Key="CloseBtn">关闭</sys:String>
    <sys:String x:Key="LoadMoreBtn">⏬ 加载更多 (1,000项)</sys:String>

    <!-- Backup Tab -->
    <sys:String x:Key="BackupTargetHeader">备份参数设置</sys:String>
    <sys:String x:Key="DestPathLabel">目标保存路径:</sys:String>
    <sys:String x:Key="BrowseButton">浏览...</sys:String>
    <sys:String x:Key="OrganizeSchemeLabel">目录结构:</sys:String>
    <sys:String x:Key="StartBackupBtn">🚀 开始增量备份</sys:String>
    <sys:String x:Key="PauseBackupBtn">⏸️ 暂停</sys:String>
    <sys:String x:Key="DryRunBtn">🔍 预览</sys:String>
    <sys:String x:Key="ProgressHeader">实时进度与日志</sys:String>
    <sys:String x:Key="SpeedLabel">传输速率:</sys:String>
    <sys:String x:Key="CurrentFileLabel">当前文件:</sys:String>
    <sys:String x:Key="CopiedCountLabel">已复制:</sys:String>
    <sys:String x:Key="SkippedCountLabel">已跳过:</sys:String>
    <sys:String x:Key="FailedCountLabel">失败数:</sys:String>

    <!-- Android Sync Tab -->
    <sys:String x:Key="AndroidSyncTitle">🤖 恢复到 Android</sys:String>
    <sys:String x:Key="AndroidSyncDescription">将 PC 本地已归档的媒体文件增量传输至 Android / Pixel 设备的 FTP 目录（如 /DCIM/GetAndSee/iPhone 15 Pro/）。传输记录由 SQLite 独立维护，自动跳过已传输文件。</sys:String>
    <sys:String x:Key="AndroidFtpHeader">⚙️ FTP 服务器与设备设置</sys:String>
    <sys:String x:Key="AndroidDeviceNameLabel">Android 设备名:</sys:String>
    <sys:String x:Key="FtpPortLabel">FTP 端口:</sys:String>
    <sys:String x:Key="FtpHostLabel">FTP 地址/IP:</sys:String>
    <sys:String x:Key="FtpUserLabel">FTP 用户名:</sys:String>
    <sys:String x:Key="FtpPassLabel">FTP 密码:</sys:String>
    <sys:String x:Key="AndroidTargetDirLabel">目标目录:</sys:String>
    <sys:String x:Key="TestFtpBtn">⚡ 测试 FTP 连接</sys:String>
    <sys:String x:Key="AndroidControlHeader">🚀 恢复到 Android</sys:String>
    <sys:String x:Key="SourceArchiveDirLabel">源归档目录:</sys:String>
    <sys:String x:Key="StartAndroidSyncBtn">🚀 开始同步到 Android</sys:String>
    <sys:String x:Key="CancelAndroidSyncBtn">⏸️ 暂停同步</sys:String>
    <sys:String x:Key="TransferLogHeader">📋 传输日志</sys:String>

    <!-- Status Tab -->
    <sys:String x:Key="StatusHeader">归档文件概览</sys:String>
    <sys:String x:Key="TotalFilesLabel">总包含媒体文件:</sys:String>
    <sys:String x:Key="TotalSizeLabel">已归档总容量:</sys:String>
    <sys:String x:Key="PhotosCountLabel">照片 (JPEG/HEIC/RAW):</sys:String>
    <sys:String x:Key="VideosCountLabel">视频或Live图 (MOV/MP4):</sys:String>
    <sys:String x:Key="LastBackupTimeLabel">最近备份时间:</sys:String>
    <sys:String x:Key="SqliteDbPathLabel">数据库路径 (Manifest):</sys:String>
    <sys:String x:Key="DeviceHistoryHeader">备份设备历史记录</sys:String>
    
    <!-- Table Columns for Device History -->
    <sys:String x:Key="ColDeviceName">设备名称</sys:String>
    <sys:String x:Key="ColDeviceModel">机型型号</sys:String>
    <sys:String x:Key="ColDeviceUdid">设备 UDID</sys:String>
    <sys:String x:Key="ColLastSeen">最近在线时间</sys:String>

    <!-- Search Tab -->
    <sys:String x:Key="SearchHeader">检索媒体文件</sys:String>
    <sys:String x:Key="SearchResultsHeader">检索结果</sys:String>
    <sys:String x:Key="FileNameFilterLabel">文件名关键词:</sys:String>
    <sys:String x:Key="DateFromLabel">起始日期:</sys:String>
    <sys:String x:Key="DateToLabel">结束日期:</sys:String>
    <sys:String x:Key="TypeFilterLabel">媒体类型:</sys:String>
    <sys:String x:Key="CameraFilterLabel">拍摄设备型号:</sys:String>
    <sys:String x:Key="GpsFilterLabel">包含 GPS 定位</sys:String>
    <sys:String x:Key="IncludeHeicLabel">显示 HEIC 文件</sys:String>
    <sys:String x:Key="SearchBtn">开始检索</sys:String>
    <sys:String x:Key="ViewModeTableView">📋 表格列表</sys:String>
    <sys:String x:Key="ViewModeGalleryView">🖼️ 照片画廊</sys:String>
    
    <!-- Table Columns for Search Results -->
    <sys:String x:Key="ColRelativePath">相对归档路径</sys:String>
    <sys:String x:Key="ColCaptureDate">拍摄/创作时间</sys:String>
    <sys:String x:Key="ColSize">文件大小</sys:String>
    <sys:String x:Key="ColType">媒体类型</sys:String>
    <sys:String x:Key="ColCamera">拍摄设备型号</sys:String>
    <sys:String x:Key="ColGps">GPS 坐标</sys:String>

    <!-- Read-Only Shell Context Menu for Search Results -->
    <sys:String x:Key="MenuOpen">打开</sys:String>
    <sys:String x:Key="MenuOpenWith">打开方式...</sys:String>
    <sys:String x:Key="MenuCopy">复制</sys:String>
    <sys:String x:Key="MenuCopyPath">复制文件路径</sys:String>
    <sys:String x:Key="MenuShowInExplorer">在资源管理器中显示</sys:String>
    <sys:String x:Key="MenuProperties">属性</sys:String>

    <!-- Reorganize Tab -->
    <sys:String x:Key="ReorganizeHeader">归档目录结构重整理</sys:String>
    <sys:String x:Key="CurrentSchemeLabel">当前归档结构:</sys:String>
    <sys:String x:Key="TargetSchemeLabel">目标归档结构:</sys:String>
    <sys:String x:Key="ReorganizeDryRunBtn">🔍 预览重整理</sys:String>
    <sys:String x:Key="ExecuteReorganizeBtn">📁 执行结构重整理</sys:String>
    <sys:String x:Key="ReorganizePreviewHeader">结果预览</sys:String>
    <sys:String x:Key="ColOriginalPath">原相对路径</sys:String>
    <sys:String x:Key="ColTargetPath">→ 预计目标相对路径</sys:String>

    <!-- Settings Tab -->
    <sys:String x:Key="SettingsHeader">功能与安全选项</sys:String>
    <sys:String x:Key="ResetFileTimeHeader">⏱️ 重新设置文件时间</sys:String>
    <sys:String x:Key="SyncTimeOption">同步照片 EXIF 拍摄时间到 Windows 文件修改时间</sys:String>
    <sys:String x:Key="SyncCreationTimeOption">同时修改 Windows 文件创建时间</sys:String>
    <sys:String x:Key="ReadTimeoutLabel">读取超时限制 (秒):</sys:String>
    <sys:String x:Key="DisablePcSleepOption">提示禁用 PC 睡眠以防大型传输中断</sys:String>
    <sys:String x:Key="ExifSafetyNote">提示：默认情况下，Windows 显示的文件时间显示的是 Windows 文件的修改时间，而不是照片的拍摄时间。运行该选项可以把照片的拍摄时间同步到 Windows 文件的修改时间，但不会修改 iPhone 端或文件本身的 EXIF 内容。注：无论是否运行该选项，都不会影响相册软件识别照片准确拍摄时间的能力。</sys:String>
    <sys:String x:Key="SyncExifNowBtn">⚡ 立即同步归档目录中所有文件的 EXIF 时间</sys:String>

    <!-- Lightbox Preview Modal -->
    <sys:String x:Key="MediaPreviewHeader">🖼️ 媒体实时大图预览</sys:String>
    <sys:String x:Key="ClosePreviewBtn">✕ 关闭 (Esc)</sys:String>
    <sys:String x:Key="CopyPathBtn">📋 复制路径</sys:String>
    <sys:String x:Key="ShowInExplorerBtn">📁 在资源管理器显示</sys:String>

    <!-- Device Probe Messages -->
    <sys:String x:Key="MsgConnected">已连接: {0}{1}</sys:String>
    <sys:String x:Key="MsgTrustRequired">请解锁 iPhone 并点击“信任此电脑”</sys:String>
    <sys:String x:Key="MsgDriverUnavailable">Apple 驱动服务未运行 (请开启 iTunes)</sys:String>

    <!-- General Status Strings for ViewModels -->
    <sys:String x:Key="MsgReady">准备就绪</sys:String>
    <sys:String x:Key="MsgStatusSkipped">已存在 / 增量跳过</sys:String>
    <sys:String x:Key="MsgStatusSuccess">成功</sys:String>
    <sys:String x:Key="MsgBackupCompleted">备份完成</sys:String>
    <sys:String x:Key="MsgSyncCompleted">同步完成</sys:String>
    <sys:String x:Key="MsgCalculating">计算中...</sys:String>
    <sys:String x:Key="MsgSyncCancelled">同步已取消</sys:String>
    <sys:String x:Key="MsgFileNotFound">文件不存在</sys:String>
    <sys:String x:Key="MsgTargetDirNotExist">目标归档路径不存在</sys:String>

    <!-- ViewModel Dynamic Status Messages -->
    <sys:String x:Key="MsgDirNotExist">归档目录不存在，请先选择有效的备份目标路径。</sys:String>
    <sys:String x:Key="MsgDbNotFound">未在归档目录中找到 get-and-see.db 数据库，请先执行备份。</sys:String>
    <sys:String x:Key="MsgReadingDb">正在读取归档数据库...</sys:String>
    <sys:String x:Key="MsgCompletedProgress">已完成: {0} / {1} 文件</sys:String>
    <sys:String x:Key="MsgUpdatedCount">已成功更新: {0} 项</sys:String>
    <sys:String x:Key="MsgUpdatedZero">已更新: 0 项</sys:String>
    <sys:String x:Key="MsgNoFilesToSync">归档清单中未找到可同步的文件</sys:String>
    <sys:String x:Key="MsgSyncSuccess">✅ 同步完成！共检索 {0} 个归档文件，成功将 {1} 个文件的 EXIF 时间同步到 Windows 系统时间。</sys:String>
    <!-- Details DataGrid Columns & Tooltips -->
    <sys:String x:Key="ColSourcePath">源路径</sys:String>
    <sys:String x:Key="ColStatus">状态</sys:String>
    <sys:String x:Key="ColDetails">详细说明</sys:String>
    <sys:String x:Key="ToolTipTransferred">点击查看已传输/已复制文件列表</sys:String>
    <sys:String x:Key="ToolTipSkipped">点击查看已跳过文件列表</sys:String>
    <sys:String x:Key="ToolTipFailed">点击查看失败文件列表</sys:String>
    <sys:String x:Key="ReexifHeader">⏱️ 重新设置文件时间</sys:String>
    <sys:String x:Key="SyncNowBtn">⚡ 立即同步归档目录中所有文件的 EXIF 时间</sys:String>
    <sys:String x:Key="CloseEscBtn">✕ 关闭 (Esc)</sys:String>
    <sys:String x:Key="LightboxToolTip">双击使用系统默认程序打开原图</sys:String>

</ResourceDictionary>
