<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Application Title & General -->
    <sys:String x:Key="AppTitle">GetAndSee - GUI</sys:String>
    <sys:String x:Key="AppSubtitle">iPhone Media Backup &amp; Archive</sys:String>
    <sys:String x:Key="DeviceConnected">Connected: iPhone 15 Pro (128GB)</sys:String>
    <sys:String x:Key="DeviceDisconnected">No iPhone Detected (USB / AFC)</sys:String>
    <sys:String x:Key="DeviceBattery">Battery: 85% (Charging)</sys:String>

    <!-- Sidebar Navigation -->
    <sys:String x:Key="NavBackup">📥 Backup to PC</sys:String>
    <sys:String x:Key="NavAndroidSync">🤖 Restore to Android</sys:String>
    <sys:String x:Key="NavStatus">📊 Archive Status</sys:String>
    <sys:String x:Key="NavSearch">🔍 Media Search</sys:String>
    <sys:String x:Key="NavReorganize">📁 Layout Reorganize</sys:String>
    <sys:String x:Key="NavSettings">⚙️ Settings</sys:String>

    <!-- General UI Labels & Buttons -->
    <sys:String x:Key="LabelTransferred">Transferred</sys:String>
    <sys:String x:Key="LabelSkipped">Skipped</sys:String>
    <sys:String x:Key="LabelFailed">Failed</sys:String>
    <sys:String x:Key="LabelTransferSize">Transferred / Total Size</sys:String>
    <sys:String x:Key="LabelEta">Remaining Time</sys:String>
    <sys:String x:Key="CloseBtn">Close</sys:String>
    <sys:String x:Key="LoadMoreBtn">⏬ Load More (1,000 items)</sys:String>

    <!-- Backup Tab -->
    <sys:String x:Key="BackupTargetHeader">Backup Settings</sys:String>
    <sys:String x:Key="DestPathLabel">Destination Path:</sys:String>
    <sys:String x:Key="BrowseButton">Browse...</sys:String>
    <sys:String x:Key="OrganizeSchemeLabel">Folder Structure:</sys:String>
    <sys:String x:Key="StartBackupBtn">🚀 Start Incremental Backup</sys:String>
    <sys:String x:Key="PauseBackupBtn">⏸️ Pause</sys:String>
    <sys:String x:Key="DryRunBtn">🔍 Preview</sys:String>
    <sys:String x:Key="ProgressHeader">Live Progress &amp; Logs</sys:String>
    <sys:String x:Key="SpeedLabel">Speed:</sys:String>
    <sys:String x:Key="CurrentFileLabel">Current File:</sys:String>
    <sys:String x:Key="CopiedCountLabel">Copied:</sys:String>
    <sys:String x:Key="SkippedCountLabel">Skipped:</sys:String>
    <sys:String x:Key="FailedCountLabel">Failed:</sys:String>

    <!-- Android Sync Tab -->
    <sys:String x:Key="AndroidSyncTitle">🤖 Restore to Android</sys:String>
    <sys:String x:Key="AndroidSyncDescription">Incrementally transfer archived media files from PC to Android/Pixel FTP directory. Transfer records are maintained independently by SQLite, skipping already synced files automatically.</sys:String>
    <sys:String x:Key="AndroidFtpHeader">⚙️ FTP Server &amp; Device Settings</sys:String>
    <sys:String x:Key="AndroidDeviceNameLabel">Android Device Name:</sys:String>
    <sys:String x:Key="FtpPortLabel">FTP Port:</sys:String>
    <sys:String x:Key="FtpHostLabel">FTP Address/IP:</sys:String>
    <sys:String x:Key="FtpUserLabel">FTP Username:</sys:String>
    <sys:String x:Key="FtpPassLabel">FTP Password:</sys:String>
    <sys:String x:Key="AndroidTargetDirLabel">Target Directory:</sys:String>
    <sys:String x:Key="TestFtpBtn">⚡ Test FTP Connection</sys:String>
    <sys:String x:Key="AndroidControlHeader">🚀 Restore to Android</sys:String>
    <sys:String x:Key="SourceArchiveDirLabel">Source Archive Path:</sys:String>
    <sys:String x:Key="StartAndroidSyncBtn">🚀 Start Sync to Android</sys:String>
    <sys:String x:Key="CancelAndroidSyncBtn">⏸️ Pause Sync</sys:String>
    <sys:String x:Key="TransferLogHeader">📋 Transfer Log</sys:String>

    <!-- Status Tab -->
    <sys:String x:Key="StatusHeader">Archive Overview</sys:String>
    <sys:String x:Key="TotalFilesLabel">Total Media Files:</sys:String>
    <sys:String x:Key="TotalSizeLabel">Total Archived Size:</sys:String>
    <sys:String x:Key="PhotosCountLabel">Photos (JPEG/HEIC/RAW):</sys:String>
    <sys:String x:Key="VideosCountLabel">Videos or Live Photos (MOV/MP4):</sys:String>
    <sys:String x:Key="LastBackupTimeLabel">Last Backup Date:</sys:String>
    <sys:String x:Key="SqliteDbPathLabel">Database Path (Manifest):</sys:String>
    <sys:String x:Key="DeviceHistoryHeader">Backup Device History</sys:String>
    
    <!-- Table Columns for Device History -->
    <sys:String x:Key="ColDeviceName">Device Name</sys:String>
    <sys:String x:Key="ColDeviceModel">Model</sys:String>
    <sys:String x:Key="ColDeviceUdid">Device UDID</sys:String>
    <sys:String x:Key="ColLastSeen">Last Seen</sys:String>

    <!-- Search Tab -->
    <sys:String x:Key="SearchHeader">Search Media Files</sys:String>
    <sys:String x:Key="SearchResultsHeader">Search Results</sys:String>
    <sys:String x:Key="FileNameFilterLabel">Filename Keyword:</sys:String>
    <sys:String x:Key="DateFromLabel">From Date:</sys:String>
    <sys:String x:Key="DateToLabel">To Date:</sys:String>
    <sys:String x:Key="TypeFilterLabel">Media Type:</sys:String>
    <sys:String x:Key="CameraFilterLabel">Device Model:</sys:String>
    <sys:String x:Key="GpsFilterLabel">Has GPS Coordinates</sys:String>
    <sys:String x:Key="IncludeHeicLabel">Include HEIC Files</sys:String>
    <sys:String x:Key="SearchBtn">Start Search</sys:String>
    <sys:String x:Key="ViewModeTableView">📋 Table View</sys:String>
    <sys:String x:Key="ViewModeGalleryView">🖼️ Photo Gallery</sys:String>
    
    <!-- Table Columns for Search Results -->
    <sys:String x:Key="ColRelativePath">Relative Archive Path</sys:String>
    <sys:String x:Key="ColCaptureDate">Capture Date</sys:String>
    <sys:String x:Key="ColSize">Size</sys:String>
    <sys:String x:Key="ColType">Media Type</sys:String>
    <sys:String x:Key="ColCamera">Device Model</sys:String>
    <sys:String x:Key="ColGps">GPS Coordinates</sys:String>

    <!-- Read-Only Shell Context Menu for Search Results -->
    <sys:String x:Key="MenuOpen">Open</sys:String>
    <sys:String x:Key="MenuOpenWith">Open with...</sys:String>
    <sys:String x:Key="MenuCopy">Copy</sys:String>
    <sys:String x:Key="MenuCopyPath">Copy file path</sys:String>
    <sys:String x:Key="MenuShowInExplorer">Show in Explorer</sys:String>
    <sys:String x:Key="MenuProperties">Properties</sys:String>

    <!-- Reorganize Tab -->
    <sys:String x:Key="ReorganizeHeader">Reorganize Archive Layout</sys:String>
    <sys:String x:Key="CurrentSchemeLabel">Current Scheme:</sys:String>
    <sys:String x:Key="TargetSchemeLabel">Target Scheme:</sys:String>
    <sys:String x:Key="ReorganizeDryRunBtn">🔍 Preview Reorganize</sys:String>
    <sys:String x:Key="ExecuteReorganizeBtn">📁 Execute Reorganize</sys:String>
    <sys:String x:Key="ReorganizePreviewHeader">Results Preview</sys:String>
    <sys:String x:Key="ColOriginalPath">Original Path</sys:String>
    <sys:String x:Key="ColTargetPath">→ Planned Target Path</sys:String>

    <!-- Settings Tab -->
    <sys:String x:Key="SettingsHeader">Options &amp; Features</sys:String>
    <sys:String x:Key="ResetFileTimeHeader">⏱️ Reset File Timestamps</sys:String>
    <sys:String x:Key="SyncTimeOption">Sync photo EXIF capture date to Windows file modification time</sys:String>
    <sys:String x:Key="SyncCreationTimeOption">Also sync Windows file creation time</sys:String>
    <sys:String x:Key="ReadTimeoutLabel">Read Timeout (Seconds):</sys:String>
    <sys:String x:Key="DisablePcSleepOption">Prompt to disable PC sleep to prevent transfer interruption</sys:String>
    <sys:String x:Key="ExifSafetyNote">Note: By default, Windows displays the file modification time rather than the photo's capture time. Enabling this option syncs the photo's EXIF capture date to the Windows file modification time, without modifying the original EXIF content on the iPhone or the file itself. Note: Whether this option is enabled or not, it will not affect the ability of photo library software to recognize the accurate photo capture date.</sys:String>
    <sys:String x:Key="SyncExifNowBtn">⚡ Sync EXIF Timestamps for All Files Now</sys:String>

    <!-- Lightbox Preview Modal -->
    <sys:String x:Key="MediaPreviewHeader">🖼️ Media Preview</sys:String>
    <sys:String x:Key="ClosePreviewBtn">✕ Close (Esc)</sys:String>
    <sys:String x:Key="CopyPathBtn">📋 Copy Path</sys:String>
    <sys:String x:Key="ShowInExplorerBtn">📁 Show in Explorer</sys:String>

    <!-- Device Probe Messages -->
    <sys:String x:Key="MsgConnected">Connected: {0}{1}</sys:String>
    <sys:String x:Key="MsgTrustRequired">Please unlock iPhone and tap "Trust This Computer"</sys:String>
    <sys:String x:Key="MsgDriverUnavailable">Apple driver service not running (please open iTunes)</sys:String>

    <!-- General Status Strings for ViewModels -->
    <sys:String x:Key="MsgReady">Ready</sys:String>
    <sys:String x:Key="MsgStatusSkipped">Already exists / Incremental skip</sys:String>
    <sys:String x:Key="MsgStatusSuccess">Success</sys:String>
    <sys:String x:Key="MsgBackupCompleted">Backup completed</sys:String>
    <sys:String x:Key="MsgSyncCompleted">Sync completed</sys:String>
    <sys:String x:Key="MsgCalculating">Calculating...</sys:String>
    <sys:String x:Key="MsgSyncCancelled">Sync cancelled</sys:String>
    <sys:String x:Key="MsgFileNotFound">File does not exist</sys:String>
    <sys:String x:Key="MsgTargetDirNotExist">Target archive path does not exist</sys:String>

    <!-- ViewModel Dynamic Status Messages -->
    <sys:String x:Key="MsgDirNotExist">Archive directory does not exist. Please choose a valid destination path first.</sys:String>
    <sys:String x:Key="MsgDbNotFound">Database get-and-see.db not found in archive directory. Please run backup first.</sys:String>
    <sys:String x:Key="MsgReadingDb">Reading archive database...</sys:String>
    <sys:String x:Key="MsgCompletedProgress">Completed: {0} / {1} files</sys:String>
    <sys:String x:Key="MsgUpdatedCount">Successfully updated: {0} items</sys:String>
    <sys:String x:Key="MsgUpdatedZero">Updated: 0 items</sys:String>
    <sys:String x:Key="MsgNoFilesToSync">No syncable files found in archive manifest</sys:String>
    <sys:String x:Key="MsgSyncSuccess">✅ Sync complete! Checked {0} archive files, successfully updated EXIF timestamps for {1} files to Windows system time.</sys:String>
    <!-- Details DataGrid Columns & Tooltips -->
    <sys:String x:Key="ColSourcePath">Source Path</sys:String>
    <sys:String x:Key="ColStatus">Status</sys:String>
    <sys:String x:Key="ColDetails">Details</sys:String>
    <sys:String x:Key="ToolTipTransferred">Click to view transferred/copied files list</sys:String>
    <sys:String x:Key="ToolTipSkipped">Click to view skipped files list</sys:String>
    <sys:String x:Key="ToolTipFailed">Click to view failed files list</sys:String>
    <sys:String x:Key="ReexifHeader">⏱️ Reset File Timestamps</sys:String>
    <sys:String x:Key="SyncNowBtn">⚡ Sync EXIF Timestamps for All Files Now</sys:String>
    <sys:String x:Key="CloseEscBtn">✕ Close (Esc)</sys:String>
    <sys:String x:Key="LightboxToolTip">Double-click to open original file with default application</sys:String>

</ResourceDictionary>
