                    </Grid>

                    <!-- Bottom Metadata & Actions Bar -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#0F172A" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <TextBlock Text="{Binding SearchVM.PreviewDetailsText}" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource CopyPathBtn}" Command="{Binding SearchVM.CopyPathCommand}" CommandParameter="{Binding SearchVM.PreviewItem}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Content="{DynamicResource ShowInExplorerBtn}" Command="{Binding SearchVM.ShowInExplorerCommand}" CommandParameter="{Binding SearchVM.PreviewItem}" Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MANUAL SELECTION LIST MODAL OVERLAY -->
        <Grid Grid.RowSpan="2" DataContext="{Binding IPhoneSyncVM}"
              Visibility="{Binding IsManualModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1000" Background="#C0000000">
            <Border Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" MaxWidth="900" MaxHeight="600" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="6" Background="#333B82F6" Margin="0,0,10,0">
                                <TextBlock Text="📱" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource ManualSelectionModalTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ManualSelectionCountText}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseManualModalCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Width="32" Height="32" Padding="0"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#0F172A" Padding="10">
                        <Grid>
                            <!-- Empty State Placeholder -->
                            <StackPanel Visibility="{Binding HasNoManualSelections, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60">
                                <Border Width="64" Height="64" CornerRadius="32" Background="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="📱" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource ScopeManualEmptyHint}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource ScopeManualEmptySubHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Items Grid -->
                            <ItemsControl ItemsSource="{Binding ManualSelectedItems}" Visibility="{Binding HasManualSelections, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="160" Height="175" CornerRadius="8" Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="6" ClipToBounds="True">
                                            <Border.ToolTip>
                                                <ToolTip Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" Foreground="White">
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="{Binding RelativePath}" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding CapturedAt, StringFormat='拍摄/修改时间: {0}'}" Foreground="#94A3B8" FontSize="11"/>
                                                        <TextBlock Text="{Binding SizeText, StringFormat='文件大小: {0}'}" Foreground="#94A3B8" FontSize="11"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="115"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Background="#0F172A">
                                                    <TextBlock Text="🖼️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#475569"/>
                                                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThumbnailLoaded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <!-- Autofill Badge Overlay -->
                                                    <Border Visibility="{Binding IsAutofilled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="#E00F172A" BorderBrush="#38BDF8" BorderThickness="1"
                                                            CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                            ToolTip="{DynamicResource ToolTipAutofilledBadge}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="✨" FontSize="10" Foreground="#38BDF8" Margin="0,0,3,0" VerticalAlignment="Center" FontFamily="Segoe UI Emoji, Segoe UI"/>
                                                            <TextBlock Text="{DynamicResource BadgeAutofilledLabel}" Foreground="#38BDF8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    
                                                    <Button Content="✕" Command="{Binding DataContext.RemoveManualItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" Width="22" Height="22" Padding="0" FontSize="10"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" ToolTip="{DynamicResource RemoveFromListBtn}"/>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="6,4">
                                                    <TextBlock Text="{Binding RelativePath}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayCapturedAt}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="{DynamicResource ClearAllListBtn}" Command="{Binding ClearAllManualSelectionsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="16,8"/>
                        <Button Content="{DynamicResource CloseBtn}" Command="{Binding CloseManualModalCommand}" Style="{StaticResource PrimaryButton}" Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ANDROID MANUAL SELECTION LIST MODAL OVERLAY -->
        <Grid Grid.RowSpan="2" DataContext="{Binding AndroidSyncVM}"
              Visibility="{Binding IsManualModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1000" Background="#C0000000">
            <Border Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" MaxWidth="900" MaxHeight="600" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="6" Background="#3310B981" Margin="0,0,10,0">
                                <TextBlock Text="🤖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource AndroidManualSelectionModalTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ManualSelectionCountText}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseManualModalCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Width="32" Height="32" Padding="0"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#0F172A" Padding="10">
                        <Grid>
                            <!-- Empty State Placeholder -->
                            <StackPanel Visibility="{Binding HasNoManualSelections, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60">
                                <Border Width="64" Height="64" CornerRadius="32" Background="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="🤖" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource ScopeManualEmptyHint}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource ScopeManualEmptySubHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Items Grid -->
                            <ItemsControl ItemsSource="{Binding ManualSelectedItems}" Visibility="{Binding HasManualSelections, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="160" Height="175" CornerRadius="8" Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="6" ClipToBounds="True">
                                            <Border.ToolTip>
                                                <ToolTip Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" Foreground="White">
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="{Binding RelativePath}" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding CapturedAt, StringFormat='拍摄/修改时间: {0}'}" Foreground="#94A3B8" FontSize="11"/>
                                                        <TextBlock Text="{Binding SizeText, StringFormat='文件大小: {0}'}" Foreground="#94A3B8" FontSize="11"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="115"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Background="#0F172A">
                                                    <TextBlock Text="🖼️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#475569"/>
                                                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThumbnailLoaded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <!-- Autofill Badge Overlay -->
                                                    <Border Visibility="{Binding IsAutofilled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="#E00F172A" BorderBrush="#38BDF8" BorderThickness="1"
                                                            CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                            ToolTip="{DynamicResource ToolTipAutofilledBadge}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="✨" FontSize="10" Foreground="#38BDF8" Margin="0,0,3,0" VerticalAlignment="Center" FontFamily="Segoe UI Emoji, Segoe UI"/>
                                                            <TextBlock Text="{DynamicResource BadgeAutofilledLabel}" Foreground="#38BDF8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    
                                                    <Button Content="✕" Command="{Binding DataContext.RemoveManualItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" Width="22" Height="22" Padding="0" FontSize="10"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" ToolTip="{DynamicResource RemoveFromListBtn}"/>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="6,4">
                                                    <TextBlock Text="{Binding RelativePath}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayCapturedAt}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="{DynamicResource ClearAllListBtn}" Command="{Binding ClearAllManualSelectionsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="16,8"/>
                        <Button Content="{DynamicResource CloseBtn}" Command="{Binding CloseManualModalCommand}" Style="{StaticResource PrimaryButton}" Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- HIGH-RISK SAFETY CONFIRMATION MODAL OVERLAY -->
        <Grid Grid.RowSpan="2" DataContext="{Binding IPhoneSyncVM}"
              Visibility="{Binding IsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="999" Background="#C0000000">
            <Border Background="#1E293B" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="2"
                    CornerRadius="12" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding ModalTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ModalMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource CloseBtn}" Command="{Binding CancelModalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="16,8"/>
                        <Button Content="{Binding ModalConfirmText}" Command="{Binding ConfirmModalCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- IPHONE PREFLIGHT INTERCEPT MODAL OVERLAY -->
        <Grid Grid.RowSpan="2" DataContext="{Binding IPhoneSyncVM}"
              Visibility="{Binding IsPreflightModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1001" Background="#C0000000">
            <Border Background="#1E293B" BorderBrush="{StaticResource AccentYellowBrush}" BorderThickness="2"
                    CornerRadius="12" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding PreflightTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentYellowBrush}" Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" Background="#0F172A" Padding="12">
                        <TextBlock Text="{Binding PreflightMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource CancelPreflightModalBtn}" Command="{Binding CancelPreflightModalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="{DynamicResource OpenSettingsTabBtn}" Command="{Binding OpenSettingsTabCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="{DynamicResource IgnorePreflightAndProceedBtn}" Command="{Binding IgnorePreflightAndProceedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="{DynamicResource FixPreflightAndProceedBtn}" Command="{Binding FixPreflightAndProceedCommand}" Style="{StaticResource PrimaryButton}" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ANDROID PREFLIGHT INTERCEPT MODAL OVERLAY -->
        <Grid Grid.RowSpan="2" DataContext="{Binding AndroidSyncVM}"
              Visibility="{Binding IsPreflightModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1001" Background="#C0000000">
            <Border Background="#1E293B" BorderBrush="{StaticResource AccentYellowBrush}" BorderThickness="2"
                    CornerRadius="12" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding PreflightTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentYellowBrush}" Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" Background="#0F172A" Padding="12">
                        <TextBlock Text="{Binding PreflightMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource CancelPreflightModalBtn}" Command="{Binding CancelPreflightModalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="{DynamicResource OpenSettingsTabBtn}" Command="{Binding OpenSettingsTabCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="{DynamicResource IgnorePreflightAndProceedBtn}" Command="{Binding IgnorePreflightAndProceedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="{DynamicResource FixPreflightAndProceedBtn}" Command="{Binding FixPreflightAndProceedCommand}" Style="{StaticResource PrimaryButton}" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
