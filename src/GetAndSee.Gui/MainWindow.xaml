                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AndroidFtpHeader}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource AndroidDeviceNameLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding AndroidDeviceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,16,0"/>

                                            <TextBlock Grid.Column="2" Text="{DynamicResource FtpPortLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="3" Text="{Binding AndroidFtpPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource FtpHostLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding AndroidFtpHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,16,0"/>

                                            <TextBlock Grid.Column="2" Text="{DynamicResource FtpUserLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="3" Text="{Binding AndroidFtpUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource FtpPassLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding AndroidFtpPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,16,0"/>

                                            <TextBlock Grid.Column="2" Text="{DynamicResource AndroidTargetDirLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="3" Text="{Binding AndroidTargetDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                        </Grid>

                                        <!-- Mirror Delete Checkbox -->
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource AndroidRestoreModeLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton Content="{DynamicResource AndroidRestoreModeDefault}" IsChecked="{Binding IsDefaultRestoreMode, Mode=TwoWay}" Style="{StaticResource TabRadioButton}" Margin="0,0,12,0" Padding="12,6"/>
                                                <RadioButton Content="{DynamicResource AndroidRestoreModeHistorical}" IsChecked="{Binding IsHistoricalIncrementalMode, Mode=TwoWay}" Style="{StaticResource TabRadioButton}" Margin="0,0,12,0" Padding="12,6"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="{DynamicResource TestFtpBtn}" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding TestStatus}" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Sync Operation Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AndroidControlHeader}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource SourceArchiveDirLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding ArchivePath}" IsReadOnly="True" Style="{StaticResource ModernTextBox}" Background="#0F172A"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="{DynamicResource StartAndroidSyncBtn}" Command="{Binding StartSyncCommand}" Style="{StaticResource PrimaryButton}" Padding="20,10" Margin="0,0,10,0"/>
                                            <Button Content="{DynamicResource CancelAndroidSyncBtn}" Command="{Binding CancelSyncCommand}" Style="{StaticResource SecondaryButton}" Padding="16,10"/>
                                        </StackPanel>

                                        <!-- Progress Bar -->
                                        <Grid Margin="0,0,0,10">
                                            <ProgressBar Value="{Binding ProgressValue}" Height="20" Minimum="0" Maximum="100" Foreground="{StaticResource PrimaryBrush}" Background="#0F172A"/>
                                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </Grid>

                                        <!-- Counters & ETA Stats -->
                                        <UniformGrid Columns="5">
                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="0,0,4,0" Cursor="Hand" ToolTip="{DynamicResource ToolTipTransferred}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowCopiedDetailsCommand}"/>
                                                </Border.InputBindings>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelTransferred}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CopiedCount}" Foreground="{StaticResource AccentGreenBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="2,0,2,0" Cursor="Hand" ToolTip="{DynamicResource ToolTipSkipped}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowSkippedDetailsCommand}"/>
                                                </Border.InputBindings>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelSkipped}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SkippedCount}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="2,0,2,0" Cursor="Hand" ToolTip="{DynamicResource ToolTipFailed}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowFailedDetailsCommand}"/>
                                                </Border.InputBindings>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelFailed}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FailedCount}" Foreground="{StaticResource AccentRedBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="2,0,2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelTransferSize}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TransferredSizeText}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="4,0,0,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelEta}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding EtaText}" Foreground="{StaticResource AccentYellowBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Real-time Log Stream Card -->
                                <Border Style="{StaticResource ModernCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource TransferLogHeader}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <ListBox ItemsSource="{Binding LogEntries}" Height="180" Background="#0F172A" BorderThickness="0" Padding="8">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="#A7F3D0"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Detail DataGrid Modal Overlay -->
                        <Grid Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Background="#C0000000" Panel.ZIndex="999">
                            <Border Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Width="900" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,15">
                                        <TextBlock Text="{Binding DetailModalTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button Content="✕" Command="{Binding CloseDetailModalCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Width="32" Height="32" Padding="0"/>
                                    </Grid>

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding DetailItems}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Extended"
                                              Background="#0F172A" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                                              RowBackground="#0F172A" AlternatingRowBackground="#182238" Foreground="White"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                                                <EventSetter Event="PreviewMouseDoubleClick" Handler="DetailDataGridRow_MouseDoubleClick"/>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource MenuOpen}" 
                                                          Command="{Binding PlacementTarget.DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuOpenWith}" 
                                                          Command="{Binding PlacementTarget.DataContext.OpenWithDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuCopy}" 
                                                          Command="{Binding PlacementTarget.DataContext.CopyDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuCopyPath}" 
                                                          Command="{Binding PlacementTarget.DataContext.CopyPathDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuShowInExplorer}" 
                                                          Command="{Binding PlacementTarget.DataContext.ShowInExplorerDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuProperties}" 
                                                          Command="{Binding PlacementTarget.DataContext.PropertiesDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="10,8"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#334155"/>
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="10,6"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="DataGridCell">
                                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource ColSourcePath}" Binding="{Binding SourcePath}" Width="2*"/>
                                            <DataGridTextColumn Header="{DynamicResource ColTargetPath}" Binding="{Binding TargetPath}" Width="2*"/>
                                            <DataGridTextColumn Header="{DynamicResource ColSize}" Binding="{Binding FileSizeText}" Width="80"/>
                                            <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding StatusText}" Width="80"/>
                                            <DataGridTextColumn Header="{DynamicResource ColDetails}" Binding="{Binding Details}" Width="1.5*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                        <Button Content="{DynamicResource CloseBtn}" Command="{Binding CloseDetailModalCommand}" Style="{StaticResource SecondaryButton}" Padding="20,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 1: STATUS & OVERVIEW -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel DataContext="{Binding StatusVM}">
                            <TextBlock Text="{DynamicResource StatusHeader}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                            <!-- Stat Cards Grid -->
                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource TotalFilesLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalFiles, StringFormat={}{0:N0}}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource TotalSizeLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalSizeText}" Foreground="{StaticResource AccentGreenBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource PhotosCountLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding PhotosCount, StringFormat={}{0:N0}}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ModernCard}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource VideosCountLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding VideosCount, StringFormat={}{0:N0}}" Foreground="{StaticResource AccentYellowBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Database info card -->
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SqliteDbPathLabel}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding DatabasePath}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{DynamicResource LastBackupTimeLabel}" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding LastBackupTime}" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Device History Table -->
                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource DeviceHistoryHeader}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                                    <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                                              Background="Transparent" BorderThickness="0" RowHeaderWidth="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource ColDeviceName}" Binding="{Binding Name}" Width="160"/>
                                            <DataGridTextColumn Header="{DynamicResource ColDeviceModel}" Binding="{Binding Model}" Width="120"/>
                                            <DataGridTextColumn Header="{DynamicResource ColDeviceUdid}" Binding="{Binding Udid}" Width="*"/>
                                            <DataGridTextColumn Header="{DynamicResource ColLastSeen}" Binding="{Binding LastSeen}" Width="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: SEARCH & GALLERY -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel DataContext="{Binding SearchVM}">
                            <!-- Search Filters Card -->
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SearchHeader}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    
                                    <!-- Row 1: Filename & Camera Model -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource FileNameFilterLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding FileNameFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,16,0"/>

                                        <TextBlock Grid.Column="2" Text="{DynamicResource CameraFilterLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding CameraFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                    </Grid>

                                    <!-- Row 2: Date Pickers & Presets -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource DateFromLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFromDate, Mode=TwoWay}" Width="140" Height="30" Margin="0,0,16,0"/>

                                        <TextBlock Grid.Column="2" Text="{DynamicResource DateToLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <DatePicker Grid.Column="3" SelectedDate="{Binding FilterToDate, Mode=TwoWay}" Width="140" Height="30" Margin="0,0,16,0"/>

                                        <Button Grid.Column="4" Content="{DynamicResource ScopeClearDateBtn}" Command="{Binding ClearDateRangeCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,16,0"/>

                                        <!-- Quick Presets -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{DynamicResource ScopeQuickPresetsLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                            <Button Content="{DynamicResource PresetLast30Days}" Command="{Binding SetDatePresetLast30DaysCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                                            <Button Content="{DynamicResource PresetLast90Days}" Command="{Binding SetDatePresetLast90DaysCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                                            <Button Content="{DynamicResource PresetLast1Year}" Command="{Binding SetDatePresetLast1YearCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                                            <Button Content="{DynamicResource PresetThisYear}" Command="{Binding SetDatePresetThisYearCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,0,0" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 3: Media Type, Checkboxes & Search Button -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{DynamicResource TypeFilterLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding MediaTypes}" SelectedItem="{Binding SelectedType}" Height="34" Margin="0,0,16,0"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="{DynamicResource IncludeHeicLabel}" IsChecked="{Binding IncludeHeic}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <CheckBox Content="{DynamicResource GpsFilterLabel}" IsChecked="{Binding HasGpsOnly}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <Button Content="{DynamicResource SearchBtn}" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Padding="20,8"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Results Section Header & View Mode Switcher -->
                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SearchResultsHeader}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SearchSummaryText}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                                            <Button Content="{DynamicResource LoadMoreBtn}" Command="{Binding LoadMoreItemsCommand}"
                                                    Visibility="{Binding HasMoreItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="10,4" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Content="{DynamicResource ViewModeTableView}" IsChecked="{Binding IsTableView}" Style="{StaticResource TabRadioButton}" Margin="0,0,4,0" Padding="12,6" FontSize="12"/>
                                            <RadioButton Content="{DynamicResource ViewModeGalleryView}" IsChecked="{Binding IsGalleryView}" Style="{StaticResource TabRadioButton}" Padding="12,6" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Table View -->
                                    <DataGrid ItemsSource="{Binding SearchResults}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Extended" 
                                              Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                                              MaxHeight="480" VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.ScrollChanged="SearchResults_ScrollChanged"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel">
                                        <DataGrid.Style>
                                            <Style TargetType="DataGrid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGalleryView}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Style>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                                                <EventSetter Event="PreviewMouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource MenuOpen}" 
                                                          Command="{Binding PlacementTarget.DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuOpenWith}" 
                                                          Command="{Binding PlacementTarget.DataContext.OpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuCopy}" 
                                                          Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuCopyPath}" 
                                                          Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuShowInExplorer}" 
                                                          Command="{Binding PlacementTarget.DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuProperties}" 
                                                          Command="{Binding PlacementTarget.DataContext.PropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuAddToIPhone}" 
                                                          Command="{Binding PlacementTarget.DataContext.AddToIPhoneSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuRemoveFromIPhone}" 
                                                          Command="{Binding PlacementTarget.DataContext.RemoveFromIPhoneSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuAddToAndroid}" 
                                                          Command="{Binding PlacementTarget.DataContext.AddToAndroidSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuRemoveFromAndroid}" 
                                                          Command="{Binding PlacementTarget.DataContext.RemoveFromAndroidSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource ColRelativePath}" Binding="{Binding RelativePath}" Width="*"/>
                                            <DataGridTextColumn Header="{DynamicResource ColCaptureDate}" Binding="{Binding CapturedAt}" Width="160"/>
                                            <DataGridTextColumn Header="{DynamicResource ColSize}" Binding="{Binding SizeText}" Width="90"/>
                                            <DataGridTextColumn Header="{DynamicResource ColType}" Binding="{Binding MediaType}" Width="90"/>
                                            <DataGridTextColumn Header="{DynamicResource ColCamera}" Binding="{Binding CameraModel}" Width="130"/>
                                            <DataGridTextColumn Header="{DynamicResource ColGps}" Binding="{Binding GpsCoordinates}" Width="140"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Gallery Grid View (Virtualized Row-Based Grid) -->
                                    <ListBox ItemsSource="{Binding GalleryRows}" MaxHeight="480"
                                             SelectionMode="Single"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.ScrollChanged="Gallery_ScrollChanged"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.Style>
                                            <Style TargetType="ListBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGalleryView}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource MenuOpen}" 
                                                          Command="{Binding PlacementTarget.DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuOpenWith}" 
                                                          Command="{Binding PlacementTarget.DataContext.OpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuCopy}" 
                                                          Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuCopyPath}" 
                                                          Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuShowInExplorer}" 
                                                          Command="{Binding PlacementTarget.DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuProperties}" 
                                                          Command="{Binding PlacementTarget.DataContext.PropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel IsItemsHost="True" Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="190" Height="190" CornerRadius="10" ClipToBounds="True" Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,12,0" Cursor="Hand"
                                                                    MouseLeftButtonDown="GalleryCard_MouseLeftButtonDown"
                                                                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="{DynamicResource MenuOpen}" 
                                                                                  Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        <MenuItem Header="{DynamicResource MenuOpenWith}" 
                                                                                  Command="{Binding PlacementTarget.Tag.OpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="{DynamicResource MenuCopy}" 
                                                                                  Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        <MenuItem Header="{DynamicResource MenuCopyPath}" 
                                                                                  Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        <MenuItem Header="{DynamicResource MenuShowInExplorer}" 
                                                                                  Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="{DynamicResource MenuProperties}" 
                                                                                  Command="{Binding PlacementTarget.Tag.PropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="{DynamicResource MenuAddToIPhone}" 
                                                                                  Command="{Binding PlacementTarget.Tag.AddToIPhoneSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        <MenuItem Header="{DynamicResource MenuRemoveFromIPhone}" 
                                                                                  Command="{Binding PlacementTarget.Tag.RemoveFromIPhoneSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="{DynamicResource MenuAddToAndroid}" 
                                                                                  Command="{Binding PlacementTarget.Tag.AddToAndroidSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                        <MenuItem Header="{DynamicResource MenuRemoveFromAndroid}" 
                                                                                  Command="{Binding PlacementTarget.Tag.RemoveFromAndroidSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Grid>
                                                                    <!-- Fallback Icon (Behind Thumbnail) -->
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding MediaTypeIcon}" FontSize="40" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding MediaType}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- Full Card Thumbnail Image -->
                                                                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsThumbnailLoaded}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>

                                                                    <!-- Top-Left Type Badge Pill -->
                                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#A00F172A" CornerRadius="4" Padding="6,2">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding MediaTypeIcon}" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding MediaType}" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Top-Right iPhone Selection Badge Pill -->
                                                                     <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="#E016A34A" CornerRadius="4" Padding="6,2"
                                                                             Visibility="{Binding IsManualSelectedForIPhone, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                         <StackPanel Orientation="Horizontal">
                                                                             <TextBlock Text="📱" FontSize="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                                             <TextBlock Text="iPhone" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                         </StackPanel>
                                                                     </Border>

                                                                     <!-- Bottom Gradient Text Overlay -->
                                                                    <Border VerticalAlignment="Bottom" Padding="8,10,8,6">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#00000000" Offset="0"/>
                                                                                <GradientStop Color="#CC0F172A" Offset="0.5"/>
                                                                                <GradientStop Color="#F00F172A" Offset="1"/>
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding RelativePath}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                            <Grid Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding CapturedAt}" Foreground="#94A3B8" FontSize="10"/>
                                                                                <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="10" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: REORGANIZE -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel DataContext="{Binding ReorganizeVM}">
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ReorganizeHeader}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource CurrentSchemeLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding CurrentScheme}" IsReadOnly="True" Style="{StaticResource ModernTextBox}" Margin="0,0,16,0"/>

                                        <TextBlock Grid.Column="2" Text="{DynamicResource TargetSchemeLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="3" ItemsSource="{Binding Schemes}" SelectedItem="{Binding TargetScheme}" Height="34"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource ReorganizeDryRunBtn}" Command="{Binding DryRunCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                                        <Button Content="{DynamicResource ExecuteReorganizeBtn}" Command="{Binding ExecuteReorganizeCommand}" Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Preview Table -->
                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource ReorganizePreviewHeader}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ReorgSummaryText}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="False" IsReadOnly="True" 
                                              Background="Transparent" BorderThickness="0"
                                              MaxHeight="480" VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource ColOriginalPath}" Binding="{Binding OriginalPath}" Width="*"/>
                                            <DataGridTextColumn Header="{DynamicResource ColTargetPath}" Binding="{Binding TargetPath}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 4: SETTINGS & EXIF FILE TIME SYNC -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel DataContext="{Binding SettingsVM}">
                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SettingsHeader}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                                    <!-- EXIF File Time Sync Section -->
                                    <Border Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource ReexifHeader}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryHoverBrush}" Margin="0,0,0,8"/>
                                            
                                            <CheckBox Content="{DynamicResource SyncTimeOption}" IsChecked="{Binding SyncExifToLastWriteTime}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            <CheckBox Content="{DynamicResource SyncCreationTimeOption}" IsChecked="{Binding SyncExifToCreationTime}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                            <Border Background="#1E293B" BorderBrush="{StaticResource AccentYellowBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                <TextBlock Text="{DynamicResource ExifSafetyNote}" Foreground="{StaticResource AccentYellowBrush}" TextWrapping="Wrap" FontSize="11"/>
                                            </Border>

                                            <Button Content="{DynamicResource SyncNowBtn}" Command="{Binding SyncNowCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,8" Margin="0,4,0,8"/>

                                            <!-- Progress Bar & Details -->
                                            <StackPanel Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,8">
                                                <Grid Margin="0,0,0,6">
                                                    <ProgressBar Value="{Binding SyncProgressPercentage}" Height="20" Minimum="0" Maximum="100" Foreground="{StaticResource PrimaryBrush}" Background="#1E293B"/>
                                                    <TextBlock Text="{Binding SyncProgressOverlayText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </Grid>

                                                <Grid Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding SyncProgressDetailText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SyncUpdatedText}" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>

                                            <TextBlock Text="{Binding SyncStatusMessage}" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Auto-Completion Settings Section -->
                                    <Border Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SettingAutoCompleteHeader}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryHoverBrush}" Margin="0,0,0,8"/>
                                            <CheckBox Content="{DynamicResource SettingAutoCompleteLivePhoto}" IsChecked="{Binding AutoCompleteLivePhotoPair}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            <CheckBox Content="{DynamicResource SettingAutoCompleteAae}" IsChecked="{Binding AutoCompleteAaeSidecar}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            <CheckBox Content="{DynamicResource SettingAutoCompleteRawJpg}" IsChecked="{Binding AutoCompleteRawJpg}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Timeout Setting -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource ReadTimeoutLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ReadTimeoutSeconds}" Style="{StaticResource ModernTextBox}"/>
                                    </Grid>

                                    <!-- PC Sleep Notice -->
                                    <CheckBox Content="{DynamicResource DisablePcSleepOption}" IsChecked="{Binding DisablePcSleepNotice}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- LIGHTBOX PHOTO PREVIEW MODAL OVERLAY -->
        <Grid Grid.RowSpan="2" Visibility="{Binding SearchVM.IsPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1000" Background="#E6050B14">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" 
                    CornerRadius="16" Width="960" Height="660" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Header Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource MediaPreviewHeader}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SearchVM.PreviewItem.RelativePath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                        </StackPanel>
                        <Button Content="{DynamicResource CloseEscBtn}" Command="{Binding SearchVM.ClosePreviewCommand}" 
