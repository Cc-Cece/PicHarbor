<Window x:Class="GetAndSee.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GetAndSee.Gui.ViewModels"
        Title="{DynamicResource AppTitle}" 
        Height="750" Width="1120"
        MinHeight="620" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" 
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PrimaryButtonGradient}" Margin="0,0,12,0">
                        <TextBlock Text="📱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GetAndSee GUI" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource AppSubtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Device Status Pill & Mock Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="20" Padding="14,6" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                        <Setter Property="Background" Value="#064E3B"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DeviceStatusText}" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Language Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🇨🇳 中文" Command="{Binding SwitchLanguageCommand}" CommandParameter="zh-CN"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,5" FontSize="12" />
                    <Button Content="🇺🇸 English" Command="{Binding SwitchLanguageCommand}" CommandParameter="en-US"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY GRID -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <RadioButton Content="{DynamicResource NavBackup}" 
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=0}"
                                     Click="NavButton_Click" Tag="0"
                                     Style="{StaticResource TabRadioButton}" />
                        <RadioButton IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=1}"
                                     Click="NavButton_Click" Tag="1"
                                     Style="{StaticResource TabRadioButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource NavIPhoneSync}" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0" Padding="6,2" Background="#0284C7" CornerRadius="8" VerticalAlignment="Center"
                                        Visibility="{Binding IPhoneSyncVM.HasManualSelections, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding IPhoneSyncVM.ManualSelectionCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=2}"
                                     Click="NavButton_Click" Tag="2"
                                     Style="{StaticResource TabRadioButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource NavAndroidSync}" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0" Padding="6,2" Background="#16A34A" CornerRadius="8" VerticalAlignment="Center"
                                        Visibility="{Binding AndroidSyncVM.HasManualSelections, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding AndroidSyncVM.ManualSelectionCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Content="{DynamicResource NavStatus}" 
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=3}"
                                     Click="NavButton_Click" Tag="3"
                                     Style="{StaticResource TabRadioButton}" />
                        <RadioButton Content="{DynamicResource NavSearch}" 
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=4}"
                                     Click="NavButton_Click" Tag="4"
                                     Style="{StaticResource TabRadioButton}" />
                        <RadioButton Content="{DynamicResource NavReorganize}" 
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=5}"
                                     Click="NavButton_Click" Tag="5"
                                     Style="{StaticResource TabRadioButton}" />
                        <RadioButton Content="{DynamicResource NavSettings}" 
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static vm:EnumToBoolConverter.Instance}, ConverterParameter=6}"
                                     Click="NavButton_Click" Tag="6"
                                     Style="{StaticResource TabRadioButton}" />
                    </StackPanel>

                    <!-- Footer Engine Info -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="GetAndSee Core v1.0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text=".NET 10 | SQLite WAL | AFC" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- CONTENT AREA TAB CONTROL -->
            <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- TAB 0: BACKUP -->
                <TabItem>
                    <Grid DataContext="{Binding BackupVM}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel>
                                <!-- Target Settings Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource BackupTargetHeader}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource DestPathLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                            <Button Grid.Column="2" Content="{DynamicResource BrowseButton}" Command="{Binding BrowseDestinationCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource OrganizeSchemeLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding OrganizeSchemes}" SelectedItem="{Binding SelectedScheme}" Height="34" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Backup Scope Selection Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Step1HeaderCard}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource IPhoneScopeModeLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <!-- Scope options: All, Date, Subfolder ONLY (NO Manual) -->
                                                <RadioButton Content="{DynamicResource ScopeModeAll}" IsChecked="{Binding IsScopeAll, Mode=TwoWay}" Style="{StaticResource TabRadioButton}" Margin="0,0,0,8" Padding="12,6"/>
                                                <RadioButton Content="{DynamicResource ScopeModeDateRange}" IsChecked="{Binding IsScopeDateRange, Mode=TwoWay}" Style="{StaticResource TabRadioButton}" Margin="0,0,0,8" Padding="12,6"/>

                                                <!-- Date Range Inputs with Calendar & Presets -->
                                                <Border Margin="24,4,0,8" Padding="12" Background="#0F172A" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1"
                                                        Visibility="{Binding IsScopeDateRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <!-- Date Pickers Row -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                            <TextBlock Text="{DynamicResource ScopeDateFromLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                                            <DatePicker SelectedDate="{Binding ScopeDateFrom, Mode=TwoWay}" Width="140" Height="30" Margin="0,0,16,0"/>
                                                            
                                                            <TextBlock Text="{DynamicResource ScopeDateToLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                                            <DatePicker SelectedDate="{Binding ScopeDateTo, Mode=TwoWay}" Width="140" Height="30" Margin="0,0,16,0"/>

                                                            <Button Content="{DynamicResource ScopeClearDateBtn}" Command="{Binding ClearDateRangeCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"/>
                                                        </StackPanel>

                                                        <!-- Quick Presets Row -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{DynamicResource ScopeQuickPresetsLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                                            <Button Content="{DynamicResource PresetLast30Days}" Command="{Binding SetDatePresetLast30DaysCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                                                            <Button Content="{DynamicResource PresetLast90Days}" Command="{Binding SetDatePresetLast90DaysCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                                                            <Button Content="{DynamicResource PresetLast1Year}" Command="{Binding SetDatePresetLast1YearCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                                                            <Button Content="{DynamicResource PresetThisYear}" Command="{Binding SetDatePresetThisYearCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <RadioButton Content="{DynamicResource ScopeModeSubfolder}" IsChecked="{Binding IsScopeSubfolder, Mode=TwoWay}" Style="{StaticResource TabRadioButton}" Margin="0,0,0,8" Padding="12,6"/>

                                                <!-- Subfolder checklist -->
                                                <Border Margin="24,0,0,8" Padding="10" Background="#0F172A" CornerRadius="6"
                                                        Visibility="{Binding IsScopeSubfolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="{DynamicResource ScopeSubfoldersLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <Button Content="🔄 刷新 iPhone 目录" Command="{Binding RefreshSubfoldersCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11"/>
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Subfolders}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox Content="{Binding FolderName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,12,2"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons Card -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="{DynamicResource StartBackupBtn}" Command="{Binding StartBackupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Padding="24,10"/>
                                    <Button Content="{DynamicResource PauseBackupBtn}" Command="{Binding StopBackupCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="18,10"/>
                                    <Button Content="{DynamicResource DryRunBtn}" Command="{Binding DryRunCommand}" Style="{StaticResource SecondaryButton}" Padding="18,10"/>
                                </StackPanel>

                                <!-- Progress & Dashboard Card -->
                                <Border Style="{StaticResource ModernCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ProgressHeader}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                        <!-- Progress Bar -->
                                        <Grid Margin="0,0,0,10">
                                            <ProgressBar Value="{Binding ProgressPercentage}" Height="20" Minimum="0" Maximum="100" Foreground="{StaticResource PrimaryBrush}" Background="#0F172A"/>
                                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </Grid>

                                        <!-- Status Details Grid (Aligned with Android Sync) -->
                                        <UniformGrid Columns="5" Margin="0,0,0,12">
                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="0,0,4,0" Cursor="Hand" ToolTip="{DynamicResource ToolTipTransferred}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowCopiedDetailsCommand}"/>
                                                </Border.InputBindings>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelTransferred}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CopiedCount}" Foreground="{StaticResource AccentGreenBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="2,0,2,0" Cursor="Hand" ToolTip="{DynamicResource ToolTipSkipped}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowSkippedDetailsCommand}"/>
                                                </Border.InputBindings>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelSkipped}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SkippedCount}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="2,0,2,0" Cursor="Hand" ToolTip="{DynamicResource ToolTipFailed}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowFailedDetailsCommand}"/>
                                                </Border.InputBindings>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelFailed}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FailedCount}" Foreground="{StaticResource AccentRedBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="2,0,2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelTransferSize}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TransferredSizeText}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0F172A" CornerRadius="8" Padding="8,8" Margin="4,0,0,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource LabelEta}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding EtaText}" Foreground="{StaticResource AccentYellowBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Current File Pill -->
                                        <Border Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding CurrentFileName}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12"/>
                                        </Border>

                                        <!-- Log Console Box -->
                                        <ListBox ItemsSource="{Binding LogEntries}" Height="180" Background="#0F172A" Foreground="#A7F3D0" 
                                                 FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="8">
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Detail DataGrid Modal Overlay -->
                        <Grid Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Background="#C0000000" Panel.ZIndex="999">
                            <Border Background="#1E293B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Width="900" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,15">
                                        <TextBlock Text="{Binding DetailModalTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button Content="✕" Command="{Binding CloseDetailModalCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Width="32" Height="32" Padding="0"/>
                                    </Grid>

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding DetailItems}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Extended"
                                              Background="#0F172A" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                                              RowBackground="#0F172A" AlternatingRowBackground="#182238" Foreground="White"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                                                <EventSetter Event="PreviewMouseDoubleClick" Handler="DetailDataGridRow_MouseDoubleClick"/>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource MenuOpen}" 
                                                          Command="{Binding PlacementTarget.DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuOpenWith}" 
                                                          Command="{Binding PlacementTarget.DataContext.OpenWithDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuCopy}" 
                                                          Command="{Binding PlacementTarget.DataContext.CopyDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuCopyPath}" 
                                                          Command="{Binding PlacementTarget.DataContext.CopyPathDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{DynamicResource MenuShowInExplorer}" 
                                                          Command="{Binding PlacementTarget.DataContext.ShowInExplorerDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource MenuProperties}" 
                                                          Command="{Binding PlacementTarget.DataContext.PropertiesDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="10,8"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#334155"/>
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="10,6"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="DataGridCell">
                                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource ColSourcePath}" Binding="{Binding SourcePath}" Width="2*"/>
                                            <DataGridTextColumn Header="{DynamicResource ColTargetPath}" Binding="{Binding TargetPath}" Width="2*"/>
                                            <DataGridTextColumn Header="{DynamicResource ColSize}" Binding="{Binding FileSizeText}" Width="80"/>
                                            <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding StatusText}" Width="80"/>
                                            <DataGridTextColumn Header="{DynamicResource ColDetails}" Binding="{Binding Details}" Width="1.5*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                        <Button Content="{DynamicResource CloseBtn}" Command="{Binding CloseDetailModalCommand}" Style="{StaticResource SecondaryButton}" Padding="20,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 1: IPHONE RESTORE (Apple Devices Sync) -->
                <TabItem>
                    <Grid DataContext="{Binding IPhoneSyncVM}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel>
                                <!-- Header Banner Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource IPhoneSyncTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{DynamicResource IPhoneSyncDescription}" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 1: Restore Scope & Filter -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Step1HeaderCard}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource IPhoneScopeModeLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <RadioButton Content="{DynamicResource ScopeModeAll}" IsChecked="{Binding IsScopeAll, Mode=TwoWay}" Style="{StaticResource TabRadioButton}" Margin="0,0,0,8" Padding="12,6"/>
                                                <RadioButton Content="{DynamicResource ScopeModeDateRange}" IsChecked="{Binding IsScopeDateRange, Mode=TwoWay}" Style="{StaticResource TabRadioButton}" Margin="0,0,0,8" Padding="12,6"/>

                                                <!-- Date Range Inputs with Calendar & Presets -->
