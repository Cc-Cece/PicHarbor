<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PicHarbor.Vault</RootNamespace>
    <AssemblyName>PicHarbor.Vault</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 会话锁定通知需要 NativeWindow 消息泵（System.Windows.Forms）。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Self-contained single-file exe for deployment alongside PicHarbor.Gui. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让测试能直接断言 pipe DACL 构造（PipeServer.BuildPipeSecurity 为 internal）。 -->
    <InternalsVisibleTo Include="PicHarbor.VaultTests" />
  </ItemGroup>

</Project>
