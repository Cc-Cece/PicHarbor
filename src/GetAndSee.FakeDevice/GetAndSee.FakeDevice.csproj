<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Product-free fake-device library: the single home for the AFC test double (FakeAfcDevice over a
    virtual /DCIM spec + the ScriptedReadStream fault model + a GAS_FAKE_DEVICE spec parser/gate). It has
    NO test-framework dependencies, so it can be referenced both by the test suite AND, behind the opt-in
    FAKE_DEVICE compile constant, by GetAndSee.Cli — without the test frameworks leaking into the product.

    It is NEVER referenced by a normal (shipped) build of GetAndSee.Cli: the Cli only references it when
    built with -p:FakeDevice=true (see GetAndSee.Cli.csproj), so the shipped get-and-see.exe never contains
    this assembly. As a library it emits no runtimes/ folder, so it needs no RuntimeIdentifier pin.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GetAndSee.Core\GetAndSee.Core.csproj" />
  </ItemGroup>

</Project>
